+#ifndef ASYNCRT_RUNTIME_DEVICE_CONTEXT_C_API_H
+#define ASYNCRT_RUNTIME_DEVICE_CONTEXT_C_API_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+typedef struct {
+  const char *data;
+  intptr_t length;
+} AsyncRTStringRef;
+
+typedef void (*AsyncRTCoroutineFunction)(void *handle);
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+const char *AsyncRT_DeviceContext_create(void **result, const char *api,
+                                         int32_t device_id);
+void AsyncRT_DeviceContext_retain(void *context);
+void AsyncRT_DeviceContext_release(void *context);
+void AsyncRT_DeviceContext_deviceApi(AsyncRTStringRef *result, void *context);
+void AsyncRT_DeviceContext_strfree(const char *error_message);
+const char *AsyncRT_DeviceContext_getAttribute(int32_t *result, void *context,
+                                               int32_t attribute);
+const char *AsyncRT_DeviceContext_enqueueHostFunctionRange(
+    void *context, AsyncRTCoroutineFunction resume_function,
+    AsyncRTCoroutineFunction destroy_function, void *const *handles,
+    int64_t handle_count);
+const char *AsyncRT_DeviceContext_synchronize(void *context);
+int64_t AsyncRT_DeviceContext_id(void *context);
+
+/// Execute the fixed-shape Float32 matmul -> matmul Core AI MVP region.
+///
+/// This is backend/runtime ABI, not a Mojo programming API.  The compiler's
+/// Core AI region lowering is the only supported producer.  Work is ordered on
+/// `context`; `AsyncRT_DeviceContext_synchronize` waits for completion and
+/// returns any translated Swift/Core AI error.
+const char *AsyncRT_CoreAI_executeMatmulMatmulF32_2x3x4x2(
+    void *context, const float *input, const float *first_weights,
+    const float *second_weights, float *output);
+void AsyncRT_CoreAI_enqueueMatmulMatmulF32_2x3x4x2(
+    void *context, const float *input, const float *first_weights,
+    const float *second_weights, float *output);
+
+const char *AsyncRT_DeviceContext_createBuffer_async(void **result,
+                                                     void **device_ptr,
+                                                     void *context,
+                                                     size_t length,
+                                                     size_t element_size);
+void AsyncRT_DeviceBuffer_retain(void *buffer);
+void AsyncRT_DeviceBuffer_release(void *buffer);
+int64_t AsyncRT_DeviceBuffer_bytesize(void *buffer);
+
+const char *AsyncRT_DeviceContext_HtoD_async(void *context, void *destination,
+                                             const void *source);
+const char *AsyncRT_DeviceContext_DtoH_async(void *context, void *destination,
+                                             void *source);
+
+const char *AsyncRT_DeviceContext_loadFunction(
+    void **result, void *context, const char *module_name,
+    const char *function_name, const char *data, size_t data_length,
+    int32_t max_dynamic_shared_bytes, const char *debug_level,
+    int32_t optimization_level);
+void AsyncRT_DeviceFunction_retain(void *function);
+void AsyncRT_DeviceFunction_release(void *function);
+
+const char *AsyncRT_DeviceContext_enqueueFunctionDirect(
+    void *context, void *function, uint32_t grid_x, uint32_t grid_y,
+    uint32_t grid_z, uint32_t block_x, uint32_t block_y, uint32_t block_z,
+    uint32_t shared_memory_bytes, const void *attributes,
+    uint32_t attribute_count, void *const *arguments, uint32_t argument_count,
+    const uint64_t *argument_sizes);
+
+#ifdef __cplusplus
+} // extern "C"
+#endif
+
+#endif // ASYNCRT_RUNTIME_DEVICE_CONTEXT_C_API_H
