diff --git a/KGEN/lib/CompilerRT/Embedded/Apple/AsyncRT.c b/KGEN/lib/CompilerRT/Embedded/Apple/AsyncRT.c
new file mode 100644
index 0000000000..1a9f8da4c3
--- /dev/null
+++ b/KGEN/lib/CompilerRT/Embedded/Apple/AsyncRT.c
@@ -0,0 +1,409 @@
+//===----------------------------------------------------------------------===//
+// Copyright (c) 2026, Modular Inc. All rights reserved.
+//
+// Licensed under the Apache License v2.0 with LLVM Exceptions:
+// https://llvm.org/LICENSE.txt
+//
+// Distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+//===----------------------------------------------------------------------===//
+
+#include "AsyncRT/lib/Runtime/Apple/AppleWorkQueue.h"
+
+#include <assert.h>
+#include <errno.h>
+#include <pthread.h>
+#include <sched.h>
+#include <stdatomic.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <sys/types.h>
+#include <time.h>
+#include <unistd.h>
+
+enum {
+  COMPILERRT_EMBEDDED_CPU_RUNTIME_MAGIC = 0x43505552,
+  COMPILERRT_EMBEDDED_ASYNC_CHAIN_MAGIC = 0x43484149,
+};
+
+bool KGEN_CompilerRT_Initialize(void);
+
+typedef struct {
+  _Atomic(uint32_t) reference_count;
+  uint32_t magic;
+} CompilerRTEmbeddedCPURuntime;
+
+typedef struct {
+  void *pointer;
+} CompilerRTAsyncRTRuntimeRef;
+
+typedef struct {
+  void *pointer;
+} CompilerRTAsyncChainRef;
+
+typedef void (*CompilerRTAsyncResumeFunction)(int8_t *handle);
+
+typedef struct CompilerRTEmbeddedAsyncContinuation
+    CompilerRTEmbeddedAsyncContinuation;
+
+struct CompilerRTEmbeddedAsyncContinuation {
+  CompilerRTAsyncResumeFunction resume_function;
+  int8_t *handle;
+  CompilerRTEmbeddedAsyncContinuation *next;
+};
+
+typedef struct {
+  pthread_mutex_t mutex;
+  pthread_cond_t condition;
+  CompilerRTEmbeddedAsyncContinuation *first_continuation;
+  CompilerRTEmbeddedAsyncContinuation *last_continuation;
+  uint32_t waiter_count;
+  uint32_t magic;
+  bool complete;
+} CompilerRTEmbeddedAsyncChain;
+
+typedef struct {
+  uint32_t wait_count;
+} CompilerRTEmbeddedSpinWaiter;
+
+static pthread_mutex_t compilerrt_embedded_cpu_runtime_mutex =
+    PTHREAD_MUTEX_INITIALIZER;
+static CompilerRTEmbeddedCPURuntime *compilerrt_embedded_cpu_runtime;
+
+static CompilerRTEmbeddedAsyncChain **
+compilerrt_embedded_async_chain_slot(CompilerRTAsyncChainRef chain_reference) {
+  assert(chain_reference.pointer != NULL);
+  return (CompilerRTEmbeddedAsyncChain **)chain_reference.pointer;
+}
+
+static CompilerRTEmbeddedAsyncChain *
+compilerrt_embedded_async_chain(CompilerRTAsyncChainRef chain_reference) {
+  CompilerRTEmbeddedAsyncChain *chain =
+      *compilerrt_embedded_async_chain_slot(chain_reference);
+  assert(chain != NULL);
+  assert(chain->magic == COMPILERRT_EMBEDDED_ASYNC_CHAIN_MAGIC);
+  return chain;
+}
+
+static void compilerrt_embedded_async_resume(void *untyped_continuation) {
+  CompilerRTEmbeddedAsyncContinuation *continuation = untyped_continuation;
+  assert(continuation != NULL);
+  assert(continuation->resume_function != NULL);
+  assert(continuation->handle != NULL);
+  continuation->resume_function(continuation->handle);
+  free(continuation);
+}
+
+static CompilerRTEmbeddedAsyncContinuation *
+compilerrt_embedded_async_continuation_create(
+    CompilerRTAsyncResumeFunction resume_function, int8_t *handle) {
+  assert(resume_function != NULL);
+  assert(handle != NULL);
+  CompilerRTEmbeddedAsyncContinuation *continuation =
+      malloc(sizeof(*continuation));
+  assert(continuation != NULL);
+  continuation->resume_function = resume_function;
+  continuation->handle = handle;
+  continuation->next = NULL;
+  return continuation;
+}
+
+static void compilerrt_embedded_async_continuation_submit(
+    CompilerRTEmbeddedAsyncContinuation *continuation) {
+  assert(continuation != NULL);
+  assert(continuation->next == NULL);
+  AsyncRT_AppleWorkQueue_submit(compilerrt_embedded_async_resume, continuation);
+}
+
+static uint32_t compilerrt_embedded_online_processor_count(void) {
+  long online_processor_count = sysconf(_SC_NPROCESSORS_ONLN);
+  assert(online_processor_count > 0);
+  assert((unsigned long)online_processor_count <= UINT32_MAX);
+  return (uint32_t)online_processor_count;
+}
+
+uint32_t KGEN_CompilerRT_AsyncRT_ParallelismLevel(void) {
+  return compilerrt_embedded_online_processor_count();
+}
+
+void KGEN_CompilerRT_AsyncRT_InitializeChain(
+    CompilerRTAsyncChainRef chain_reference) {
+  CompilerRTEmbeddedAsyncChain **chain_slot =
+      compilerrt_embedded_async_chain_slot(chain_reference);
+
+  CompilerRTEmbeddedAsyncChain *chain = malloc(sizeof(*chain));
+  assert(chain != NULL);
+  int mutex_result = pthread_mutex_init(&chain->mutex, NULL);
+  assert(mutex_result == 0);
+  int condition_result = pthread_cond_init(&chain->condition, NULL);
+  assert(condition_result == 0);
+  chain->first_continuation = NULL;
+  chain->last_continuation = NULL;
+  chain->waiter_count = 0;
+  chain->magic = COMPILERRT_EMBEDDED_ASYNC_CHAIN_MAGIC;
+  chain->complete = false;
+  *chain_slot = chain;
+}
+
+void KGEN_CompilerRT_AsyncRT_DestroyChain(
+    CompilerRTAsyncChainRef chain_reference) {
+  CompilerRTEmbeddedAsyncChain **chain_slot =
+      compilerrt_embedded_async_chain_slot(chain_reference);
+  CompilerRTEmbeddedAsyncChain *chain = *chain_slot;
+  assert(chain != NULL);
+  assert(chain->magic == COMPILERRT_EMBEDDED_ASYNC_CHAIN_MAGIC);
+
+  int lock_result = pthread_mutex_lock(&chain->mutex);
+  assert(lock_result == 0);
+  assert(chain->complete &&
+         "an AsyncRT chain cannot be destroyed before completion");
+  assert(chain->waiter_count == 0);
+  assert(chain->first_continuation == NULL);
+  assert(chain->last_continuation == NULL);
+  chain->magic = 0;
+  *chain_slot = NULL;
+  int unlock_result = pthread_mutex_unlock(&chain->mutex);
+  assert(unlock_result == 0);
+
+  int condition_result = pthread_cond_destroy(&chain->condition);
+  assert(condition_result == 0);
+  int mutex_result = pthread_mutex_destroy(&chain->mutex);
+  assert(mutex_result == 0);
+  free(chain);
+}
+
+void KGEN_CompilerRT_AsyncRT_Complete(CompilerRTAsyncChainRef chain_reference) {
+  CompilerRTEmbeddedAsyncChain *chain =
+      compilerrt_embedded_async_chain(chain_reference);
+  int lock_result = pthread_mutex_lock(&chain->mutex);
+  assert(lock_result == 0);
+  assert(!chain->complete && "an AsyncRT chain may be completed only once");
+
+  chain->complete = true;
+  CompilerRTEmbeddedAsyncContinuation *continuation = chain->first_continuation;
+  chain->first_continuation = NULL;
+  chain->last_continuation = NULL;
+  int broadcast_result = pthread_cond_broadcast(&chain->condition);
+  assert(broadcast_result == 0);
+  int unlock_result = pthread_mutex_unlock(&chain->mutex);
+  assert(unlock_result == 0);
+
+  while (continuation != NULL) {
+    CompilerRTEmbeddedAsyncContinuation *next = continuation->next;
+    continuation->next = NULL;
+    compilerrt_embedded_async_continuation_submit(continuation);
+    continuation = next;
+  }
+}
+
+void KGEN_CompilerRT_AsyncRT_Wait(CompilerRTAsyncChainRef chain_reference) {
+  CompilerRTEmbeddedAsyncChain *chain =
+      compilerrt_embedded_async_chain(chain_reference);
+  int lock_result = pthread_mutex_lock(&chain->mutex);
+  assert(lock_result == 0);
+  ++chain->waiter_count;
+  assert(chain->waiter_count > 0);
+  while (!chain->complete) {
+    int wait_result = pthread_cond_wait(&chain->condition, &chain->mutex);
+    assert(wait_result == 0);
+  }
+  assert(chain->waiter_count > 0);
+  --chain->waiter_count;
+  int unlock_result = pthread_mutex_unlock(&chain->mutex);
+  assert(unlock_result == 0);
+}
+
+bool KGEN_CompilerRT_AsyncRT_Wait_Timeout(
+    CompilerRTAsyncChainRef chain_reference, int64_t timeout_nanoseconds) {
+  CompilerRTEmbeddedAsyncChain *chain =
+      compilerrt_embedded_async_chain(chain_reference);
+  int lock_result = pthread_mutex_lock(&chain->mutex);
+  assert(lock_result == 0);
+
+  if (timeout_nanoseconds <= 0) {
+    bool complete = chain->complete;
+    int unlock_result = pthread_mutex_unlock(&chain->mutex);
+    assert(unlock_result == 0);
+    return complete;
+  }
+
+  _Static_assert(sizeof(time_t) >= sizeof(int64_t),
+                 "the embedded AsyncRT timeout requires 64-bit time_t");
+  struct timespec now;
+  int clock_result = clock_gettime(CLOCK_MONOTONIC, &now);
+  assert(clock_result == 0);
+  struct timespec deadline = {
+      .tv_sec = now.tv_sec + timeout_nanoseconds / 1000000000LL,
+      .tv_nsec = now.tv_nsec + timeout_nanoseconds % 1000000000LL,
+  };
+  if (deadline.tv_nsec >= 1000000000L) {
+    ++deadline.tv_sec;
+    deadline.tv_nsec -= 1000000000L;
+  }
+  ++chain->waiter_count;
+  assert(chain->waiter_count > 0);
+  int wait_result = 0;
+  while (!chain->complete && wait_result != ETIMEDOUT) {
+    clock_result = clock_gettime(CLOCK_MONOTONIC, &now);
+    assert(clock_result == 0);
+    if (now.tv_sec > deadline.tv_sec ||
+        (now.tv_sec == deadline.tv_sec && now.tv_nsec >= deadline.tv_nsec)) {
+      wait_result = ETIMEDOUT;
+      break;
+    }
+    struct timespec relative_timeout = {
+        .tv_sec = deadline.tv_sec - now.tv_sec,
+        .tv_nsec = deadline.tv_nsec - now.tv_nsec,
+    };
+    if (relative_timeout.tv_nsec < 0) {
+      --relative_timeout.tv_sec;
+      relative_timeout.tv_nsec += 1000000000L;
+    }
+    assert(relative_timeout.tv_sec >= 0);
+    wait_result = pthread_cond_timedwait_relative_np(
+        &chain->condition, &chain->mutex, &relative_timeout);
+    assert(wait_result == 0 || wait_result == ETIMEDOUT);
+  }
+  bool complete = chain->complete;
+  assert(chain->waiter_count > 0);
+  --chain->waiter_count;
+  int unlock_result = pthread_mutex_unlock(&chain->mutex);
+  assert(unlock_result == 0);
+  return complete;
+}
+
+void KGEN_CompilerRT_AsyncRT_Execute(
+    CompilerRTAsyncResumeFunction resume_function, int8_t *handle,
+    ssize_t desired_worker_id) {
+  assert(desired_worker_id >= -1 &&
+         "the embedded Apple executor accepts -1 or a worker affinity hint");
+  CompilerRTEmbeddedAsyncContinuation *task =
+      compilerrt_embedded_async_continuation_create(resume_function, handle);
+  // libdispatch does not expose stable worker identifiers. The generic ABI
+  // defines this value as an affinity hint, so the embedded executor may
+  // lawfully ignore nonnegative values.
+  compilerrt_embedded_async_continuation_submit(task);
+}
+
+void KGEN_CompilerRT_AsyncRT_AndThen(
+    CompilerRTAsyncResumeFunction resume_function,
+    CompilerRTAsyncChainRef chain_reference, int8_t *handle) {
+  CompilerRTEmbeddedAsyncContinuation *continuation =
+      compilerrt_embedded_async_continuation_create(resume_function, handle);
+  CompilerRTEmbeddedAsyncChain *chain =
+      compilerrt_embedded_async_chain(chain_reference);
+  int lock_result = pthread_mutex_lock(&chain->mutex);
+  assert(lock_result == 0);
+  if (chain->complete) {
+    int unlock_result = pthread_mutex_unlock(&chain->mutex);
+    assert(unlock_result == 0);
+    compilerrt_embedded_async_continuation_submit(continuation);
+    return;
+  }
+
+  if (chain->last_continuation == NULL) {
+    assert(chain->first_continuation == NULL);
+    chain->first_continuation = continuation;
+  } else {
+    assert(chain->first_continuation != NULL);
+    chain->last_continuation->next = continuation;
+  }
+  chain->last_continuation = continuation;
+  int unlock_result = pthread_mutex_unlock(&chain->mutex);
+  assert(unlock_result == 0);
+}
+
+CompilerRTAsyncRTRuntimeRef KGEN_CompilerRT_AsyncRT_GetCurrentCPUDevice(void) {
+  int lock_result = pthread_mutex_lock(&compilerrt_embedded_cpu_runtime_mutex);
+  assert(lock_result == 0);
+  CompilerRTEmbeddedCPURuntime *runtime = compilerrt_embedded_cpu_runtime;
+  if (runtime != NULL) {
+    assert(runtime->magic == COMPILERRT_EMBEDDED_CPU_RUNTIME_MAGIC);
+    assert(atomic_load_explicit(&runtime->reference_count,
+                                memory_order_acquire) > 0);
+  }
+  int unlock_result =
+      pthread_mutex_unlock(&compilerrt_embedded_cpu_runtime_mutex);
+  assert(unlock_result == 0);
+  return (CompilerRTAsyncRTRuntimeRef){.pointer = runtime};
+}
+
+CompilerRTAsyncRTRuntimeRef KGEN_CompilerRT_AsyncRT_GetOrCreateCPUDevice(void) {
+  assert(KGEN_CompilerRT_Initialize());
+  int lock_result = pthread_mutex_lock(&compilerrt_embedded_cpu_runtime_mutex);
+  assert(lock_result == 0);
+
+  CompilerRTEmbeddedCPURuntime *runtime = compilerrt_embedded_cpu_runtime;
+  if (runtime == NULL) {
+    runtime = malloc(sizeof(*runtime));
+    assert(runtime != NULL);
+    atomic_init(&runtime->reference_count, 1);
+    runtime->magic = COMPILERRT_EMBEDDED_CPU_RUNTIME_MAGIC;
+    compilerrt_embedded_cpu_runtime = runtime;
+  } else {
+    assert(runtime->magic == COMPILERRT_EMBEDDED_CPU_RUNTIME_MAGIC);
+    uint32_t previous_reference_count = atomic_fetch_add_explicit(
+        &runtime->reference_count, 1, memory_order_acq_rel);
+    assert(previous_reference_count > 0);
+    assert(previous_reference_count < UINT32_MAX);
+  }
+
+  int unlock_result =
+      pthread_mutex_unlock(&compilerrt_embedded_cpu_runtime_mutex);
+  assert(unlock_result == 0);
+  return (CompilerRTAsyncRTRuntimeRef){.pointer = runtime};
+}
+
+void KGEN_CompilerRT_AsyncRT_ReleaseCPUDevice(
+    CompilerRTAsyncRTRuntimeRef runtime_reference) {
+  CompilerRTEmbeddedCPURuntime *runtime = runtime_reference.pointer;
+  assert(runtime != NULL);
+
+  int lock_result = pthread_mutex_lock(&compilerrt_embedded_cpu_runtime_mutex);
+  assert(lock_result == 0);
+  assert(runtime == compilerrt_embedded_cpu_runtime);
+  assert(runtime->magic == COMPILERRT_EMBEDDED_CPU_RUNTIME_MAGIC);
+  uint32_t previous_reference_count = atomic_fetch_sub_explicit(
+      &runtime->reference_count, 1, memory_order_acq_rel);
+  assert(previous_reference_count > 0);
+  if (previous_reference_count == 1) {
+    compilerrt_embedded_cpu_runtime = NULL;
+    runtime->magic = 0;
+  }
+  int unlock_result =
+      pthread_mutex_unlock(&compilerrt_embedded_cpu_runtime_mutex);
+  assert(unlock_result == 0);
+
+  if (previous_reference_count == 1)
+    free(runtime);
+}
+
+void *KGEN_CompilerRT_AsyncRT_InitializeSpinWaiter(void) {
+  CompilerRTEmbeddedSpinWaiter *waiter = malloc(sizeof(*waiter));
+  assert(waiter != NULL);
+  waiter->wait_count = 0;
+  return waiter;
+}
+
+void KGEN_CompilerRT_AsyncRT_SpinWaiter_Wait(void *untyped_waiter) {
+  CompilerRTEmbeddedSpinWaiter *waiter = untyped_waiter;
+  assert(waiter != NULL);
+
+  if (waiter->wait_count < 16) {
+    ++waiter->wait_count;
+    sched_yield();
+    return;
+  }
+
+  const struct timespec delay = {.tv_sec = 0, .tv_nsec = 50000};
+  int sleep_result = nanosleep(&delay, NULL);
+  assert(sleep_result == 0);
+}
+
+void KGEN_CompilerRT_AsyncRT_DestroySpinWaiter(void *untyped_waiter) {
+  assert(untyped_waiter != NULL);
+  free(untyped_waiter);
+}
