+
+namespace M::KGEN {
+
+const TargetTraits *MetalBackend::traits() const { return &MetalTraits::get(); }
+
+CompilationOptions MetalBackend::adjustOptionsForTargetMachine(
+    const CompilationOptions &options, llvm::StringRef moduleTriple) const {
+  assert(MetalTraits::get().matches(llvm::Triple(moduleTriple)) &&
+         "Metal backend received a non-AIR module");
+  CompilationOptions adjusted = options;
+  adjusted.targetTriple = MetalTraits::get().codegenTriple(moduleTriple);
+  // AIR architecture names are not host CPU names. The target machine only
+  // supplies the ARM data layout and generic LLVM analyses; AIR emission is
+  // performed by this backend.
+  adjusted.targetCpu = "generic";
+  adjusted.targetFeatures.clear();
+  return adjusted;
+}
+
+void MetalBackend::finalizeModuleForTarget(
+    llvm::Module &module, llvm::TargetMachine &targetMachine,
+    llvm::StringRef originalTriple) const {
+  assert(MetalTraits::get().matches(llvm::Triple(originalTriple)) &&
+         "Metal backend lost the original AIR triple");
+  module.setDataLayout(targetMachine.createDataLayout());
+  module.setTargetTriple(llvm::Triple(originalTriple));
+}
+
+bool MetalBackend::buildLLVMPipeline(llvm::ModulePassManager &manager,
+                                     llvm::PassBuilder &passBuilder,
+                                     const CompilationOptions &options) const {
+  assert(options.optimizationLevel <= 3 &&
+         "Metal backend received an invalid optimization level");
+
+  // AIR is a legalization target, not an LLVM machine-code backend. Preserve
+  // the requested optimization policy, then apply the AIR ABI and LLVM-17
+  // compatibility transforms at every level. In particular, O0 must not rely
+  // on an optimized pipeline to make the module valid.
+  manager.addPass(PrepareMetalAIRPass());
+  if (options.getCodeGenOptLevel() == llvm::CodeGenOptLevel::None) {
+    manager.addPass(llvm::AlwaysInlinerPass(
+        /*InsertLifetimeIntrinsics=*/false));
+    llvm::FunctionPassManager canonicalizeFunctions;
+    canonicalizeFunctions.addPass(llvm::SimplifyCFGPass());
+    canonicalizeFunctions.addPass(
+        llvm::SROAPass(llvm::SROAOptions::ModifyCFG));
+    canonicalizeFunctions.addPass(llvm::EarlyCSEPass());
+    canonicalizeFunctions.addPass(llvm::InstCombinePass());
+    manager.addPass(llvm::createModuleToFunctionPassAdaptor(
+        std::move(canonicalizeFunctions)));
+  } else {
+    // Match the ordinary KGEN policy: all non-zero source optimization levels
+    // currently use the fully optimized LLVM pipeline.
+    manager.addPass(passBuilder.buildPerModuleDefaultPipeline(
+        llvm::OptimizationLevel::O3));
+  }
+  manager.addPass(MetalAIRPass());
+  manager.addPass(llvm::createModuleToFunctionPassAdaptor(
+      llvm::InferAddressSpacesPass(/*AddressSpace=*/0)));
+  manager.addPass(PointerRewriter());
+  manager.addPass(LLVMIRDowngradePass());
+  return true;
+}
+
+void MetalBackend::emitBitcode(llvm::Module &module,
+                               llvm::raw_pwrite_stream &output) const {
+  LLVM::WriteBitcode17ToFile(module, output,
+                             /*shouldPreserveUseListOrder=*/true);
+}
+
+ErrorOr<BufferRef> MetalBackend::emitAssembly(llvm::Module &module,
+                                              EmitContext &ctx) const {
+  (void)ctx;
+  if (std::optional<std::string> error = getMetalAIRLoweringError(module))
+    return Error(*error);
+  WriteableBufferRef output = WriteableBuffer::get();
+  module.print(*output, nullptr);
+  return BufferRef::take(output.release());
+}
+
+ErrorOr<BufferRef> MetalBackend::emitObject(llvm::Module &module,
+                                            EmitContext &ctx) const {
+  if (std::optional<std::string> error = getMetalAIRLoweringError(module))
+    return Error(*error);
+  if (ctx.options.debugLevel == CompilationOptions::kFullDebugInfo)
+    return Error("Metal full debug information is not implemented; use "
+                 "--debug-level=line-tables or --debug-level=none");
+  ErrorOr<TempFile> airFileOr =
+      writeTempFile("mojo-metal-%%%%%%.air", [&](llvm::raw_ostream &output) {
+        LLVM::WriteBitcode17ToFile(module, output,
+                                   /*shouldPreserveUseListOrder=*/true);
+      });
+  if (airFileOr.isError())
+    return Error(llvm::Twine("failed to create temporary Metal AIR file: ") +
+                 airFileOr.takeError().get());
+  TempFile airFile = std::move(*airFileOr);
+
+  ErrorOr<TempFile> metalLibraryFileOr =
+      TempFile::create("mojo-metal-%%%%%%.metallib");
+  if (metalLibraryFileOr.isError())
+    return Error(llvm::Twine("failed to create temporary Metal library: ") +
+                 metalLibraryFileOr.takeError().get());
+  TempFile metalLibraryFile = std::move(*metalLibraryFileOr);
+  metalLibraryFile.close();
+
+  ErrorOr<TempFile> diagnosticFileOr =
+      TempFile::create("mojo-metal-%%%%%%.diagnostics");
+  if (diagnosticFileOr.isError())
+    return Error(llvm::Twine("failed to create Metal diagnostic file: ") +
+                 diagnosticFileOr.takeError().get());
+  TempFile diagnosticFile = std::move(*diagnosticFileOr);
+  diagnosticFile.close();
+
+  llvm::Triple triple(module.getTargetTriple());
+  const bool isIOS = triple.getOS() == llvm::Triple::IOS;
+  if (!isIOS && !triple.isMacOSX())
+    return Error(
+        llvm::Twine("Metal library packaging is not implemented for ") +
+        triple.getTriple());
+
+  std::string metalCompiler;
+  llvm::SmallVector<llvm::StringRef> arguments;
+  if (std::optional<std::string> configuredCompiler =
+          llvm::sys::Process::GetEnv("MOJO_METAL_COMPILER_PATH")) {
+    metalCompiler = std::move(*configuredCompiler);
+    if (metalCompiler.empty())
+      return Error("MOJO_METAL_COMPILER_PATH is set but empty");
+    arguments.push_back(metalCompiler);
+  } else {
+    llvm::ErrorOr<std::string> xcrun = llvm::sys::findProgramByName("xcrun");
+    if (!xcrun)
+      return Error("Metal library packaging requires xcrun or an explicit "
+                   "MOJO_METAL_COMPILER_PATH");
+    metalCompiler = std::move(*xcrun);
+    llvm::StringRef sdk = "macosx";
+    if (isIOS)
+      sdk = triple.isSimulatorEnvironment() ? "iphonesimulator" : "iphoneos";
+    arguments.append({metalCompiler, "-sdk", sdk, "metal"});
+  }
+
+  const std::string targetTriple = triple.getTriple();
+  const std::string airPath = airFile.getPath().string();
+  const std::string metalLibraryPath = metalLibraryFile.getPath().string();
+  arguments.append({"-target", targetTriple, airPath, "-o", metalLibraryPath});
+
+  std::string executionError;
+  int exitCode = llvm::sys::ExecuteAndWait(
+      metalCompiler, arguments, /*Env=*/std::nullopt,
+      {/*stdin=*/std::nullopt, /*stdout=*/std::nullopt,
+       /*stderr=*/diagnosticFile.getPath().string()},
+      /*SecondsToWait=*/0, /*MemoryLimit=*/0, &executionError);
+  if (exitCode != 0) {
+    std::string diagnostics;
+    if (auto diagnosticBuffer =
+            llvm::MemoryBuffer::getFile(diagnosticFile.getPath().string()))
+      diagnostics = diagnosticBuffer.get()->getBuffer().str();
+    std::string message = "Metal compiler failed while packaging AIR";
+    if (!executionError.empty())
+      message += ": " + executionError;
+    if (!diagnostics.empty())
+      message += "\n" + diagnostics;
+    return Error(message);
+  }
+
+  ErrorOr<BufferRef> metalLibrary =
+      M::Buffer::getFile(metalLibraryFile.getPath(), std::nullopt, 0);
+  if (metalLibrary.isError())
+    return Error(llvm::Twine("Metal compiler did not produce a library: ") +
+                 metalLibrary.takeError().get());
+  return *metalLibrary;
+}
+
+ErrorOr<BufferRef>
+MetalBackend::createArchive(llvm::MutableArrayRef<BufferRef> objects,
+                            llvm::StringRef moduleName,
+                            EmitContext &ctx) const {
+  (void)moduleName;
+  (void)ctx;
+  // Metal is deliberately interprocedural and uses SplitStrategy::None, so a
+  // compilation archive is exactly one metallib containing every kernel in
+  // the module.  Refuse an unexpected split instead of concatenating opaque
+  // metallibs into an invalid artifact.
+  if (objects.size() != 1)
+    return Error("Metal archive composition requires exactly one "
+                 "interprocedural metallib object");
+  return objects.front();
+}
+
+namespace {
+#pragma GCC diagnostic push
+#pragma GCC diagnostic ignored "-Wglobal-constructors"
+RegisterTargetBackend<MetalBackend> registerMetalBackend;
+#pragma GCC diagnostic pop
+} // namespace
+
+} // namespace M::KGEN
