diff --git a/KGEN/lib/Compiler/ObjectCompiler/LLVM/Transforms/CoreAIRegionPass.cpp b/KGEN/lib/Compiler/ObjectCompiler/LLVM/Transforms/CoreAIRegionPass.cpp
new file mode 100644
index 0000000000..e23f8f8648
--- /dev/null
+++ b/KGEN/lib/Compiler/ObjectCompiler/LLVM/Transforms/CoreAIRegionPass.cpp
@@ -0,0 +1,275 @@
+//===----------------------------------------------------------------------===//
+// Copyright (c) 2026, Modular Inc. All rights reserved.
+//
+// Licensed under the Apache License v2.0 with LLVM Exceptions.
+//===----------------------------------------------------------------------===//
+
+#include "CoreAIRegionPass.h"
+
+#include "llvm/ADT/DenseSet.h"
+#include "llvm/ADT/SmallVector.h"
+#include "llvm/Analysis/ValueTracking.h"
+#include "llvm/IR/CFG.h"
+#include "llvm/IR/Constants.h"
+#include "llvm/IR/Function.h"
+#include "llvm/IR/IRBuilder.h"
+#include "llvm/IR/Instructions.h"
+#include "llvm/IR/Module.h"
+#include "llvm/Support/ErrorHandling.h"
+
+namespace M::KGEN {
+namespace {
+
+constexpr llvm::StringLiteral kMatmulMarker =
+    "__mojo_coreai_semantic_matmul_f32";
+constexpr llvm::StringLiteral kSynchronize =
+    "AsyncRT_DeviceContext_synchronize";
+constexpr llvm::StringLiteral kRegionRuntime =
+    "AsyncRT_CoreAI_enqueueMatmulMatmulF32_2x3x4x2";
+
+[[noreturn]] static void fail(llvm::Twine message) {
+  llvm::report_fatal_error(llvm::Twine("Core AI region formation: ") + message);
+}
+
+static bool isNamedCall(const llvm::CallBase &call, llvm::StringRef name) {
+  const llvm::Function *callee = call.getCalledFunction();
+  return callee != nullptr && callee->getName() == name;
+}
+
+static llvm::Value *canonicalPointer(llvm::Value *value) {
+  value = value->stripPointerCasts();
+  while (auto *phi = llvm::dyn_cast<llvm::PHINode>(value)) {
+    if (phi->getNumIncomingValues() != 1)
+      break;
+    llvm::Value *incoming = phi->getIncomingValue(0)->stripPointerCasts();
+    if (incoming == value)
+      break;
+    value = incoming;
+  }
+  return value;
+}
+
+static bool blockCanReach(const llvm::BasicBlock *source,
+                          const llvm::BasicBlock *destination) {
+  if (source == destination)
+    return true;
+  llvm::SmallVector<const llvm::BasicBlock *, 16> worklist{source};
+  llvm::DenseSet<const llvm::BasicBlock *> visited;
+  while (!worklist.empty()) {
+    const llvm::BasicBlock *block = worklist.pop_back_val();
+    if (!visited.insert(block).second)
+      continue;
+    for (const llvm::BasicBlock *successor : llvm::successors(block)) {
+      if (successor == destination)
+        return true;
+      worklist.push_back(successor);
+    }
+  }
+  return false;
+}
+
+static bool instructionIsStrictlyBetween(const llvm::Instruction &instruction,
+                                         const llvm::Instruction &begin,
+                                         const llvm::Instruction &end) {
+  if (&instruction == &begin || &instruction == &end)
+    return false;
+  const llvm::BasicBlock *block = instruction.getParent();
+  const llvm::BasicBlock *beginBlock = begin.getParent();
+  const llvm::BasicBlock *endBlock = end.getParent();
+  if (!blockCanReach(beginBlock, block) || !blockCanReach(block, endBlock))
+    return false;
+
+  if (block == beginBlock) {
+    bool afterBegin = false;
+    for (const llvm::Instruction &candidate : *block) {
+      if (&candidate == &begin) {
+        afterBegin = true;
+        continue;
+      }
+      if (&candidate == &instruction)
+        return afterBegin && &instruction != &end;
+    }
+    llvm_unreachable("instruction is not in its parent block");
+  }
+  if (block == endBlock) {
+    for (const llvm::Instruction &candidate : *block) {
+      if (&candidate == &end)
+        return false;
+      if (&candidate == &instruction)
+        return true;
+    }
+    llvm_unreachable("instruction is not in its parent block");
+  }
+  return true;
+}
+
+static bool isAllowedBookkeepingCall(const llvm::CallBase &call) {
+  const llvm::Function *callee = call.getCalledFunction();
+  if (callee == nullptr)
+    return false;
+  if (callee->isIntrinsic())
+    return callee->getIntrinsicID() == llvm::Intrinsic::lifetime_start ||
+           callee->getIntrinsicID() == llvm::Intrinsic::lifetime_end ||
+           callee->getIntrinsicID() == llvm::Intrinsic::dbg_declare ||
+           callee->getIntrinsicID() == llvm::Intrinsic::dbg_value;
+  llvm::StringRef name = callee->getName();
+  if (name == "AsyncRT_DeviceContext_retain" ||
+      name == "AsyncRT_DeviceContext_release")
+    return true;
+
+  // At O0 the standard matmul's Optional[DeviceContext] parameter retains
+  // explicit ownership wrappers around each semantic marker. These calls can
+  // only construct, inspect, or destroy the context container; they do not
+  // receive graph tensor pointers. Keep the accepted set exhaustive so a new
+  // wrapper kind fails region formation instead of silently crossing it.
+  if (!name.contains("max::gpu::host::device_context::DeviceContext"))
+    return false;
+  return name.starts_with(
+             "max::gpu::host::device_context::DeviceContext::__init__(copy") ||
+         name.starts_with("std::collections::optional::Optional::__init__") ||
+         name.starts_with("std::utils::variant::Variant::isa") ||
+         name.starts_with("std::utils::variant::Variant::__deinit__");
+}
+
+static bool isAllocaAccess(const llvm::Value *pointer) {
+  return llvm::isa<llvm::AllocaInst>(llvm::getUnderlyingObject(pointer));
+}
+
+static void requireNoObservableEffectsBetween(const llvm::Instruction &begin,
+                                              const llvm::Instruction &end) {
+  for (const llvm::BasicBlock &block : *begin.getFunction()) {
+    for (const llvm::Instruction &instruction : block) {
+      if (!instructionIsStrictlyBetween(instruction, begin, end))
+        continue;
+      if (const auto *call = llvm::dyn_cast<llvm::CallBase>(&instruction)) {
+        if (isNamedCall(*call, kMatmulMarker) ||
+            isAllowedBookkeepingCall(*call))
+          continue;
+        fail(llvm::Twine("unsupported call '") +
+             (call->getCalledFunction() ? call->getCalledFunction()->getName()
+                                        : "indirect") +
+             "' splits the explicitly selected graph region");
+      }
+      if (const auto *load = llvm::dyn_cast<llvm::LoadInst>(&instruction)) {
+        if (!load->isVolatile() && isAllocaAccess(load->getPointerOperand()))
+          continue;
+        fail("observable or non-local load splits the graph region");
+      }
+      if (const auto *store = llvm::dyn_cast<llvm::StoreInst>(&instruction)) {
+        if (!store->isVolatile() && isAllocaAccess(store->getPointerOperand()))
+          continue;
+        fail("observable or non-local store splits the graph region");
+      }
+      if (instruction.mayHaveSideEffects() && !instruction.isTerminator())
+        fail(llvm::Twine("unsupported side-effecting instruction '") +
+             instruction.getOpcodeName() + "' splits the graph region");
+    }
+  }
+}
+
+static uint64_t constantDimension(const llvm::CallBase &marker,
+                                  unsigned argumentIndex,
+                                  llvm::StringRef dimensionName) {
+  const auto *constant =
+      llvm::dyn_cast<llvm::ConstantInt>(marker.getArgOperand(argumentIndex));
+  if (constant == nullptr)
+    fail(llvm::Twine("dynamic '") + dimensionName +
+         "' dimension is not implemented");
+  return constant->getZExtValue();
+}
+
+static void requireDimensions(const llvm::CallBase &marker, uint64_t rows,
+                              uint64_t reduction, uint64_t columns,
+                              llvm::StringRef operationName) {
+  if (marker.arg_size() != 6)
+    fail(llvm::Twine(operationName) + " semantic marker ABI is invalid");
+  if (constantDimension(marker, 3, "rows") != rows ||
+      constantDimension(marker, 4, "reduction") != reduction ||
+      constantDimension(marker, 5, "columns") != columns)
+    fail(llvm::Twine(operationName) +
+         " shape is not implemented; the MVP supports [2,3] x [3,4] "
+         "followed by [2,4] x [4,2]");
+}
+
+static llvm::CallBase *findSynchronizeAfter(llvm::CallBase &marker) {
+  llvm::CallBase *result = nullptr;
+  for (llvm::BasicBlock &block : *marker.getFunction()) {
+    for (llvm::Instruction &instruction : block) {
+      auto *call = llvm::dyn_cast<llvm::CallBase>(&instruction);
+      if (call == nullptr || !isNamedCall(*call, kSynchronize) ||
+          !blockCanReach(marker.getParent(), call->getParent()))
+        continue;
+      if (result != nullptr)
+        fail("a two-operation MVP region must have exactly one reachable "
+             "DeviceContext.synchronize boundary");
+      result = call;
+    }
+  }
+  if (result == nullptr)
+    fail("a two-operation MVP region requires DeviceContext.synchronize");
+  return result;
+}
+
+} // namespace
+
+llvm::PreservedAnalyses
+CoreAIRegionPass::run(llvm::Module &module,
+                      llvm::ModuleAnalysisManager &analysisManager) {
+  (void)analysisManager;
+  llvm::Function *markerDeclaration = module.getFunction(kMatmulMarker);
+  if (markerDeclaration == nullptr || markerDeclaration->use_empty())
+    return llvm::PreservedAnalyses::all();
+
+  llvm::SmallVector<llvm::CallBase *, 4> markers;
+  for (llvm::User *user : markerDeclaration->users()) {
+    auto *call = llvm::dyn_cast<llvm::CallBase>(user);
+    if (call == nullptr || call->getCalledFunction() != markerDeclaration)
+      fail("the matmul semantic marker has a non-direct use");
+    markers.push_back(call);
+  }
+  if (markers.size() != 2)
+    fail(llvm::Twine("the MVP implements exactly two connected matmuls, found ") +
+         llvm::Twine(markers.size()));
+  if (markers[0]->getFunction() != markers[1]->getFunction())
+    fail("the two MVP matmuls must be in one function");
+  if (!blockCanReach(markers[0]->getParent(), markers[1]->getParent()))
+    std::swap(markers[0], markers[1]);
+  if (!blockCanReach(markers[0]->getParent(), markers[1]->getParent()))
+    fail("the two MVP matmuls are not in execution order");
+
+  llvm::CallBase &first = *markers[0];
+  llvm::CallBase &second = *markers[1];
+  requireDimensions(first, 2, 3, 4, "first matmul");
+  requireDimensions(second, 2, 4, 2, "second matmul");
+  if (canonicalPointer(first.getArgOperand(0)) !=
+      canonicalPointer(second.getArgOperand(1)))
+    fail("the second matmul input is not the first matmul output");
+
+  llvm::CallBase *synchronize = findSynchronizeAfter(second);
+  requireNoObservableEffectsBetween(first, second);
+  requireNoObservableEffectsBetween(second, *synchronize);
+  if (synchronize->arg_size() != 1)
+    fail("DeviceContext.synchronize ABI is invalid");
+
+  llvm::IRBuilder<> builder(synchronize);
+  llvm::Type *voidType = llvm::Type::getVoidTy(module.getContext());
+  llvm::Type *contextType = synchronize->getArgOperand(0)->getType();
+  llvm::Type *pointerType = first.getArgOperand(0)->getType();
+  llvm::FunctionType *runtimeType = llvm::FunctionType::get(
+      voidType,
+      {contextType, pointerType, pointerType, pointerType, pointerType}, false);
+  llvm::FunctionCallee runtime =
+      module.getOrInsertFunction(kRegionRuntime, runtimeType);
+  builder.CreateCall(runtime,
+                     {synchronize->getArgOperand(0), first.getArgOperand(1),
+                      first.getArgOperand(2), second.getArgOperand(2),
+                      second.getArgOperand(0)});
+
+  first.eraseFromParent();
+  second.eraseFromParent();
+  if (markerDeclaration->use_empty())
+    markerDeclaration->eraseFromParent();
+  return llvm::PreservedAnalyses::none();
+}
+
+} // namespace M::KGEN
