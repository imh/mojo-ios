+#ifndef KGEN_COMPILER_TARGET_METAL_METALBACKEND_H
+#define KGEN_COMPILER_TARGET_METAL_METALBACKEND_H
+
+#include "KGEN/Compiler/Target/TargetBackend.h"
+
+namespace M::KGEN {
+
+class MetalBackend final : public TargetBackend {
+public:
+  const TargetTraits *traits() const override;
+  SplitStrategy
+  splitStrategy(const CompilationOptions &options) const override {
+    return SplitStrategy::None;
+  }
+  bool isCodegenInterprocedural() const override { return true; }
+  bool isOffload() const override { return true; }
+
+  CompilationOptions
+  adjustOptionsForTargetMachine(const CompilationOptions &options,
+                                llvm::StringRef moduleTriple) const override;
+  void finalizeModuleForTarget(llvm::Module &module, llvm::TargetMachine &tm,
+                               llvm::StringRef originalTriple) const override;
+  bool buildLLVMPipeline(llvm::ModulePassManager &manager,
+                         llvm::PassBuilder &passBuilder,
+                         const CompilationOptions &options) const override;
+  void emitBitcode(llvm::Module &module,
+                   llvm::raw_pwrite_stream &output) const override;
+
+  ErrorOr<BufferRef> emitAssembly(llvm::Module &module,
+                                  EmitContext &ctx) const override;
+  ErrorOr<BufferRef> emitObject(llvm::Module &module,
+                                EmitContext &ctx) const override;
+  ErrorOr<BufferRef> createArchive(llvm::MutableArrayRef<BufferRef> objects,
+                                   llvm::StringRef moduleName,
+                                   EmitContext &ctx) const override;
+
+protected:
+  std::optional<unsigned> sharedMemoryAddressSpace() const override {
+    return 3;
+  }
+  bool isBaseTarget() const override { return false; }
+};
+
+} // namespace M::KGEN
+
+#endif // KGEN_COMPILER_TARGET_METAL_METALBACKEND_H
diff --git a/KGEN/lib/CompilerRT/Embedded/Apple/AsyncRT.c b/KGEN/lib/CompilerRT/Embedded/Apple/AsyncRT.c
new file mode 100644
index 0000000000..ad1f90c5a5
--- /dev/null
+++ b/KGEN/lib/CompilerRT/Embedded/Apple/AsyncRT.c
@@ -0,0 +1,410 @@
+//===----------------------------------------------------------------------===//
+// Copyright (c) 2026, Modular Inc. All rights reserved.
+//
+// Licensed under the Apache License v2.0 with LLVM Exceptions:
+// https://llvm.org/LICENSE.txt
+//
+// Distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+//===----------------------------------------------------------------------===//
+
+#include "AsyncRT/lib/Runtime/Apple/AppleWorkQueue.h"
+
+#include <assert.h>
+#include <errno.h>
+#include <pthread.h>
+#include <sched.h>
+#include <stdatomic.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <sys/types.h>
+#include <time.h>
+#include <unistd.h>
+
+enum {
+  COMPILERRT_EMBEDDED_CPU_RUNTIME_MAGIC = 0x43505552,
+  COMPILERRT_EMBEDDED_ASYNC_CHAIN_MAGIC = 0x43484149,
+};
+
+bool KGEN_CompilerRT_Initialize(void);
+
+typedef struct {
+  _Atomic(uint32_t) reference_count;
+  uint32_t magic;
+} CompilerRTEmbeddedCPURuntime;
+
+typedef struct {
+  void *pointer;
+} CompilerRTAsyncRTRuntimeRef;
+
+typedef struct {
+  void *pointer;
+} CompilerRTAsyncChainRef;
+
+typedef void (*CompilerRTAsyncResumeFunction)(int8_t *handle);
+
+typedef struct CompilerRTEmbeddedAsyncContinuation
+    CompilerRTEmbeddedAsyncContinuation;
+
+struct CompilerRTEmbeddedAsyncContinuation {
+  CompilerRTAsyncResumeFunction resume_function;
+  int8_t *handle;
+  CompilerRTEmbeddedAsyncContinuation *next;
+};
+
+typedef struct {
+  pthread_mutex_t mutex;
+  pthread_cond_t condition;
+  CompilerRTEmbeddedAsyncContinuation *first_continuation;
+  CompilerRTEmbeddedAsyncContinuation *last_continuation;
+  uint32_t waiter_count;
+  uint32_t magic;
+  bool complete;
+} CompilerRTEmbeddedAsyncChain;
+
+typedef struct {
+  uint32_t wait_count;
+} CompilerRTEmbeddedSpinWaiter;
+
+static pthread_mutex_t compilerrt_embedded_cpu_runtime_mutex =
+    PTHREAD_MUTEX_INITIALIZER;
+static CompilerRTEmbeddedCPURuntime *compilerrt_embedded_cpu_runtime;
+
+static CompilerRTEmbeddedAsyncChain **
+compilerrt_embedded_async_chain_slot(CompilerRTAsyncChainRef chain_reference) {
+  assert(chain_reference.pointer != NULL);
+  return (CompilerRTEmbeddedAsyncChain **)chain_reference.pointer;
+}
+
+static CompilerRTEmbeddedAsyncChain *
+compilerrt_embedded_async_chain(CompilerRTAsyncChainRef chain_reference) {
+  CompilerRTEmbeddedAsyncChain *chain =
+      *compilerrt_embedded_async_chain_slot(chain_reference);
+  assert(chain != NULL);
+  assert(chain->magic == COMPILERRT_EMBEDDED_ASYNC_CHAIN_MAGIC);
+  return chain;
+}
+
+static void compilerrt_embedded_async_resume(void *untyped_continuation) {
+  CompilerRTEmbeddedAsyncContinuation *continuation = untyped_continuation;
+  assert(continuation != NULL);
+  assert(continuation->resume_function != NULL);
+  assert(continuation->handle != NULL);
+  continuation->resume_function(continuation->handle);
+  free(continuation);
+}
+
+static CompilerRTEmbeddedAsyncContinuation *
+compilerrt_embedded_async_continuation_create(
+    CompilerRTAsyncResumeFunction resume_function, int8_t *handle) {
+  assert(resume_function != NULL);
+  assert(handle != NULL);
+  CompilerRTEmbeddedAsyncContinuation *continuation =
+      malloc(sizeof(*continuation));
+  assert(continuation != NULL);
+  continuation->resume_function = resume_function;
+  continuation->handle = handle;
+  continuation->next = NULL;
+  return continuation;
+}
+
+static void compilerrt_embedded_async_continuation_submit(
+    CompilerRTEmbeddedAsyncContinuation *continuation) {
+  assert(continuation != NULL);
+  assert(continuation->next == NULL);
+  AsyncRT_AppleWorkQueue_submit(compilerrt_embedded_async_resume, continuation);
+}
+
+static uint32_t compilerrt_embedded_online_processor_count(void) {
+  long online_processor_count = sysconf(_SC_NPROCESSORS_ONLN);
+  assert(online_processor_count > 0);
+  assert((unsigned long)online_processor_count <= UINT32_MAX);
+  return (uint32_t)online_processor_count;
+}
+
+uint32_t KGEN_CompilerRT_AsyncRT_ParallelismLevel(void) {
+  return compilerrt_embedded_online_processor_count();
+}
+
+void KGEN_CompilerRT_AsyncRT_InitializeChain(
+    CompilerRTAsyncChainRef chain_reference) {
+  CompilerRTEmbeddedAsyncChain **chain_slot =
+      compilerrt_embedded_async_chain_slot(chain_reference);
+  assert(*chain_slot == NULL);
+
+  CompilerRTEmbeddedAsyncChain *chain = malloc(sizeof(*chain));
+  assert(chain != NULL);
+  int mutex_result = pthread_mutex_init(&chain->mutex, NULL);
+  assert(mutex_result == 0);
+  int condition_result = pthread_cond_init(&chain->condition, NULL);
+  assert(condition_result == 0);
+  chain->first_continuation = NULL;
+  chain->last_continuation = NULL;
+  chain->waiter_count = 0;
+  chain->magic = COMPILERRT_EMBEDDED_ASYNC_CHAIN_MAGIC;
+  chain->complete = false;
+  *chain_slot = chain;
+}
+
+void KGEN_CompilerRT_AsyncRT_DestroyChain(
+    CompilerRTAsyncChainRef chain_reference) {
+  CompilerRTEmbeddedAsyncChain **chain_slot =
+      compilerrt_embedded_async_chain_slot(chain_reference);
+  CompilerRTEmbeddedAsyncChain *chain = *chain_slot;
+  assert(chain != NULL);
+  assert(chain->magic == COMPILERRT_EMBEDDED_ASYNC_CHAIN_MAGIC);
+
+  int lock_result = pthread_mutex_lock(&chain->mutex);
+  assert(lock_result == 0);
+  assert(chain->complete &&
+         "an AsyncRT chain cannot be destroyed before completion");
+  assert(chain->waiter_count == 0);
+  assert(chain->first_continuation == NULL);
+  assert(chain->last_continuation == NULL);
+  chain->magic = 0;
+  *chain_slot = NULL;
+  int unlock_result = pthread_mutex_unlock(&chain->mutex);
+  assert(unlock_result == 0);
+
+  int condition_result = pthread_cond_destroy(&chain->condition);
+  assert(condition_result == 0);
+  int mutex_result = pthread_mutex_destroy(&chain->mutex);
+  assert(mutex_result == 0);
+  free(chain);
+}
+
+void KGEN_CompilerRT_AsyncRT_Complete(CompilerRTAsyncChainRef chain_reference) {
+  CompilerRTEmbeddedAsyncChain *chain =
+      compilerrt_embedded_async_chain(chain_reference);
+  int lock_result = pthread_mutex_lock(&chain->mutex);
+  assert(lock_result == 0);
+  assert(!chain->complete && "an AsyncRT chain may be completed only once");
+
+  chain->complete = true;
+  CompilerRTEmbeddedAsyncContinuation *continuation = chain->first_continuation;
+  chain->first_continuation = NULL;
+  chain->last_continuation = NULL;
+  int broadcast_result = pthread_cond_broadcast(&chain->condition);
+  assert(broadcast_result == 0);
+  int unlock_result = pthread_mutex_unlock(&chain->mutex);
+  assert(unlock_result == 0);
+
+  while (continuation != NULL) {
+    CompilerRTEmbeddedAsyncContinuation *next = continuation->next;
+    continuation->next = NULL;
+    compilerrt_embedded_async_continuation_submit(continuation);
+    continuation = next;
+  }
+}
+
+void KGEN_CompilerRT_AsyncRT_Wait(CompilerRTAsyncChainRef chain_reference) {
+  CompilerRTEmbeddedAsyncChain *chain =
+      compilerrt_embedded_async_chain(chain_reference);
+  int lock_result = pthread_mutex_lock(&chain->mutex);
+  assert(lock_result == 0);
+  ++chain->waiter_count;
+  assert(chain->waiter_count > 0);
+  while (!chain->complete) {
+    int wait_result = pthread_cond_wait(&chain->condition, &chain->mutex);
+    assert(wait_result == 0);
+  }
+  assert(chain->waiter_count > 0);
+  --chain->waiter_count;
+  int unlock_result = pthread_mutex_unlock(&chain->mutex);
+  assert(unlock_result == 0);
+}
+
+bool KGEN_CompilerRT_AsyncRT_Wait_Timeout(
+    CompilerRTAsyncChainRef chain_reference, int64_t timeout_nanoseconds) {
+  CompilerRTEmbeddedAsyncChain *chain =
+      compilerrt_embedded_async_chain(chain_reference);
+  int lock_result = pthread_mutex_lock(&chain->mutex);
+  assert(lock_result == 0);
+
+  if (timeout_nanoseconds <= 0) {
+    bool complete = chain->complete;
+    int unlock_result = pthread_mutex_unlock(&chain->mutex);
+    assert(unlock_result == 0);
+    return complete;
+  }
+
+  _Static_assert(sizeof(time_t) >= sizeof(int64_t),
+                 "the embedded AsyncRT timeout requires 64-bit time_t");
+  struct timespec now;
+  int clock_result = clock_gettime(CLOCK_MONOTONIC, &now);
+  assert(clock_result == 0);
+  struct timespec deadline = {
+      .tv_sec = now.tv_sec + timeout_nanoseconds / 1000000000LL,
+      .tv_nsec = now.tv_nsec + timeout_nanoseconds % 1000000000LL,
+  };
+  if (deadline.tv_nsec >= 1000000000L) {
+    ++deadline.tv_sec;
+    deadline.tv_nsec -= 1000000000L;
+  }
+  ++chain->waiter_count;
+  assert(chain->waiter_count > 0);
+  int wait_result = 0;
+  while (!chain->complete && wait_result != ETIMEDOUT) {
+    clock_result = clock_gettime(CLOCK_MONOTONIC, &now);
+    assert(clock_result == 0);
+    if (now.tv_sec > deadline.tv_sec ||
+        (now.tv_sec == deadline.tv_sec && now.tv_nsec >= deadline.tv_nsec)) {
+      wait_result = ETIMEDOUT;
+      break;
+    }
+    struct timespec relative_timeout = {
+        .tv_sec = deadline.tv_sec - now.tv_sec,
+        .tv_nsec = deadline.tv_nsec - now.tv_nsec,
+    };
+    if (relative_timeout.tv_nsec < 0) {
+      --relative_timeout.tv_sec;
+      relative_timeout.tv_nsec += 1000000000L;
+    }
+    assert(relative_timeout.tv_sec >= 0);
+    wait_result = pthread_cond_timedwait_relative_np(
+        &chain->condition, &chain->mutex, &relative_timeout);
+    assert(wait_result == 0 || wait_result == ETIMEDOUT);
+  }
+  bool complete = chain->complete;
+  assert(chain->waiter_count > 0);
+  --chain->waiter_count;
+  int unlock_result = pthread_mutex_unlock(&chain->mutex);
+  assert(unlock_result == 0);
+  return complete;
+}
+
+void KGEN_CompilerRT_AsyncRT_Execute(
+    CompilerRTAsyncResumeFunction resume_function, int8_t *handle,
+    ssize_t desired_worker_id) {
+  assert(desired_worker_id >= -1 &&
+         "the embedded Apple executor accepts -1 or a worker affinity hint");
+  CompilerRTEmbeddedAsyncContinuation *task =
+      compilerrt_embedded_async_continuation_create(resume_function, handle);
+  // libdispatch does not expose stable worker identifiers. The generic ABI
+  // defines this value as an affinity hint, so the embedded executor may
+  // lawfully ignore nonnegative values.
+  compilerrt_embedded_async_continuation_submit(task);
+}
+
+void KGEN_CompilerRT_AsyncRT_AndThen(
+    CompilerRTAsyncResumeFunction resume_function,
+    CompilerRTAsyncChainRef chain_reference, int8_t *handle) {
+  CompilerRTEmbeddedAsyncContinuation *continuation =
+      compilerrt_embedded_async_continuation_create(resume_function, handle);
+  CompilerRTEmbeddedAsyncChain *chain =
+      compilerrt_embedded_async_chain(chain_reference);
+  int lock_result = pthread_mutex_lock(&chain->mutex);
+  assert(lock_result == 0);
+  if (chain->complete) {
+    int unlock_result = pthread_mutex_unlock(&chain->mutex);
+    assert(unlock_result == 0);
+    compilerrt_embedded_async_continuation_submit(continuation);
+    return;
+  }
+
+  if (chain->last_continuation == NULL) {
+    assert(chain->first_continuation == NULL);
+    chain->first_continuation = continuation;
+  } else {
+    assert(chain->first_continuation != NULL);
+    chain->last_continuation->next = continuation;
+  }
+  chain->last_continuation = continuation;
+  int unlock_result = pthread_mutex_unlock(&chain->mutex);
+  assert(unlock_result == 0);
+}
+
+CompilerRTAsyncRTRuntimeRef KGEN_CompilerRT_AsyncRT_GetCurrentCPUDevice(void) {
+  int lock_result = pthread_mutex_lock(&compilerrt_embedded_cpu_runtime_mutex);
+  assert(lock_result == 0);
+  CompilerRTEmbeddedCPURuntime *runtime = compilerrt_embedded_cpu_runtime;
+  if (runtime != NULL) {
+    assert(runtime->magic == COMPILERRT_EMBEDDED_CPU_RUNTIME_MAGIC);
+    assert(atomic_load_explicit(&runtime->reference_count,
+                                memory_order_acquire) > 0);
+  }
+  int unlock_result =
+      pthread_mutex_unlock(&compilerrt_embedded_cpu_runtime_mutex);
+  assert(unlock_result == 0);
+  return (CompilerRTAsyncRTRuntimeRef){.pointer = runtime};
+}
+
+CompilerRTAsyncRTRuntimeRef KGEN_CompilerRT_AsyncRT_GetOrCreateCPUDevice(void) {
+  assert(KGEN_CompilerRT_Initialize());
+  int lock_result = pthread_mutex_lock(&compilerrt_embedded_cpu_runtime_mutex);
+  assert(lock_result == 0);
+
+  CompilerRTEmbeddedCPURuntime *runtime = compilerrt_embedded_cpu_runtime;
+  if (runtime == NULL) {
+    runtime = malloc(sizeof(*runtime));
+    assert(runtime != NULL);
+    atomic_init(&runtime->reference_count, 1);
+    runtime->magic = COMPILERRT_EMBEDDED_CPU_RUNTIME_MAGIC;
+    compilerrt_embedded_cpu_runtime = runtime;
+  } else {
+    assert(runtime->magic == COMPILERRT_EMBEDDED_CPU_RUNTIME_MAGIC);
+    uint32_t previous_reference_count = atomic_fetch_add_explicit(
+        &runtime->reference_count, 1, memory_order_acq_rel);
+    assert(previous_reference_count > 0);
+    assert(previous_reference_count < UINT32_MAX);
+  }
+
+  int unlock_result =
+      pthread_mutex_unlock(&compilerrt_embedded_cpu_runtime_mutex);
+  assert(unlock_result == 0);
+  return (CompilerRTAsyncRTRuntimeRef){.pointer = runtime};
+}
+
+void KGEN_CompilerRT_AsyncRT_ReleaseCPUDevice(
+    CompilerRTAsyncRTRuntimeRef runtime_reference) {
+  CompilerRTEmbeddedCPURuntime *runtime = runtime_reference.pointer;
+  assert(runtime != NULL);
+
+  int lock_result = pthread_mutex_lock(&compilerrt_embedded_cpu_runtime_mutex);
+  assert(lock_result == 0);
+  assert(runtime == compilerrt_embedded_cpu_runtime);
+  assert(runtime->magic == COMPILERRT_EMBEDDED_CPU_RUNTIME_MAGIC);
+  uint32_t previous_reference_count = atomic_fetch_sub_explicit(
+      &runtime->reference_count, 1, memory_order_acq_rel);
+  assert(previous_reference_count > 0);
+  if (previous_reference_count == 1) {
+    compilerrt_embedded_cpu_runtime = NULL;
+    runtime->magic = 0;
+  }
+  int unlock_result =
+      pthread_mutex_unlock(&compilerrt_embedded_cpu_runtime_mutex);
+  assert(unlock_result == 0);
+
+  if (previous_reference_count == 1)
+    free(runtime);
+}
+
+void *KGEN_CompilerRT_AsyncRT_InitializeSpinWaiter(void) {
+  CompilerRTEmbeddedSpinWaiter *waiter = malloc(sizeof(*waiter));
+  assert(waiter != NULL);
+  waiter->wait_count = 0;
+  return waiter;
+}
+
+void KGEN_CompilerRT_AsyncRT_SpinWaiter_Wait(void *untyped_waiter) {
+  CompilerRTEmbeddedSpinWaiter *waiter = untyped_waiter;
+  assert(waiter != NULL);
+
+  if (waiter->wait_count < 16) {
+    ++waiter->wait_count;
+    sched_yield();
+    return;
+  }
+
+  const struct timespec delay = {.tv_sec = 0, .tv_nsec = 50000};
+  int sleep_result = nanosleep(&delay, NULL);
+  assert(sleep_result == 0);
+}
+
+void KGEN_CompilerRT_AsyncRT_DestroySpinWaiter(void *untyped_waiter) {
+  assert(untyped_waiter != NULL);
+  free(untyped_waiter);
+}
diff --git a/KGEN/lib/CompilerRT/Embedded/Apple/CompilerRT.c b/KGEN/lib/CompilerRT/Embedded/Apple/CompilerRT.c
new file mode 100644
index 0000000000..f41a15126a
--- /dev/null
+++ b/KGEN/lib/CompilerRT/Embedded/Apple/CompilerRT.c
@@ -0,0 +1,204 @@
+//===----------------------------------------------------------------------===//
+// Copyright (c) 2026, Modular Inc. All rights reserved.
+//
+// Licensed under the Apache License v2.0 with LLVM Exceptions:
+// https://llvm.org/LICENSE.txt
+//
+// Distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+//===----------------------------------------------------------------------===//
+
+#include <assert.h>
+#include <pthread.h>
+#include <stdarg.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/sysctl.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+void KGEN_CompilerRT_DestroyGlobals(void);
+
+typedef struct {
+  const char *data;
+  size_t length;
+} CompilerRTStringRef;
+
+typedef struct {
+  CompilerRTStringRef *arguments;
+  size_t length;
+} CompilerRTArgumentList;
+
+static CompilerRTStringRef compilerrt_embedded_default_argument = {.data = "",
+                                                                   .length = 0};
+static CompilerRTStringRef *compilerrt_embedded_arguments =
+    &compilerrt_embedded_default_argument;
+static char **compilerrt_embedded_owned_argument_strings;
+static size_t compilerrt_embedded_argument_count = 1;
+static pthread_once_t compilerrt_embedded_runtime_once = PTHREAD_ONCE_INIT;
+
+static void compilerrt_embedded_runtime_shutdown(void);
+
+enum { COMPILERRT_EMBEDDED_PREFERRED_MEMORY_ALIGNMENT = 16 };
+
+static bool compilerrt_embedded_is_power_of_two(size_t value) {
+  return value != 0 && (value & (value - 1)) == 0;
+}
+
+static size_t compilerrt_embedded_sysctl_size(const char *name) {
+  assert(name != NULL);
+  uint32_t value = 0;
+  size_t value_size = sizeof(value);
+  int result = sysctlbyname(name, &value, &value_size, NULL, 0);
+  assert(result == 0);
+  assert(value_size == sizeof(value));
+  assert(value > 0);
+  return value;
+}
+
+size_t KGEN_CompilerRT_NumPhysicalCores(void) {
+  return compilerrt_embedded_sysctl_size("hw.physicalcpu");
+}
+
+size_t KGEN_CompilerRT_NumLogicalCores(void) {
+  long logical_core_count = sysconf(_SC_NPROCESSORS_ONLN);
+  assert(logical_core_count > 0);
+  return (size_t)logical_core_count;
+}
+
+size_t KGEN_CompilerRT_NumPerformanceCores(void) {
+  uint32_t value = 0;
+  size_t value_size = sizeof(value);
+  int result =
+      sysctlbyname("hw.perflevel0.physicalcpu", &value, &value_size, NULL, 0);
+  if (result != 0)
+    return KGEN_CompilerRT_NumPhysicalCores();
+  assert(value_size == sizeof(value));
+  assert(value > 0);
+  return value;
+}
+
+void *KGEN_CompilerRT_AlignedAlloc(ssize_t requested_alignment,
+                                   ssize_t requested_size) {
+  assert(requested_size >= 0);
+
+  size_t alignment = requested_alignment <= 0
+                         ? COMPILERRT_EMBEDDED_PREFERRED_MEMORY_ALIGNMENT
+                         : (size_t)requested_alignment;
+  size_t size = (size_t)requested_size;
+
+  assert(compilerrt_embedded_is_power_of_two(alignment));
+
+  if (alignment <= 8)
+    return malloc(size);
+
+  assert(alignment >= sizeof(void *));
+  assert(size <= SIZE_MAX - (alignment - 1));
+
+  size_t aligned_size = (size + alignment - 1) & ~(alignment - 1);
+  return aligned_alloc(alignment, aligned_size);
+}
+
+void KGEN_CompilerRT_AlignedFree(void *pointer) { free(pointer); }
+
+void KGEN_CompilerRT_SetAsanAllocators(void) {
+  // This embedded runtime always uses the platform allocator. ASan interposes
+  // it directly, so there is no alternate allocator table to install.
+}
+
+int KGEN_CompilerRT_GetStackTrace(char **strings, unsigned depth) {
+  assert(strings != NULL);
+  (void)depth;
+  *strings = NULL;
+  return 0;
+}
+
+size_t KGEN_CompilerRT_TracyIsEnabled(void) { return 0; }
+
+uint64_t KGEN_CompilerRT_TracyZoneBegin(const char *name, size_t name_length,
+                                        uint32_t color) {
+  (void)name;
+  (void)name_length;
+  (void)color;
+  return 0;
+}
+
+void KGEN_CompilerRT_TracyZoneEnd(uint64_t context) {
+  assert(context == 0 && "Tracy is disabled in the embedded runtime");
+}
+
+int KGEN_CompilerRT_fprintf(FILE *stream, const char *format, ...) {
+  va_list arguments;
+  va_start(arguments, format);
+  int result = vfprintf(stream, format, arguments);
+  va_end(arguments);
+  return result;
+}
+
+static void compilerrt_embedded_runtime_initialize_once(void) {
+  int result = atexit(compilerrt_embedded_runtime_shutdown);
+  assert(result == 0);
+}
+
+bool KGEN_CompilerRT_Initialize(void) {
+  int result = pthread_once(&compilerrt_embedded_runtime_once,
+                            compilerrt_embedded_runtime_initialize_once);
+  assert(result == 0);
+  return true;
+}
+
+void KGEN_CompilerRT_GetArgV(CompilerRTArgumentList *result) {
+  assert(result != NULL);
+  result->arguments = compilerrt_embedded_arguments;
+  result->length = compilerrt_embedded_argument_count;
+}
+
+void KGEN_CompilerRT_SetArgV(int argument_count, char **arguments) {
+  assert(argument_count >= 0);
+  assert(arguments != NULL || argument_count == 0);
+  assert(compilerrt_embedded_arguments ==
+             &compilerrt_embedded_default_argument &&
+         "Mojo argv may only be initialized once");
+
+  if (argument_count == 0) {
+    compilerrt_embedded_arguments = NULL;
+    compilerrt_embedded_argument_count = 0;
+    return;
+  }
+
+  size_t count = (size_t)argument_count;
+  CompilerRTStringRef *argument_refs = calloc(count, sizeof(*argument_refs));
+  char **owned_strings = calloc(count, sizeof(*owned_strings));
+  assert(argument_refs != NULL);
+  assert(owned_strings != NULL);
+
+  for (size_t index = 0; index < count; ++index) {
+    assert(arguments[index] != NULL);
+    owned_strings[index] = strdup(arguments[index]);
+    assert(owned_strings[index] != NULL);
+    argument_refs[index].data = owned_strings[index];
+    argument_refs[index].length = strlen(owned_strings[index]);
+  }
+
+  compilerrt_embedded_owned_argument_strings = owned_strings;
+  compilerrt_embedded_arguments = argument_refs;
+  compilerrt_embedded_argument_count = count;
+}
+
+void KGEN_CompilerRT_PrintStackTraceOnFault(void) {}
+
+static void compilerrt_embedded_runtime_shutdown(void) {
+  KGEN_CompilerRT_DestroyGlobals();
+  if (compilerrt_embedded_owned_argument_strings == NULL)
+    return;
+  for (size_t index = 0; index < compilerrt_embedded_argument_count; ++index)
+    free(compilerrt_embedded_owned_argument_strings[index]);
+  free(compilerrt_embedded_owned_argument_strings);
+  free(compilerrt_embedded_arguments);
+}
diff --git a/KGEN/lib/CompilerRT/Embedded/Globals.c b/KGEN/lib/CompilerRT/Embedded/Globals.c
new file mode 100644
index 0000000000..e56e9fcb3c
--- /dev/null
+++ b/KGEN/lib/CompilerRT/Embedded/Globals.c
@@ -0,0 +1,312 @@
+//===----------------------------------------------------------------------===//
+// Copyright (c) 2026, Modular Inc. All rights reserved.
+//
+// Licensed under the Apache License v2.0 with LLVM Exceptions:
+// https://llvm.org/LICENSE.txt
+//
+// Distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+//===----------------------------------------------------------------------===//
+
+#include <assert.h>
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+typedef struct {
+  const char *data;
+  size_t length;
+} CompilerRTStringRef;
+
+typedef void *(*CompilerRTGlobalInitializeFunction)(void);
+typedef void (*CompilerRTGlobalDestroyFunction)(void *);
+
+typedef struct CompilerRTGlobalEntry CompilerRTGlobalEntry;
+
+struct CompilerRTGlobalEntry {
+  void *value;
+  CompilerRTGlobalDestroyFunction destroy_function;
+  _Atomic(CompilerRTGlobalEntry *) next_in_destruction_order;
+  CompilerRTGlobalEntry *next_overflow_entry;
+  size_t name_length;
+  char name[];
+};
+
+enum {
+  COMPILERRT_EMBEDDED_GLOBAL_TABLE_SIZE = 4096,
+  COMPILERRT_EMBEDDED_GLOBAL_TABLE_MAX_PROBES = 12,
+  COMPILERRT_EMBEDDED_INDEXED_GLOBAL_COUNT = 3,
+};
+
+static _Atomic(CompilerRTGlobalEntry *)
+    compilerrt_embedded_global_table[COMPILERRT_EMBEDDED_GLOBAL_TABLE_SIZE];
+static _Atomic(CompilerRTGlobalEntry *)
+    compilerrt_embedded_global_destruction_order;
+static pthread_mutex_t compilerrt_embedded_overflow_mutex =
+    PTHREAD_MUTEX_INITIALIZER;
+static CompilerRTGlobalEntry *compilerrt_embedded_overflow_entries;
+
+typedef struct {
+  _Atomic(void *) value;
+  _Atomic(CompilerRTGlobalDestroyFunction) destroy_function;
+} CompilerRTIndexedGlobalEntry;
+
+static CompilerRTIndexedGlobalEntry compilerrt_embedded_indexed_globals
+    [COMPILERRT_EMBEDDED_INDEXED_GLOBAL_COUNT];
+
+static uint64_t compilerrt_embedded_hash_name(CompilerRTStringRef name) {
+  uint64_t hash = UINT64_C(1469598103934665603);
+  for (size_t index = 0; index < name.length; ++index) {
+    hash ^= (unsigned char)name.data[index];
+    hash *= UINT64_C(1099511628211);
+  }
+  return hash;
+}
+
+static bool
+compilerrt_embedded_global_name_equals(const CompilerRTGlobalEntry *entry,
+                                       CompilerRTStringRef name) {
+  if (entry->name_length != name.length)
+    return false;
+
+  return name.length == 0 || memcmp(entry->name, name.data, name.length) == 0;
+}
+
+static CompilerRTGlobalEntry *compilerrt_embedded_create_global_entry(
+    CompilerRTStringRef name, void *value,
+    CompilerRTGlobalDestroyFunction destroy_function) {
+  assert(name.data != NULL || name.length == 0);
+  assert(name.length <= SIZE_MAX - sizeof(CompilerRTGlobalEntry) - 1);
+
+  size_t allocation_size = sizeof(CompilerRTGlobalEntry) + name.length + 1;
+  CompilerRTGlobalEntry *entry = malloc(allocation_size);
+  if (entry == NULL)
+    return NULL;
+
+  entry->value = value;
+  entry->destroy_function = destroy_function;
+  atomic_init(&entry->next_in_destruction_order, NULL);
+  entry->next_overflow_entry = NULL;
+  entry->name_length = name.length;
+  if (name.length != 0)
+    memcpy(entry->name, name.data, name.length);
+  entry->name[name.length] = '\0';
+  return entry;
+}
+
+static void
+compilerrt_embedded_destroy_global_entry(CompilerRTGlobalEntry *entry) {
+  if (entry->destroy_function != NULL && entry->value != NULL)
+    entry->destroy_function(entry->value);
+  free(entry);
+}
+
+static void
+compilerrt_embedded_insert_destruction_order(CompilerRTGlobalEntry *new_entry) {
+  CompilerRTGlobalEntry *old_head = atomic_load_explicit(
+      &compilerrt_embedded_global_destruction_order, memory_order_relaxed);
+  do {
+    atomic_store_explicit(&new_entry->next_in_destruction_order, old_head,
+                          memory_order_relaxed);
+  } while (!atomic_compare_exchange_weak_explicit(
+      &compilerrt_embedded_global_destruction_order, &old_head, new_entry,
+      memory_order_release, memory_order_relaxed));
+}
+
+static void *compilerrt_embedded_get_or_create_overflow_global(
+    CompilerRTStringRef name,
+    CompilerRTGlobalInitializeFunction initialize_function,
+    CompilerRTGlobalDestroyFunction destroy_function) {
+  int lock_result = pthread_mutex_lock(&compilerrt_embedded_overflow_mutex);
+  assert(lock_result == 0);
+
+  for (CompilerRTGlobalEntry *entry = compilerrt_embedded_overflow_entries;
+       entry != NULL; entry = entry->next_overflow_entry) {
+    if (compilerrt_embedded_global_name_equals(entry, name)) {
+      void *value = entry->value;
+      int unlock_result =
+          pthread_mutex_unlock(&compilerrt_embedded_overflow_mutex);
+      assert(unlock_result == 0);
+      return value;
+    }
+  }
+
+  if (initialize_function == NULL) {
+    int unlock_result =
+        pthread_mutex_unlock(&compilerrt_embedded_overflow_mutex);
+    assert(unlock_result == 0);
+    return NULL;
+  }
+
+  void *value = initialize_function();
+  if (value == NULL) {
+    int unlock_result =
+        pthread_mutex_unlock(&compilerrt_embedded_overflow_mutex);
+    assert(unlock_result == 0);
+    return NULL;
+  }
+
+  CompilerRTGlobalEntry *entry =
+      compilerrt_embedded_create_global_entry(name, value, destroy_function);
+  if (entry == NULL) {
+    if (destroy_function != NULL)
+      destroy_function(value);
+    int unlock_result =
+        pthread_mutex_unlock(&compilerrt_embedded_overflow_mutex);
+    assert(unlock_result == 0);
+    return NULL;
+  }
+
+  entry->next_overflow_entry = compilerrt_embedded_overflow_entries;
+  compilerrt_embedded_overflow_entries = entry;
+
+  int unlock_result = pthread_mutex_unlock(&compilerrt_embedded_overflow_mutex);
+  assert(unlock_result == 0);
+  return value;
+}
+
+void *KGEN_CompilerRT_GetOrCreateGlobal(
+    CompilerRTStringRef name,
+    CompilerRTGlobalInitializeFunction initialize_function,
+    CompilerRTGlobalDestroyFunction destroy_function) {
+  uint64_t hash = compilerrt_embedded_hash_name(name);
+  size_t start_index = hash & (COMPILERRT_EMBEDDED_GLOBAL_TABLE_SIZE - 1);
+
+  for (size_t probe = 0; probe < COMPILERRT_EMBEDDED_GLOBAL_TABLE_MAX_PROBES;
+       ++probe) {
+    size_t index =
+        (start_index + probe) & (COMPILERRT_EMBEDDED_GLOBAL_TABLE_SIZE - 1);
+    CompilerRTGlobalEntry *entry = atomic_load_explicit(
+        &compilerrt_embedded_global_table[index], memory_order_acquire);
+
+    if (entry != NULL) {
+      if (compilerrt_embedded_global_name_equals(entry, name))
+        return entry->value;
+      continue;
+    }
+
+    if (initialize_function == NULL)
+      return NULL;
+
+    void *new_value = initialize_function();
+    if (new_value == NULL)
+      return NULL;
+
+    CompilerRTGlobalEntry *new_entry = compilerrt_embedded_create_global_entry(
+        name, new_value, destroy_function);
+    if (new_entry == NULL) {
+      if (destroy_function != NULL)
+        destroy_function(new_value);
+      return NULL;
+    }
+
+    CompilerRTGlobalEntry *expected_entry = NULL;
+    if (atomic_compare_exchange_strong_explicit(
+            &compilerrt_embedded_global_table[index], &expected_entry,
+            new_entry, memory_order_acq_rel, memory_order_acquire)) {
+      compilerrt_embedded_insert_destruction_order(new_entry);
+      return new_value;
+    }
+
+    compilerrt_embedded_destroy_global_entry(new_entry);
+
+    if (expected_entry != NULL &&
+        compilerrt_embedded_global_name_equals(expected_entry, name))
+      return expected_entry->value;
+  }
+
+  return compilerrt_embedded_get_or_create_overflow_global(
+      name, initialize_function, destroy_function);
+}
+
+void *KGEN_CompilerRT_GetGlobalOrNull(CompilerRTStringRef name) {
+  return KGEN_CompilerRT_GetOrCreateGlobal(name, NULL, NULL);
+}
+
+static _Thread_local void *compilerrt_embedded_insert_global_value;
+
+static void *compilerrt_embedded_insert_global_initialize(void) {
+  return compilerrt_embedded_insert_global_value;
+}
+
+void KGEN_CompilerRT_InsertGlobal(CompilerRTStringRef name, void *value) {
+  compilerrt_embedded_insert_global_value = value;
+  (void)KGEN_CompilerRT_GetOrCreateGlobal(
+      name, compilerrt_embedded_insert_global_initialize, NULL);
+}
+
+void *KGEN_CompilerRT_GetOrCreateGlobalIndexed(
+    size_t index, CompilerRTGlobalInitializeFunction initialize_function,
+    CompilerRTGlobalDestroyFunction destroy_function) {
+  assert(index < COMPILERRT_EMBEDDED_INDEXED_GLOBAL_COUNT);
+  assert(initialize_function != NULL);
+
+  CompilerRTIndexedGlobalEntry *entry =
+      &compilerrt_embedded_indexed_globals[index];
+  void *value = atomic_load_explicit(&entry->value, memory_order_acquire);
+  if (value != NULL)
+    return value;
+
+  void *new_value = initialize_function();
+  if (new_value == NULL)
+    return NULL;
+
+  void *expected_value = NULL;
+  if (!atomic_compare_exchange_strong_explicit(&entry->value, &expected_value,
+                                               new_value, memory_order_acq_rel,
+                                               memory_order_acquire)) {
+    if (destroy_function != NULL)
+      destroy_function(new_value);
+    return expected_value;
+  }
+
+  atomic_store_explicit(&entry->destroy_function, destroy_function,
+                        memory_order_release);
+  return new_value;
+}
+
+void KGEN_CompilerRT_DestroyGlobals(void) {
+  int lock_result = pthread_mutex_lock(&compilerrt_embedded_overflow_mutex);
+  assert(lock_result == 0);
+  CompilerRTGlobalEntry *overflow_entry = compilerrt_embedded_overflow_entries;
+  compilerrt_embedded_overflow_entries = NULL;
+  while (overflow_entry != NULL) {
+    CompilerRTGlobalEntry *next_entry = overflow_entry->next_overflow_entry;
+    compilerrt_embedded_destroy_global_entry(overflow_entry);
+    overflow_entry = next_entry;
+  }
+  int unlock_result = pthread_mutex_unlock(&compilerrt_embedded_overflow_mutex);
+  assert(unlock_result == 0);
+
+  CompilerRTGlobalEntry *entry =
+      atomic_exchange_explicit(&compilerrt_embedded_global_destruction_order,
+                               NULL, memory_order_acq_rel);
+  for (size_t index = 0; index < COMPILERRT_EMBEDDED_GLOBAL_TABLE_SIZE; ++index)
+    atomic_store_explicit(&compilerrt_embedded_global_table[index], NULL,
+                          memory_order_relaxed);
+
+  while (entry != NULL) {
+    CompilerRTGlobalEntry *next_entry = atomic_load_explicit(
+        &entry->next_in_destruction_order, memory_order_relaxed);
+    compilerrt_embedded_destroy_global_entry(entry);
+    entry = next_entry;
+  }
+
+  for (size_t index = 0; index < COMPILERRT_EMBEDDED_INDEXED_GLOBAL_COUNT;
+       ++index) {
+    CompilerRTIndexedGlobalEntry *indexed_entry =
+        &compilerrt_embedded_indexed_globals[index];
+    void *indexed_value = atomic_exchange_explicit(&indexed_entry->value, NULL,
+                                                   memory_order_acq_rel);
+    CompilerRTGlobalDestroyFunction destroy_function = atomic_exchange_explicit(
+        &indexed_entry->destroy_function, NULL, memory_order_acq_rel);
+    if (destroy_function != NULL && indexed_value != NULL)
+      destroy_function(indexed_value);
+  }
+}
