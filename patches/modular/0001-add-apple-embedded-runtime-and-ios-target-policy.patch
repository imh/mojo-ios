+//===----------------------------------------------------------------------===//
+// Copyright (c) 2026, Modular Inc. All rights reserved.
+//
+// Licensed under the Apache License v2.0 with LLVM Exceptions:
+// https://llvm.org/LICENSE.txt
+//===----------------------------------------------------------------------===//
+
+#include "Target/Metal/MetalTraits.h"
+
+#include "llvm/TargetParser/Triple.h"
+
+namespace M::KGEN {
+
+bool MetalTraits::matches(const llvm::Triple &triple) const {
+  return triple.str().starts_with("air64-apple-");
+}
+
+std::string MetalTraits::codegenTriple(llvm::StringRef triple) const {
+  assert(triple.starts_with("air64-apple-") &&
+         "Metal codegen requires an AIR target triple");
+  std::string result = triple.str();
+  result.replace(0, llvm::StringRef("air64").size(), "arm64");
+  return result;
+}
+
+llvm::ArrayRef<TargetTraits::AcceleratorArch>
+MetalTraits::supportedAcceleratorArchs() const {
+  static constexpr AcceleratorArch architectures[] = {
+      {"apple-m1", "Apple M1"},
+      {"apple-m1-metal4", "Apple M1 (Metal 4)"},
+      {"apple-m2", "Apple M2"},
+      {"apple-m2-metal4", "Apple M2 (Metal 4)"},
+      {"apple-m3", "Apple M3"},
+      {"apple-m3-metal4", "Apple M3 (Metal 4)"},
+      {"apple-m4", "Apple M4"},
+      {"apple-m4-metal4", "Apple M4 (Metal 4)"},
+      {"apple-m5", "Apple M5"},
+      {"apple-m5-metal4", "Apple M5 (Metal 4)"},
+  };
+  return architectures;
+}
+
+const MetalTraits &MetalTraits::get() {
+  static const MetalTraits instance;
+  return instance;
+}
+
+namespace {
+#pragma GCC diagnostic push
+#pragma GCC diagnostic ignored "-Wglobal-constructors"
+RegisterTargetTraits<MetalTraits> registerMetalTraits;
+#pragma GCC diagnostic pop
+} // namespace
+
+} // namespace M::KGEN
