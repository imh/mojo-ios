+/// Preserve the source-declared pointee type on each offload entry argument.
+/// Pointer element types are otherwise intentionally erased by the ordinary
+/// opaque-pointer ABI before target backends consume the module.
+static ErrorOrSuccess attachOffloadArgumentTypes(
+    GeneratorOp entry, ArrayAttr pointerElementTypes) {
+  if (pointerElementTypes.size() != entry.getNumArguments())
+    return Error(llvm::formatv(
+        "compile_offload argument type count {0} does not match kernel "
+        "argument count {1}",
+        pointerElementTypes.size(), entry.getNumArguments()));
+
+  MLIRContext *context = entry.getContext();
+  SmallVector<Attribute> argumentMetadata;
+  if (ArrayAttr existing = entry.getLLVMArgMetadataArrayAttr();
+      !existing.empty())
+    argumentMetadata.assign(existing.begin(), existing.end());
+  else
+    argumentMetadata.assign(pointerElementTypes.size(),
+                            ArrayAttr::get(context, {}));
+
+  for (auto [index, pointerElementType] :
+       llvm::enumerate(pointerElementTypes)) {
+    auto elementTypeAttribute = dyn_cast<TypeAttr>(pointerElementType);
+    if (!elementTypeAttribute)
+      continue;
+    Type elementType = elementTypeAttribute.getValue();
+    std::string descriptor;
+    if (auto simdType = sugarDynCast<SIMDType>(elementType)) {
+      std::optional<int64_t> width = simdType.getResolvedSize();
+      std::optional<KGENDType> dtype = simdType.getResolvedDType();
+      if (width && dtype)
+        descriptor = llvm::formatv("simd:{0}:{1}", *width,
+                                   dtype->getAsString())
+                         .str();
+    }
+    if (descriptor.empty()) {
+      llvm::raw_string_ostream stream(descriptor);
+      elementType.print(stream);
+    }
+
+    SmallVector<Attribute> metadata =
+        llvm::to_vector(cast<ArrayAttr>(argumentMetadata[index]));
+    metadata.push_back(StringAttr::get(context, kOffloadPointeeTypeMetadata));
+    metadata.push_back(StringAttr::get(context, descriptor));
+    argumentMetadata[index] = ArrayAttr::get(context, metadata);
+  }
+
+  entry.setLLVMArgMetadataArrayAttr(ArrayAttr::get(context, argumentMetadata));
+  return success();
+}
