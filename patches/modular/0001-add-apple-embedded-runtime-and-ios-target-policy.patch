+
+#include "AppleDeviceContextInternal.h"
+#include "AsyncRT/Runtime/DeviceContextCAPI.h"
+
+#import <Foundation/Foundation.h>
+#import <Metal/Metal.h>
+
+#include <assert.h>
+#include <limits.h>
+#include <stddef.h>
+#include <stdatomic.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+enum {
+  ASYNCRT_APPLE_METAL_BUFFER_MAGIC = 0x4D544C42,
+  ASYNCRT_APPLE_METAL_FUNCTION_MAGIC = 0x4D544C46,
+  ASYNCRT_APPLE_BUFFER_METAL = 1,
+};
+
+@interface AsyncRTMetalPendingHostCopy : NSObject
+@property(nonatomic, strong) id<MTLBuffer> stagingBuffer;
+@property(nonatomic, assign) void *destination;
+@property(nonatomic, assign) size_t length;
+@end
+
+@implementation AsyncRTMetalPendingHostCopy
+@end
+
+@interface AsyncRTMetalContextStorage : NSObject
+@property(nonatomic, strong) id<MTLDevice> device;
+@property(nonatomic, strong) id<MTLCommandQueue> commandQueue;
+@property(nonatomic, strong) id<MTLCommandBuffer> commandBuffer;
+@property(nonatomic, strong) NSMutableArray<id> *retainedResources;
+@property(nonatomic, strong)
+    NSMutableArray<AsyncRTMetalPendingHostCopy *> *pendingHostCopies;
+@end
+
+@implementation AsyncRTMetalContextStorage
+@end
+
+typedef struct {
+  AsyncRTAppleDeviceContextBase base;
+  void *storage;
+} AsyncRTMetalDeviceContext;
+
+typedef struct {
+  _Atomic(uint32_t) reference_count;
+  uint32_t magic;
+  uint32_t kind;
+  size_t byte_count;
+  void *storage;
+} AsyncRTMetalDeviceBuffer;
+
+typedef struct {
+  _Atomic(uint32_t) reference_count;
+  uint32_t magic;
+  void *pipeline;
+} AsyncRTMetalDeviceFunction;
+
+// This must match max.gpu.host._device_context_metal.MetalEnqueueFunctionArgs.
+// Mojo's Optional[Pointer[...]] has the pointer representation used here.
+typedef struct {
+  void *const *arguments;
+  const uint64_t *argument_sizes;
+  const bool *argument_is_device_pointer;
+  AsyncRTMetalDeviceBuffer *const *buffers;
+  const int32_t *device_pointer_argument_indices;
+  const uint64_t *device_pointer_byte_offsets;
+  int32_t buffer_count;
+  int32_t device_pointer_fixup_count;
+} AsyncRTMetalEnqueueFunctionArguments;
+
+_Static_assert(offsetof(AsyncRTMetalEnqueueFunctionArguments,
+                        argument_sizes) == sizeof(void *),
+               "Metal argument-size ABI offset drifted from Mojo");
+_Static_assert(offsetof(AsyncRTMetalEnqueueFunctionArguments,
+                        device_pointer_byte_offsets) == 5 * sizeof(void *),
+               "Metal device-pointer-fixup ABI offset drifted from Mojo");
+_Static_assert(offsetof(AsyncRTMetalEnqueueFunctionArguments, buffer_count) ==
+                   6 * sizeof(void *),
+               "Metal buffer-count ABI offset drifted from Mojo");
+_Static_assert(sizeof(AsyncRTMetalEnqueueFunctionArguments) ==
+                   6 * sizeof(void *) + 2 * sizeof(int32_t),
+               "Metal enqueue-argument ABI size drifted from Mojo");
+
+// This must match max.gpu.host.LaunchAttribute.  Launch attributes are a
+// CUDA-shaped API; Metal accepts IGNORE entries and diagnoses every concrete
+// CUDA attribute by name rather than silently discarding it.
+typedef struct {
+  int32_t identifier;
+  uint8_t padding[4];
+  uint8_t value[64];
+} AsyncRTMetalLaunchAttribute;
+
+_Static_assert(sizeof(AsyncRTMetalLaunchAttribute) == 72,
+               "Metal launch-attribute ABI drifted from Mojo");
+
+static const char *asyncrt_metal_owned_error(const char *message) {
+  assert(message != NULL);
+  char *owned_message = strdup(message);
+  assert(owned_message != NULL);
+  return owned_message;
+}
+
+static const char *asyncrt_metal_owned_nserror(const char *operation,
+                                               NSError *error) {
+  assert(operation != NULL);
+  const char *detail = error == nil ? "no diagnostic was provided"
+                                    : error.localizedDescription.UTF8String;
+  if (detail == NULL)
+    detail = "the diagnostic was not valid UTF-8";
+  size_t operation_length = strlen(operation);
+  size_t detail_length = strlen(detail);
+  assert(operation_length <= SIZE_MAX - detail_length - 3);
+  char *message = malloc(operation_length + detail_length + 3);
+  assert(message != NULL);
+  memcpy(message, operation, operation_length);
+  memcpy(message + operation_length, ": ", 2);
+  memcpy(message + operation_length + 2, detail, detail_length + 1);
+  return message;
+}
+
+static const char *
+asyncrt_metal_validate_launch_attributes(const void *untyped_attributes,
+                                         uint32_t attribute_count) {
+  if (attribute_count == 0)
+    return NULL;
+  if (untyped_attributes == NULL)
+    return asyncrt_metal_owned_error("Metal launch attributes pointer is null");
+
+  const AsyncRTMetalLaunchAttribute *attributes = untyped_attributes;
+  for (uint32_t index = 0; index < attribute_count; ++index) {
+    switch (attributes[index].identifier) {
+    case 0: // IGNORE
+      break;
+    case 1:
+      return asyncrt_metal_owned_error(
+          "Metal launch attribute ACCESS_POLICY_WINDOW is CUDA-only");
+    case 2:
+      return asyncrt_metal_owned_error(
+          "Metal launch attribute COOPERATIVE is CUDA-only");
+    case 3:
+      return asyncrt_metal_owned_error(
+          "Metal launch attribute SYNCHRONIZATION_POLICY is CUDA-only");
+    case 4:
+      return asyncrt_metal_owned_error(
+          "Metal launch attribute CLUSTER_DIMENSION is CUDA-only");
+    case 5:
+      return asyncrt_metal_owned_error(
+          "Metal launch attribute CLUSTER_SCHEDULING_POLICY_PREFERENCE is "
+          "CUDA-only");
+    case 6:
+      return asyncrt_metal_owned_error(
+          "Metal launch attribute PROGRAMMATIC_STREAM_SERIALIZATION is "
+          "CUDA-only");
+    case 7:
+      return asyncrt_metal_owned_error(
+          "Metal launch attribute PROGRAMMATIC_EVENT is CUDA-only");
+    case 8:
+      return asyncrt_metal_owned_error(
+          "Metal launch attribute PRIORITY is CUDA-only");
+    case 9:
+      return asyncrt_metal_owned_error(
+          "Metal launch attribute MEM_SYNC_DOMAIN_MAP is CUDA-only");
+    case 10:
+      return asyncrt_metal_owned_error(
+          "Metal launch attribute MEM_SYNC_DOMAIN is CUDA-only");
+    case 12:
+      return asyncrt_metal_owned_error(
+          "Metal launch attribute LAUNCH_COMPLETION_EVENT is CUDA-only");
+    case 13:
+      return asyncrt_metal_owned_error(
+          "Metal launch attribute DEVICE_UPDATABLE_KERNEL_NODE is CUDA-only");
+    case 14:
+      return asyncrt_metal_owned_error(
+          "Metal launch attribute PREFERRED_SHARED_MEMORY_CARVEOUT is "
+          "CUDA-only");
+    case 11:
+    default:
+      return asyncrt_metal_owned_error(
+          "Metal received an unknown launch attribute identifier");
+    }
+  }
+  return NULL;
+}
+
+static AsyncRTMetalDeviceContext *
+asyncrt_metal_context_from_untyped(void *untyped_context) {
+  AsyncRTMetalDeviceContext *context = untyped_context;
+  assert(context != NULL);
+  assert(context->base.magic == ASYNCRT_APPLE_DEVICE_CONTEXT_MAGIC);
+  assert(context->base.kind == ASYNCRT_APPLE_DEVICE_CONTEXT_METAL);
+  assert(atomic_load_explicit(&context->base.reference_count,
+                              memory_order_acquire) > 0);
+  assert(context->storage != NULL);
+  return context;
+}
+
+static AsyncRTMetalContextStorage *
+asyncrt_metal_context_storage(AsyncRTMetalDeviceContext *context) {
+  assert(context != NULL);
+  assert(context->storage != NULL);
+  return (__bridge AsyncRTMetalContextStorage *)context->storage;
+}
+
+static AsyncRTMetalDeviceBuffer *
+asyncrt_metal_buffer_from_untyped(void *untyped_buffer) {
+  AsyncRTMetalDeviceBuffer *buffer = untyped_buffer;
+  assert(buffer != NULL);
+  assert(buffer->magic == ASYNCRT_APPLE_METAL_BUFFER_MAGIC);
+  assert(atomic_load_explicit(&buffer->reference_count, memory_order_acquire) >
+         0);
+  assert(buffer->kind == ASYNCRT_APPLE_BUFFER_METAL);
+  assert(buffer->storage != NULL);
+  return buffer;
+}
+
+static id<MTLBuffer>
+asyncrt_metal_buffer_object(AsyncRTMetalDeviceBuffer *buffer) {
+  assert(buffer->kind == ASYNCRT_APPLE_BUFFER_METAL);
+  return (__bridge id<MTLBuffer>)buffer->storage;
+}
+
+static uint32_t asyncrt_apple_context_kind(void *untyped_context) {
+  AsyncRTAppleDeviceContextBase *context = untyped_context;
+  assert(context != NULL);
+  assert(context->magic == ASYNCRT_APPLE_DEVICE_CONTEXT_MAGIC);
+  assert(context->kind == ASYNCRT_APPLE_DEVICE_CONTEXT_CPU ||
+         context->kind == ASYNCRT_APPLE_DEVICE_CONTEXT_METAL);
+  assert(atomic_load_explicit(&context->reference_count, memory_order_acquire) >
+         0);
+  return context->kind;
+}
+
+static AsyncRTMetalDeviceFunction *
+asyncrt_metal_function_from_untyped(void *untyped_function) {
+  AsyncRTMetalDeviceFunction *function = untyped_function;
+  assert(function != NULL);
+  assert(function->magic == ASYNCRT_APPLE_METAL_FUNCTION_MAGIC);
+  assert(atomic_load_explicit(&function->reference_count,
+                              memory_order_acquire) > 0);
+  assert(function->pipeline != NULL);
+  return function;
+}
+
+static id<MTLComputePipelineState>
+asyncrt_metal_pipeline_object(AsyncRTMetalDeviceFunction *function) {
+  return (__bridge id<MTLComputePipelineState>)function->pipeline;
+}
+
+static id<MTLCommandBuffer> asyncrt_metal_get_or_create_command_buffer(
+    AsyncRTMetalContextStorage *storage) {
+  assert(storage != nil);
+  if (storage.commandBuffer == nil)
+    storage.commandBuffer = [storage.commandQueue commandBuffer];
+  return storage.commandBuffer;
+}
+
+static const char *
+asyncrt_metal_synchronize_context(AsyncRTMetalDeviceContext *context) {
+  assert(context != NULL);
+  AsyncRTMetalContextStorage *storage = asyncrt_metal_context_storage(context);
+  @synchronized(storage) {
+    id<MTLCommandBuffer> command_buffer = storage.commandBuffer;
+    if (command_buffer == nil) {
+      assert(storage.pendingHostCopies.count == 0);
+      assert(storage.retainedResources.count == 0);
+      return NULL;
+    }
+
+    storage.commandBuffer = nil;
+    [command_buffer commit];
+    [command_buffer waitUntilCompleted];
+    if (command_buffer.status == MTLCommandBufferStatusError) {
+      [storage.pendingHostCopies removeAllObjects];
+      [storage.retainedResources removeAllObjects];
+      return asyncrt_metal_owned_nserror("Metal command buffer failed",
+                                         command_buffer.error);
+    }
+
+    for (AsyncRTMetalPendingHostCopy *pending_copy in storage
+             .pendingHostCopies) {
+      assert(pending_copy.destination != NULL || pending_copy.length == 0);
+      assert(pending_copy.stagingBuffer.length >= pending_copy.length);
+      if (pending_copy.length != 0)
+        memcpy(pending_copy.destination, pending_copy.stagingBuffer.contents,
+               pending_copy.length);
+    }
+    [storage.pendingHostCopies removeAllObjects];
+    [storage.retainedResources removeAllObjects];
+    return NULL;
+  }
+}
+
+const char *AsyncRT_AppleMetalDeviceContext_create(void **result,
+                                                   int32_t device_id) {
+  @autoreleasepool {
+    if (result == NULL)
+      return asyncrt_metal_owned_error("Metal DeviceContext result is null");
+    *result = NULL;
+    if (device_id != 0)
+      return asyncrt_metal_owned_error(
+          "the embedded Apple Metal DeviceContext supports only device 0");
+
+    id<MTLDevice> device = MTLCreateSystemDefaultDevice();
+    if (device == nil)
+      return asyncrt_metal_owned_error("Metal device 0 is unavailable");
+    id<MTLCommandQueue> command_queue = [device newCommandQueue];
+    if (command_queue == nil)
+      return asyncrt_metal_owned_error(
+          "Metal device 0 could not create a command queue");
+
+    AsyncRTMetalContextStorage *storage =
+        [[AsyncRTMetalContextStorage alloc] init];
+    storage.device = device;
+    storage.commandQueue = command_queue;
+    storage.retainedResources = [[NSMutableArray alloc] init];
+    storage.pendingHostCopies = [[NSMutableArray alloc] init];
+
+    AsyncRTMetalDeviceContext *context = calloc(1, sizeof(*context));
+    assert(context != NULL);
+    atomic_init(&context->base.reference_count, 1);
+    context->base.magic = ASYNCRT_APPLE_DEVICE_CONTEXT_MAGIC;
+    context->base.kind = ASYNCRT_APPLE_DEVICE_CONTEXT_METAL;
+    context->storage = (__bridge_retained void *)storage;
+    *result = context;
+    return NULL;
+  }
+}
+
+void AsyncRT_AppleMetalDeviceContext_destroy(void *untyped_context) {
+  @autoreleasepool {
+    AsyncRTMetalDeviceContext *context = untyped_context;
+    assert(context != NULL);
+    assert(context->base.magic == ASYNCRT_APPLE_DEVICE_CONTEXT_MAGIC);
+    assert(context->base.kind == ASYNCRT_APPLE_DEVICE_CONTEXT_METAL);
+    assert(atomic_load_explicit(&context->base.reference_count,
+                                memory_order_acquire) == 0);
+    const char *error = asyncrt_metal_synchronize_context(context);
+    assert(error == NULL &&
+           "destroying a Metal DeviceContext failed to synchronize");
+    context->base.magic = 0;
+    __unused AsyncRTMetalContextStorage *storage =
+        (__bridge_transfer AsyncRTMetalContextStorage *)context->storage;
+    context->storage = NULL;
+    free(context);
+  }
+}
+
+const char *AsyncRT_AppleMetalDeviceContext_synchronize(void *untyped_context) {
+  @autoreleasepool {
+    return asyncrt_metal_synchronize_context(
+        asyncrt_metal_context_from_untyped(untyped_context));
+  }
+}
+
+const char *AsyncRT_DeviceContext_createBuffer_async(void **result,
+                                                     void **device_ptr,
+                                                     void *untyped_context,
+                                                     size_t length,
+                                                     size_t element_size) {
+  @autoreleasepool {
+    if (result == NULL || device_ptr == NULL)
+      return asyncrt_metal_owned_error(
+          "DeviceContext buffer result pointers must not be null");
+    *result = NULL;
+    *device_ptr = NULL;
+    uint32_t context_kind = asyncrt_apple_context_kind(untyped_context);
+    if (context_kind == ASYNCRT_APPLE_DEVICE_CONTEXT_CPU)
+      return asyncrt_metal_owned_error(
+          "CPU DeviceContext buffers are not implemented by the Apple "
+          "accelerator runtime");
+    if (element_size != 0 && length > SIZE_MAX / element_size)
+      return asyncrt_metal_owned_error("DeviceContext buffer byte size overflows");
+    size_t byte_count = length * element_size;
+    if (byte_count > INT64_MAX)
+      return asyncrt_metal_owned_error(
+          "DeviceContext buffer exceeds AsyncRT limits");
+
+    assert(context_kind == ASYNCRT_APPLE_DEVICE_CONTEXT_METAL);
+    AsyncRTMetalDeviceContext *context =
+        asyncrt_metal_context_from_untyped(untyped_context);
+
+    AsyncRTMetalContextStorage *storage =
+        asyncrt_metal_context_storage(context);
+    NSUInteger allocation_size = byte_count == 0 ? 1 : byte_count;
+    id<MTLBuffer> metal_buffer =
+        [storage.device newBufferWithLength:allocation_size
+                                    options:MTLResourceStorageModeShared];
+    if (metal_buffer == nil)
+      return asyncrt_metal_owned_error("Metal buffer allocation failed");
+
+    AsyncRTMetalDeviceBuffer *buffer = calloc(1, sizeof(*buffer));
+    assert(buffer != NULL);
+    atomic_init(&buffer->reference_count, 1);
+    buffer->magic = ASYNCRT_APPLE_METAL_BUFFER_MAGIC;
+    buffer->kind = ASYNCRT_APPLE_BUFFER_METAL;
+    buffer->byte_count = byte_count;
+    buffer->storage = (__bridge_retained void *)metal_buffer;
+    *result = buffer;
+    *device_ptr = metal_buffer.contents;
+    return NULL;
+  }
+}
+
+void AsyncRT_DeviceBuffer_retain(void *untyped_buffer) {
+  AsyncRTMetalDeviceBuffer *buffer =
+      asyncrt_metal_buffer_from_untyped(untyped_buffer);
+  uint32_t previous_reference_count = atomic_fetch_add_explicit(
+      &buffer->reference_count, 1, memory_order_acq_rel);
+  assert(previous_reference_count > 0);
+  assert(previous_reference_count < UINT32_MAX);
+}
+
+void AsyncRT_DeviceBuffer_release(void *untyped_buffer) {
+  @autoreleasepool {
+    AsyncRTMetalDeviceBuffer *buffer =
+        asyncrt_metal_buffer_from_untyped(untyped_buffer);
+    uint32_t previous_reference_count = atomic_fetch_sub_explicit(
+        &buffer->reference_count, 1, memory_order_acq_rel);
+    assert(previous_reference_count > 0);
+    if (previous_reference_count != 1)
+      return;
+    buffer->magic = 0;
+    __unused id<MTLBuffer> metal_buffer =
+        (__bridge_transfer id<MTLBuffer>)buffer->storage;
+    buffer->storage = NULL;
+    free(buffer);
+  }
+}
+
+int64_t AsyncRT_DeviceBuffer_bytesize(void *untyped_buffer) {
+  AsyncRTMetalDeviceBuffer *buffer =
+      asyncrt_metal_buffer_from_untyped(untyped_buffer);
+  assert(buffer->byte_count <= INT64_MAX);
+  return (int64_t)buffer->byte_count;
+}
+
+const char *AsyncRT_DeviceContext_HtoD_async(void *untyped_context,
+                                             void *untyped_destination,
+                                             const void *source) {
+  @autoreleasepool {
+    uint32_t context_kind = asyncrt_apple_context_kind(untyped_context);
+    if (context_kind != ASYNCRT_APPLE_DEVICE_CONTEXT_METAL)
+      return asyncrt_metal_owned_error(
+          "host-to-device copy is not implemented for this DeviceContext");
+    AsyncRTMetalDeviceContext *context =
+        asyncrt_metal_context_from_untyped(untyped_context);
+    AsyncRTMetalDeviceBuffer *destination =
+        asyncrt_metal_buffer_from_untyped(untyped_destination);
+    if (source == NULL && destination->byte_count != 0)
+      return asyncrt_metal_owned_error("Metal host-to-device source is null");
+
+    AsyncRTMetalContextStorage *storage =
+        asyncrt_metal_context_storage(context);
+    @synchronized(storage) {
+      NSUInteger allocation_size =
+          destination->byte_count == 0 ? 1 : destination->byte_count;
+      id<MTLBuffer> staging_buffer =
+          [storage.device newBufferWithLength:allocation_size
+                                      options:MTLResourceStorageModeShared];
+      if (staging_buffer == nil)
+        return asyncrt_metal_owned_error(
+            "Metal host-to-device staging allocation failed");
+      if (destination->byte_count != 0)
+        memcpy(staging_buffer.contents, source, destination->byte_count);
+      id<MTLCommandBuffer> command_buffer =
+          asyncrt_metal_get_or_create_command_buffer(storage);
+      if (command_buffer == nil)
+        return asyncrt_metal_owned_error(
+            "Metal host-to-device copy could not create a command buffer");
+      id<MTLBlitCommandEncoder> encoder = [command_buffer blitCommandEncoder];
+      if (encoder == nil)
+        return asyncrt_metal_owned_error(
+            "Metal host-to-device copy could not create a blit encoder");
+      if (destination->byte_count != 0)
+        [encoder copyFromBuffer:staging_buffer
+                   sourceOffset:0
+                       toBuffer:asyncrt_metal_buffer_object(destination)
+              destinationOffset:0
+                           size:destination->byte_count];
+      [encoder endEncoding];
+      [storage.retainedResources addObject:staging_buffer];
+      [storage.retainedResources
+          addObject:asyncrt_metal_buffer_object(destination)];
+      return NULL;
+    }
+  }
+}
+
+const char *AsyncRT_DeviceContext_DtoH_async(void *untyped_context,
+                                             void *destination,
+                                             void *untyped_source) {
+  @autoreleasepool {
+    uint32_t context_kind = asyncrt_apple_context_kind(untyped_context);
+    if (context_kind != ASYNCRT_APPLE_DEVICE_CONTEXT_METAL)
+      return asyncrt_metal_owned_error(
+          "device-to-host copy is not implemented for this DeviceContext");
+    AsyncRTMetalDeviceContext *context =
+        asyncrt_metal_context_from_untyped(untyped_context);
+    AsyncRTMetalDeviceBuffer *source =
+        asyncrt_metal_buffer_from_untyped(untyped_source);
+    if (destination == NULL && source->byte_count != 0)
+      return asyncrt_metal_owned_error(
+          "Metal device-to-host destination is null");
+
+    AsyncRTMetalContextStorage *storage =
+        asyncrt_metal_context_storage(context);
+    @synchronized(storage) {
+      NSUInteger allocation_size =
+          source->byte_count == 0 ? 1 : source->byte_count;
+      id<MTLBuffer> staging_buffer =
+          [storage.device newBufferWithLength:allocation_size
+                                      options:MTLResourceStorageModeShared];
+      if (staging_buffer == nil)
+        return asyncrt_metal_owned_error(
+            "Metal device-to-host staging allocation failed");
+      id<MTLCommandBuffer> command_buffer =
+          asyncrt_metal_get_or_create_command_buffer(storage);
+      if (command_buffer == nil)
+        return asyncrt_metal_owned_error(
+            "Metal device-to-host copy could not create a command buffer");
+      id<MTLBlitCommandEncoder> encoder = [command_buffer blitCommandEncoder];
+      if (encoder == nil)
+        return asyncrt_metal_owned_error(
+            "Metal device-to-host copy could not create a blit encoder");
+      if (source->byte_count != 0)
+        [encoder copyFromBuffer:asyncrt_metal_buffer_object(source)
+                   sourceOffset:0
+                       toBuffer:staging_buffer
+              destinationOffset:0
+                           size:source->byte_count];
+      [encoder endEncoding];
+
+      AsyncRTMetalPendingHostCopy *pending_copy =
+          [[AsyncRTMetalPendingHostCopy alloc] init];
+      pending_copy.stagingBuffer = staging_buffer;
+      pending_copy.destination = destination;
+      pending_copy.length = source->byte_count;
+      [storage.pendingHostCopies addObject:pending_copy];
+      [storage.retainedResources addObject:asyncrt_metal_buffer_object(source)];
+      return NULL;
+    }
+  }
+}
+
+const char *AsyncRT_DeviceContext_loadFunction(
+    void **result, void *untyped_context, const char *module_name,
+    const char *function_name, const char *data, size_t data_length,
+    int32_t max_dynamic_shared_bytes, const char *debug_level,
+    int32_t optimization_level) {
+  @autoreleasepool {
+    (void)module_name;
+    (void)debug_level;
+    (void)optimization_level;
+    if (result == NULL)
+      return asyncrt_metal_owned_error("device function result is null");
+    *result = NULL;
+    uint32_t context_kind = asyncrt_apple_context_kind(untyped_context);
+    if (context_kind != ASYNCRT_APPLE_DEVICE_CONTEXT_METAL)
+      return asyncrt_metal_owned_error(
+          "device-function loading is not implemented for this DeviceContext");
+    if (function_name == NULL || data == NULL || data_length == 0)
+      return asyncrt_metal_owned_error(
+          "Metal function name and library data must not be empty");
+    AsyncRTMetalDeviceContext *context =
+        asyncrt_metal_context_from_untyped(untyped_context);
+    AsyncRTMetalContextStorage *storage =
+        asyncrt_metal_context_storage(context);
+    if (max_dynamic_shared_bytes > 0 &&
+        (NSUInteger)max_dynamic_shared_bytes >
+            storage.device.maxThreadgroupMemoryLength)
+      return asyncrt_metal_owned_error(
+          "Metal maximum dynamic threadgroup-memory request exceeds the "
+          "device limit");
+    void *library_bytes = malloc(data_length);
+    assert(library_bytes != NULL);
+    memcpy(library_bytes, data, data_length);
+    dispatch_data_t library_data = dispatch_data_create(
+        library_bytes, data_length,
+        dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0),
+        DISPATCH_DATA_DESTRUCTOR_FREE);
+    assert(library_data != nil);
+
+    NSError *library_error = nil;
+    id<MTLLibrary> library = [storage.device newLibraryWithData:library_data
+                                                          error:&library_error];
+    if (library == nil)
+      return asyncrt_metal_owned_nserror("Metal library loading failed",
+                                         library_error);
+    NSString *name = [NSString stringWithUTF8String:function_name];
+    if (name == nil)
+      return asyncrt_metal_owned_error(
+          "Metal function name is not valid UTF-8");
+    id<MTLFunction> metal_function = [library newFunctionWithName:name];
+    if (metal_function == nil) {
+      return asyncrt_metal_owned_error(
+          "Metal library does not contain the requested function");
+    }
+
+    NSError *pipeline_error = nil;
+    id<MTLComputePipelineState> pipeline =
+        [storage.device newComputePipelineStateWithFunction:metal_function
+                                                      error:&pipeline_error];
+    if (pipeline == nil)
+      return asyncrt_metal_owned_nserror(
+          "Metal compute pipeline creation failed", pipeline_error);
+
+    AsyncRTMetalDeviceFunction *function = calloc(1, sizeof(*function));
+    assert(function != NULL);
+    atomic_init(&function->reference_count, 1);
+    function->magic = ASYNCRT_APPLE_METAL_FUNCTION_MAGIC;
+    function->pipeline = (__bridge_retained void *)pipeline;
+    *result = function;
+    return NULL;
+  }
+}
+
+void AsyncRT_DeviceFunction_retain(void *untyped_function) {
+  AsyncRTMetalDeviceFunction *function =
+      asyncrt_metal_function_from_untyped(untyped_function);
+  uint32_t previous_reference_count = atomic_fetch_add_explicit(
+      &function->reference_count, 1, memory_order_acq_rel);
+  assert(previous_reference_count > 0);
+  assert(previous_reference_count < UINT32_MAX);
+}
+
+void AsyncRT_DeviceFunction_release(void *untyped_function) {
+  @autoreleasepool {
+    AsyncRTMetalDeviceFunction *function =
+        asyncrt_metal_function_from_untyped(untyped_function);
+    uint32_t previous_reference_count = atomic_fetch_sub_explicit(
+        &function->reference_count, 1, memory_order_acq_rel);
+    assert(previous_reference_count > 0);
+    if (previous_reference_count != 1)
+      return;
+    function->magic = 0;
+    __unused id<MTLComputePipelineState> pipeline =
+        (__bridge_transfer id<MTLComputePipelineState>)function->pipeline;
+    function->pipeline = NULL;
+    free(function);
+  }
+}
+
+const char *AsyncRT_DeviceFunction_copyToConstantMemory(
+    void *untyped_function, const void *name, size_t name_size,
+    const void *data, size_t data_size) {
+  @autoreleasepool {
+    (void)asyncrt_metal_function_from_untyped(untyped_function);
+    (void)name;
+    (void)name_size;
+    (void)data;
+    (void)data_size;
+    return asyncrt_metal_owned_error(
+        "Metal constant-memory mapping is not implemented");
+  }
+}
+
+const char *AsyncRT_DeviceContext_enqueueFunctionDirect(
+    void *untyped_context, void *untyped_function, uint32_t grid_x,
+    uint32_t grid_y, uint32_t grid_z, uint32_t block_x, uint32_t block_y,
+    uint32_t block_z, uint32_t shared_memory_bytes, const void *attributes,
+    uint32_t attribute_count, void *const *arguments, uint32_t argument_count,
+    const uint64_t *argument_sizes) {
+  @autoreleasepool {
+    uint32_t context_kind = asyncrt_apple_context_kind(untyped_context);
+    if (context_kind != ASYNCRT_APPLE_DEVICE_CONTEXT_METAL)
+      return asyncrt_metal_owned_error(
+          "raw kernel enqueue is not implemented for this DeviceContext");
+    AsyncRTMetalDeviceContext *context =
+        asyncrt_metal_context_from_untyped(untyped_context);
+    AsyncRTMetalDeviceFunction *function =
+        asyncrt_metal_function_from_untyped(untyped_function);
+    if (grid_x == 0 || grid_y == 0 || grid_z == 0 || block_x == 0 ||
+        block_y == 0 || block_z == 0)
+      return asyncrt_metal_owned_error(
+          "Metal launch dimensions must be nonzero");
+    const char *attribute_error =
+        asyncrt_metal_validate_launch_attributes(attributes, attribute_count);
+    if (attribute_error != NULL)
+      return attribute_error;
+    if (argument_sizes != NULL)
+      return asyncrt_metal_owned_error(
+          "Metal requires MetalEnqueueFunctionArgs, not direct argument sizes");
+    if (arguments == NULL)
+      return asyncrt_metal_owned_error("Metal launch arguments are null");
+
+    const AsyncRTMetalEnqueueFunctionArguments *metal_arguments = arguments[0];
+    if (metal_arguments == NULL)
+      return asyncrt_metal_owned_error(
+          "MetalEnqueueFunctionArgs is incomplete");
+    if (argument_count != 0 &&
+        (metal_arguments->arguments == NULL ||
+         metal_arguments->argument_sizes == NULL ||
+         metal_arguments->argument_is_device_pointer == NULL))
+      return asyncrt_metal_owned_error(
+          "MetalEnqueueFunctionArgs arrays are incomplete");
+    if (metal_arguments->buffer_count < 0 ||
+        (metal_arguments->buffer_count != 0 &&
+         metal_arguments->buffers == NULL))
+      return asyncrt_metal_owned_error(
+          "MetalEnqueueFunctionArgs buffer storage is incomplete");
+    if (metal_arguments->device_pointer_fixup_count < 0 ||
+        metal_arguments->device_pointer_fixup_count !=
+            metal_arguments->buffer_count ||
+        (metal_arguments->device_pointer_fixup_count != 0 &&
+         (metal_arguments->device_pointer_argument_indices == NULL ||
+          metal_arguments->device_pointer_byte_offsets == NULL)))
+      return asyncrt_metal_owned_error(
+          "MetalEnqueueFunctionArgs device-pointer fixups are incomplete");
+    for (int32_t fixup_index = 0;
+         fixup_index < metal_arguments->device_pointer_fixup_count;
+         ++fixup_index) {
+      int32_t argument_index =
+          metal_arguments->device_pointer_argument_indices[fixup_index];
+      if (argument_index < 0 || (uint32_t)argument_index >= argument_count)
+        return asyncrt_metal_owned_error(
+            "Metal device-pointer fixup has an invalid argument index");
+      uint64_t argument_size = metal_arguments->argument_sizes[argument_index];
+      uint64_t byte_offset =
+          metal_arguments->device_pointer_byte_offsets[fixup_index];
+      if (byte_offset > argument_size ||
+          argument_size - byte_offset < sizeof(void *))
+        return asyncrt_metal_owned_error(
+            "Metal device-pointer fixup exceeds its argument storage");
+    }
+    id<MTLComputePipelineState> pipeline =
+        asyncrt_metal_pipeline_object(function);
+    uint64_t threads_per_threadgroup =
+        (uint64_t)block_x * (uint64_t)block_y * (uint64_t)block_z;
+    if (threads_per_threadgroup > pipeline.maxTotalThreadsPerThreadgroup)
+      return asyncrt_metal_owned_error(
+          "Metal block dimensions exceed the compute pipeline limit");
+    uint64_t total_threadgroup_memory =
+        (uint64_t)pipeline.staticThreadgroupMemoryLength +
+        (uint64_t)shared_memory_bytes;
+    AsyncRTMetalContextStorage *storage =
+        asyncrt_metal_context_storage(context);
+    if (total_threadgroup_memory > storage.device.maxThreadgroupMemoryLength)
+      return asyncrt_metal_owned_error(
+          "Metal threadgroup memory exceeds the device limit");
+
+    @synchronized(storage) {
+      id<MTLCommandBuffer> command_buffer =
+          asyncrt_metal_get_or_create_command_buffer(storage);
+      if (command_buffer == nil)
+        return asyncrt_metal_owned_error(
+            "Metal launch could not create a command buffer");
+      id<MTLComputeCommandEncoder> encoder =
+          [command_buffer computeCommandEncoder];
+      if (encoder == nil)
+        return asyncrt_metal_owned_error(
+            "Metal launch could not create a compute encoder");
+      [encoder setComputePipelineState:pipeline];
+      [storage.retainedResources addObject:pipeline];
+
+      for (int32_t buffer_index = 0;
+           buffer_index < metal_arguments->buffer_count; ++buffer_index) {
+        AsyncRTMetalDeviceBuffer *buffer = asyncrt_metal_buffer_from_untyped(
+            metal_arguments->buffers[buffer_index]);
+        id<MTLBuffer> metal_buffer = asyncrt_metal_buffer_object(buffer);
+        [encoder useResource:metal_buffer
+                       usage:MTLResourceUsageRead | MTLResourceUsageWrite];
+        [storage.retainedResources addObject:metal_buffer];
+      }
+
+      for (uint32_t argument_index = 0; argument_index < argument_count;
+           ++argument_index) {
+        uint64_t argument_size =
+            metal_arguments->argument_sizes[argument_index];
+        const void *argument = metal_arguments->arguments[argument_index];
+        if (argument == NULL && argument_size != 0) {
+          [encoder endEncoding];
+          return asyncrt_metal_owned_error(
+              "Metal kernel argument storage is null");
+        }
+
+        if (metal_arguments->argument_is_device_pointer[argument_index]) {
+          if (argument_size != sizeof(void *)) {
+            [encoder endEncoding];
+            return asyncrt_metal_owned_error(
+                "Metal buffer kernel argument has an unexpected ABI size");
+          }
+          int32_t matching_fixup_index = -1;
+          for (int32_t fixup_index = 0;
+               fixup_index < metal_arguments->device_pointer_fixup_count;
+               ++fixup_index) {
+            if (metal_arguments
+                    ->device_pointer_argument_indices[fixup_index] !=
+                (int32_t)argument_index)
+              continue;
+            if (matching_fixup_index != -1 ||
+                metal_arguments->device_pointer_byte_offsets[fixup_index] !=
+                    0) {
+              [encoder endEncoding];
+              return asyncrt_metal_owned_error(
+                  "Metal buffer argument must have exactly one pointer "
+                  "fixup at byte zero");
+            }
+            matching_fixup_index = fixup_index;
+          }
+          if (matching_fixup_index == -1) {
+            [encoder endEncoding];
+            return asyncrt_metal_owned_error(
+                "Metal buffer kernel argument has no pointer fixup");
+          }
+          AsyncRTMetalDeviceBuffer *buffer =
+              asyncrt_metal_buffer_from_untyped(
+                  metal_arguments->buffers[matching_fixup_index]);
+          id<MTLBuffer> metal_buffer = asyncrt_metal_buffer_object(buffer);
+          uintptr_t encoded_address = 0;
+          memcpy(&encoded_address, argument, sizeof(encoded_address));
+          uintptr_t contents_address = (uintptr_t)metal_buffer.contents;
+          if (encoded_address < contents_address ||
+              encoded_address - contents_address > metal_buffer.length) {
+            [encoder endEncoding];
+            return asyncrt_metal_owned_error(
+                "Metal buffer argument points outside its buffer handle");
+          }
+          NSUInteger buffer_byte_offset =
+              (NSUInteger)(encoded_address - contents_address);
+          [encoder setBuffer:metal_buffer
+                      offset:buffer_byte_offset
+                     atIndex:argument_index];
+          continue;
+        }
+
+        if (argument_size > 4096) {
+          [encoder endEncoding];
+          return asyncrt_metal_owned_error(
+              "Metal inline constant kernel argument exceeds 4096 bytes");
+        }
+        uint8_t *patched_argument = NULL;
+        for (int32_t fixup_index = 0;
+             fixup_index < metal_arguments->device_pointer_fixup_count;
+             ++fixup_index) {
+          if (metal_arguments->device_pointer_argument_indices[fixup_index] !=
+              (int32_t)argument_index)
+            continue;
+          uintptr_t gpu_buffer_address = 0;
+          if (@available(iOS 16.0, macOS 13.0, *)) {
+            gpu_buffer_address = (uintptr_t)asyncrt_metal_buffer_object(
+                                     asyncrt_metal_buffer_from_untyped(
+                                         metal_arguments
+                                             ->buffers[fixup_index]))
+                                     .gpuAddress;
+          } else {
+            free(patched_argument);
+            [encoder endEncoding];
+            return asyncrt_metal_owned_error(
+                "Metal device pointers nested in kernel values require iOS "
+                "16 or macOS 13");
+          }
+          if (patched_argument == NULL) {
+            patched_argument = malloc((size_t)argument_size);
+            assert(patched_argument != NULL);
+            memcpy(patched_argument, argument, (size_t)argument_size);
+          }
+
+          uint64_t byte_offset =
+              metal_arguments->device_pointer_byte_offsets[fixup_index];
+          uintptr_t encoded_address = 0;
+          memcpy(&encoded_address, patched_argument + byte_offset,
+                 sizeof(encoded_address));
+          AsyncRTMetalDeviceBuffer *buffer =
+              asyncrt_metal_buffer_from_untyped(
+                  metal_arguments->buffers[fixup_index]);
+          id<MTLBuffer> metal_buffer = asyncrt_metal_buffer_object(buffer);
+          uintptr_t contents_address = (uintptr_t)metal_buffer.contents;
+          if (encoded_address < contents_address ||
+              encoded_address - contents_address > metal_buffer.length) {
+            free(patched_argument);
+            [encoder endEncoding];
+            return asyncrt_metal_owned_error(
+                "Metal nested device pointer points outside its buffer "
+                "handle");
+          }
+          uintptr_t gpu_address =
+              gpu_buffer_address + (encoded_address - contents_address);
+          memcpy(patched_argument + byte_offset, &gpu_address,
+                 sizeof(gpu_address));
+        }
+        [encoder setBytes:patched_argument == NULL ? argument : patched_argument
+                   length:(NSUInteger)argument_size
+                  atIndex:argument_index];
+        free(patched_argument);
+      }
+
+      if (shared_memory_bytes != 0)
+        [encoder setThreadgroupMemoryLength:shared_memory_bytes atIndex:0];
+
+      [encoder dispatchThreadgroups:MTLSizeMake(grid_x, grid_y, grid_z)
+              threadsPerThreadgroup:MTLSizeMake(block_x, block_y, block_z)];
+      [encoder endEncoding];
+      return NULL;
+    }
+  }
+}
