+/// Return the original value corresponding to a flattened operand index.
+/// Struct values produced by kgen.struct.create retain their source elements,
+/// which can carry compile-time information that is not recoverable from an
+/// LLVM extractvalue while dialect conversion is still in progress.
+static Value getExpandedSourceOperand(ValueRange args, size_t expandedIndex) {
+  for (Value value : args) {
+    auto structType = dyn_cast<StructType>(value.getType());
+    if (!structType) {
+      if (expandedIndex == 0)
+        return value;
+      --expandedIndex;
+      continue;
+    }
+
+    auto elementTypes = structType.getElementTypes();
+    if (!elementTypes)
+      return {};
+    if (expandedIndex >= elementTypes->size()) {
+      expandedIndex -= elementTypes->size();
+      continue;
+    }
+
+    auto structCreate = value.getDefiningOp<StructCreateOp>();
+    if (!structCreate)
+      return {};
+    assert(structCreate->getNumOperands() == elementTypes->size() &&
+           "kgen.struct.create must have one operand per logical field");
+    return structCreate->getOperand(expandedIndex);
+  }
+  return {};
+}
+
+/// Recover a constant attribute from either the converted value or its
+/// original source. During dialect conversion a packed struct element may
+/// temporarily appear as an extractvalue, even though the source element is a
+/// constant.
+static Attribute getConstantAttribute(Value convertedValue,
+                                      Value originalValue = {}) {
+  convertedValue = squashPointlessCasts(convertedValue);
+  if (auto constant = convertedValue.getDefiningOp<LLVM::ConstantOp>())
+    return constant.getValue();
+
+  if (!originalValue)
+    return {};
+  originalValue = squashPointlessCasts(originalValue);
+  if (auto cast = originalValue.getDefiningOp<CastFromBuiltinOp>())
+    originalValue = squashPointlessCasts(cast.getInput());
+  if (auto constant = originalValue.getDefiningOp<LLVM::ConstantOp>())
+    return constant.getValue();
+  return {};
+}
