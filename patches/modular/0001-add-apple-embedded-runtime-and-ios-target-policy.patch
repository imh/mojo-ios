+const char *AsyncRT_DeviceContext_loadFunction(
+    void **result, void *untyped_context, const char *module_name,
+    const char *function_name, const char *data, size_t data_length,
+    int32_t max_dynamic_shared_bytes, const char *debug_level,
+    int32_t optimization_level) {
+  @autoreleasepool {
+    (void)module_name;
+    (void)debug_level;
+    (void)optimization_level;
+    if (result == NULL)
+      return asyncrt_metal_owned_error("device function result is null");
+    *result = NULL;
+    uint32_t context_kind = asyncrt_apple_context_kind(untyped_context);
+    if (context_kind == ASYNCRT_APPLE_DEVICE_CONTEXT_COREAI)
+      return asyncrt_metal_owned_error(
+          "Core AI does not implement device-function compilation or loading");
+    if (context_kind != ASYNCRT_APPLE_DEVICE_CONTEXT_METAL)
+      return asyncrt_metal_owned_error(
+          "device-function loading is not implemented for this DeviceContext");
+    if (function_name == NULL || data == NULL || data_length == 0)
+      return asyncrt_metal_owned_error(
+          "Metal function name and library data must not be empty");
+    AsyncRTMetalDeviceContext *context =
+        asyncrt_metal_context_from_untyped(untyped_context);
+    AsyncRTMetalContextStorage *storage =
+        asyncrt_metal_context_storage(context);
+    if (max_dynamic_shared_bytes > 0 &&
+        (NSUInteger)max_dynamic_shared_bytes >
+            storage.device.maxThreadgroupMemoryLength)
+      return asyncrt_metal_owned_error(
+          "Metal maximum dynamic threadgroup-memory request exceeds the "
+          "device limit");
+    void *library_bytes = malloc(data_length);
+    assert(library_bytes != NULL);
+    memcpy(library_bytes, data, data_length);
+    dispatch_data_t library_data = dispatch_data_create(
+        library_bytes, data_length,
+        dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0),
+        DISPATCH_DATA_DESTRUCTOR_FREE);
+    assert(library_data != nil);
+
+    NSError *library_error = nil;
+    id<MTLLibrary> library = [storage.device newLibraryWithData:library_data
+                                                          error:&library_error];
+    if (library == nil)
+      return asyncrt_metal_owned_nserror("Metal library loading failed",
+                                         library_error);
+    NSString *name = [NSString stringWithUTF8String:function_name];
+    if (name == nil)
+      return asyncrt_metal_owned_error(
+          "Metal function name is not valid UTF-8");
+    id<MTLFunction> metal_function = [library newFunctionWithName:name];
+    if (metal_function == nil) {
+      return asyncrt_metal_owned_error(
+          "Metal library does not contain the requested function");
+    }
+
+    NSError *pipeline_error = nil;
+    id<MTLComputePipelineState> pipeline =
+        [storage.device newComputePipelineStateWithFunction:metal_function
+                                                      error:&pipeline_error];
+    if (pipeline == nil)
+      return asyncrt_metal_owned_nserror(
+          "Metal compute pipeline creation failed", pipeline_error);
+
+    AsyncRTMetalDeviceFunction *function = calloc(1, sizeof(*function));
+    assert(function != NULL);
+    atomic_init(&function->reference_count, 1);
+    function->magic = ASYNCRT_APPLE_METAL_FUNCTION_MAGIC;
+    function->pipeline = (__bridge_retained void *)pipeline;
+    *result = function;
+    return NULL;
+  }
+}
+
+void AsyncRT_DeviceFunction_retain(void *untyped_function) {
+  AsyncRTMetalDeviceFunction *function =
+      asyncrt_metal_function_from_untyped(untyped_function);
+  uint32_t previous_reference_count = atomic_fetch_add_explicit(
+      &function->reference_count, 1, memory_order_acq_rel);
+  assert(previous_reference_count > 0);
+  assert(previous_reference_count < UINT32_MAX);
+}
+
+void AsyncRT_DeviceFunction_release(void *untyped_function) {
+  @autoreleasepool {
+    AsyncRTMetalDeviceFunction *function =
+        asyncrt_metal_function_from_untyped(untyped_function);
+    uint32_t previous_reference_count = atomic_fetch_sub_explicit(
+        &function->reference_count, 1, memory_order_acq_rel);
+    assert(previous_reference_count > 0);
+    if (previous_reference_count != 1)
+      return;
+    function->magic = 0;
+    __unused id<MTLComputePipelineState> pipeline =
+        (__bridge_transfer id<MTLComputePipelineState>)function->pipeline;
+    function->pipeline = NULL;
+    free(function);
+  }
+}
