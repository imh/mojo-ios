+
+#include "AppleDeviceContextInternal.h"
+#include "AsyncRT/Runtime/DeviceContextCAPI.h"
+
+#import <Foundation/Foundation.h>
+#import <Metal/Metal.h>
+
+#include <assert.h>
+#include <limits.h>
+#include <stdatomic.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+enum {
+  ASYNCRT_APPLE_METAL_BUFFER_MAGIC = 0x4D544C42,
+  ASYNCRT_APPLE_METAL_FUNCTION_MAGIC = 0x4D544C46,
+  ASYNCRT_APPLE_BUFFER_METAL = 1,
+  ASYNCRT_APPLE_BUFFER_COREAI = 2,
+};
+
+@interface AsyncRTMetalPendingHostCopy : NSObject
+@property(nonatomic, strong) id<MTLBuffer> stagingBuffer;
+@property(nonatomic, assign) void *destination;
+@property(nonatomic, assign) size_t length;
+@end
+
+@implementation AsyncRTMetalPendingHostCopy
+@end
+
+@interface AsyncRTMetalContextStorage : NSObject
+@property(nonatomic, strong) id<MTLDevice> device;
+@property(nonatomic, strong) id<MTLCommandQueue> commandQueue;
+@property(nonatomic, strong) id<MTLCommandBuffer> commandBuffer;
+@property(nonatomic, strong) NSMutableArray<id> *retainedResources;
+@property(nonatomic, strong)
+    NSMutableArray<AsyncRTMetalPendingHostCopy *> *pendingHostCopies;
+@end
+
+@implementation AsyncRTMetalContextStorage
+@end
+
+typedef struct {
+  AsyncRTAppleDeviceContextBase base;
+  void *storage;
+} AsyncRTMetalDeviceContext;
+
+typedef struct {
+  _Atomic(uint32_t) reference_count;
+  uint32_t magic;
+  uint32_t kind;
+  size_t byte_count;
+  void *storage;
+} AsyncRTMetalDeviceBuffer;
+
+typedef struct {
+  _Atomic(uint32_t) reference_count;
+  uint32_t magic;
+  void *pipeline;
+} AsyncRTMetalDeviceFunction;
+
+// This must match max.gpu.host._device_context_metal.MetalEnqueueFunctionArgs.
+// Mojo's Optional[Pointer[...]] has the pointer representation used here.
+typedef struct {
+  void *const *arguments;
+  const uint64_t *argument_sizes;
+  const bool *argument_is_device_pointer;
+  AsyncRTMetalDeviceBuffer *const *buffers;
+  const int32_t *device_pointer_argument_indices;
+  const uint64_t *device_pointer_byte_offsets;
+  int32_t buffer_count;
+  int32_t device_pointer_fixup_count;
+} AsyncRTMetalEnqueueFunctionArguments;
+
+// This must match max.gpu.host.LaunchAttribute.  Launch attributes are a
+// CUDA-shaped API; Metal accepts IGNORE entries and diagnoses every concrete
+// CUDA attribute by name rather than silently discarding it.
+typedef struct {
+  int32_t identifier;
+  uint8_t padding[4];
+  uint8_t value[64];
+} AsyncRTMetalLaunchAttribute;
+
+_Static_assert(sizeof(AsyncRTMetalLaunchAttribute) == 72,
+               "Metal launch-attribute ABI drifted from Mojo");
+
+static const char *asyncrt_metal_owned_error(const char *message) {
+  assert(message != NULL);
+  char *owned_message = strdup(message);
+  assert(owned_message != NULL);
+  return owned_message;
+}
+
+static const char *asyncrt_metal_owned_nserror(const char *operation,
+                                               NSError *error) {
+  assert(operation != NULL);
+  const char *detail = error == nil ? "no diagnostic was provided"
+                                    : error.localizedDescription.UTF8String;
+  if (detail == NULL)
+    detail = "the diagnostic was not valid UTF-8";
+  size_t operation_length = strlen(operation);
+  size_t detail_length = strlen(detail);
+  assert(operation_length <= SIZE_MAX - detail_length - 3);
+  char *message = malloc(operation_length + detail_length + 3);
+  assert(message != NULL);
+  memcpy(message, operation, operation_length);
+  memcpy(message + operation_length, ": ", 2);
+  memcpy(message + operation_length + 2, detail, detail_length + 1);
+  return message;
+}
+
+static const char *
+asyncrt_metal_validate_launch_attributes(const void *untyped_attributes,
+                                         uint32_t attribute_count) {
+  if (attribute_count == 0)
+    return NULL;
+  if (untyped_attributes == NULL)
+    return asyncrt_metal_owned_error("Metal launch attributes pointer is null");
+
+  const AsyncRTMetalLaunchAttribute *attributes = untyped_attributes;
+  for (uint32_t index = 0; index < attribute_count; ++index) {
+    switch (attributes[index].identifier) {
+    case 0: // IGNORE
+      break;
+    case 1:
+      return asyncrt_metal_owned_error(
+          "Metal launch attribute ACCESS_POLICY_WINDOW is CUDA-only");
+    case 2:
+      return asyncrt_metal_owned_error(
+          "Metal launch attribute COOPERATIVE is CUDA-only");
+    case 3:
+      return asyncrt_metal_owned_error(
+          "Metal launch attribute SYNCHRONIZATION_POLICY is CUDA-only");
+    case 4:
+      return asyncrt_metal_owned_error(
+          "Metal launch attribute CLUSTER_DIMENSION is CUDA-only");
+    case 5:
+      return asyncrt_metal_owned_error(
+          "Metal launch attribute CLUSTER_SCHEDULING_POLICY_PREFERENCE is "
+          "CUDA-only");
+    case 6:
+      return asyncrt_metal_owned_error(
+          "Metal launch attribute PROGRAMMATIC_STREAM_SERIALIZATION is "
+          "CUDA-only");
+    case 7:
+      return asyncrt_metal_owned_error(
+          "Metal launch attribute PROGRAMMATIC_EVENT is CUDA-only");
+    case 8:
+      return asyncrt_metal_owned_error(
+          "Metal launch attribute PRIORITY is CUDA-only");
+    case 9:
+      return asyncrt_metal_owned_error(
+          "Metal launch attribute MEM_SYNC_DOMAIN_MAP is CUDA-only");
+    case 10:
+      return asyncrt_metal_owned_error(
+          "Metal launch attribute MEM_SYNC_DOMAIN is CUDA-only");
+    case 12:
+      return asyncrt_metal_owned_error(
+          "Metal launch attribute LAUNCH_COMPLETION_EVENT is CUDA-only");
+    case 13:
+      return asyncrt_metal_owned_error(
+          "Metal launch attribute DEVICE_UPDATABLE_KERNEL_NODE is CUDA-only");
+    case 14:
+      return asyncrt_metal_owned_error(
+          "Metal launch attribute PREFERRED_SHARED_MEMORY_CARVEOUT is "
+          "CUDA-only");
+    case 11:
+    default:
+      return asyncrt_metal_owned_error(
+          "Metal received an unknown launch attribute identifier");
+    }
+  }
+  return NULL;
+}
+
+static AsyncRTMetalDeviceContext *
+asyncrt_metal_context_from_untyped(void *untyped_context) {
+  AsyncRTMetalDeviceContext *context = untyped_context;
+  assert(context != NULL);
+  assert(context->base.magic == ASYNCRT_APPLE_DEVICE_CONTEXT_MAGIC);
+  assert(context->base.kind == ASYNCRT_APPLE_DEVICE_CONTEXT_METAL);
+  assert(atomic_load_explicit(&context->base.reference_count,
+                              memory_order_acquire) > 0);
+  assert(context->storage != NULL);
+  return context;
+}
+
+static AsyncRTMetalContextStorage *
+asyncrt_metal_context_storage(AsyncRTMetalDeviceContext *context) {
+  assert(context != NULL);
+  assert(context->storage != NULL);
+  return (__bridge AsyncRTMetalContextStorage *)context->storage;
+}
+
+static AsyncRTMetalDeviceBuffer *
+asyncrt_metal_buffer_from_untyped(void *untyped_buffer) {
+  AsyncRTMetalDeviceBuffer *buffer = untyped_buffer;
+  assert(buffer != NULL);
+  assert(buffer->magic == ASYNCRT_APPLE_METAL_BUFFER_MAGIC);
+  assert(atomic_load_explicit(&buffer->reference_count, memory_order_acquire) >
+         0);
+  assert(buffer->kind == ASYNCRT_APPLE_BUFFER_METAL ||
+         buffer->kind == ASYNCRT_APPLE_BUFFER_COREAI);
+  assert(buffer->storage != NULL);
+  return buffer;
+}
+
+static id<MTLBuffer>
+asyncrt_metal_buffer_object(AsyncRTMetalDeviceBuffer *buffer) {
+  assert(buffer->kind == ASYNCRT_APPLE_BUFFER_METAL);
+  return (__bridge id<MTLBuffer>)buffer->storage;
+}
+
+static uint32_t asyncrt_apple_context_kind(void *untyped_context) {
+  AsyncRTAppleDeviceContextBase *context = untyped_context;
+  assert(context != NULL);
+  assert(context->magic == ASYNCRT_APPLE_DEVICE_CONTEXT_MAGIC);
+  assert(context->kind == ASYNCRT_APPLE_DEVICE_CONTEXT_CPU ||
+         context->kind == ASYNCRT_APPLE_DEVICE_CONTEXT_METAL ||
+         context->kind == ASYNCRT_APPLE_DEVICE_CONTEXT_COREAI);
+  assert(atomic_load_explicit(&context->reference_count, memory_order_acquire) >
+         0);
+  return context->kind;
+}
+
+static AsyncRTMetalDeviceFunction *
+asyncrt_metal_function_from_untyped(void *untyped_function) {
+  AsyncRTMetalDeviceFunction *function = untyped_function;
+  assert(function != NULL);
+  assert(function->magic == ASYNCRT_APPLE_METAL_FUNCTION_MAGIC);
+  assert(atomic_load_explicit(&function->reference_count,
+                              memory_order_acquire) > 0);
+  assert(function->pipeline != NULL);
+  return function;
+}
+
+static id<MTLComputePipelineState>
+asyncrt_metal_pipeline_object(AsyncRTMetalDeviceFunction *function) {
+  return (__bridge id<MTLComputePipelineState>)function->pipeline;
+}
+
+static id<MTLCommandBuffer> asyncrt_metal_get_or_create_command_buffer(
+    AsyncRTMetalContextStorage *storage) {
+  assert(storage != nil);
+  if (storage.commandBuffer == nil)
+    storage.commandBuffer = [storage.commandQueue commandBuffer];
+  return storage.commandBuffer;
+}
+
+static const char *
+asyncrt_metal_synchronize_context(AsyncRTMetalDeviceContext *context) {
+  assert(context != NULL);
+  AsyncRTMetalContextStorage *storage = asyncrt_metal_context_storage(context);
+  @synchronized(storage) {
+    id<MTLCommandBuffer> command_buffer = storage.commandBuffer;
+    if (command_buffer == nil) {
+      assert(storage.pendingHostCopies.count == 0);
+      assert(storage.retainedResources.count == 0);
+      return NULL;
+    }
+
+    storage.commandBuffer = nil;
+    [command_buffer commit];
+    [command_buffer waitUntilCompleted];
+    if (command_buffer.status == MTLCommandBufferStatusError) {
+      [storage.pendingHostCopies removeAllObjects];
+      [storage.retainedResources removeAllObjects];
+      return asyncrt_metal_owned_nserror("Metal command buffer failed",
+                                         command_buffer.error);
+    }
+
+    for (AsyncRTMetalPendingHostCopy *pending_copy in storage
+             .pendingHostCopies) {
+      assert(pending_copy.destination != NULL || pending_copy.length == 0);
+      assert(pending_copy.stagingBuffer.length >= pending_copy.length);
+      if (pending_copy.length != 0)
+        memcpy(pending_copy.destination, pending_copy.stagingBuffer.contents,
+               pending_copy.length);
+    }
+    [storage.pendingHostCopies removeAllObjects];
+    [storage.retainedResources removeAllObjects];
+    return NULL;
+  }
+}
