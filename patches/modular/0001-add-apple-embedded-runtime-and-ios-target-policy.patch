+#ifndef KGEN_COMPILER_LLVMIR_TRANSFORMS_METALAIRPASS_H
+#define KGEN_COMPILER_LLVMIR_TRANSFORMS_METALAIRPASS_H
+
+#include "llvm/IR/PassManager.h"
+
+namespace M::KGEN {
+
+/// Removes host-codegen attributes before the generic LLVM optimization
+/// pipeline sees an AIR module. AIR feature strings describe the Metal
+/// language and must never be interpreted as AArch64 CPU features.
+class PrepareMetalAIRPass : public llvm::PassInfoMixin<PrepareMetalAIRPass> {
+public:
+  llvm::PreservedAnalyses run(llvm::Module &module,
+                              llvm::ModuleAnalysisManager &analysisManager);
+};
+
+/// Legalizes an LLVM module to the documented shape of Apple AIR bitcode.
+///
+/// The initial implementation intentionally supports only pointer-buffer
+/// kernel arguments and the three X-dimension builtins needed by
+/// `std.gpu.global_idx.x`. Unsupported kernel signatures fail verification
+/// instead of being encoded with guessed ABI metadata.
+class MetalAIRPass : public llvm::PassInfoMixin<MetalAIRPass> {
+public:
+  llvm::PreservedAnalyses run(llvm::Module &module,
+                              llvm::ModuleAnalysisManager &analysisManager);
+};
+
+} // namespace M::KGEN
+
+#endif // KGEN_COMPILER_LLVMIR_TRANSFORMS_METALAIRPASS_H
