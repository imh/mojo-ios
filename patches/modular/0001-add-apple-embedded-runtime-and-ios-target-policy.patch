@@ -0,0 +1,43 @@
+//===----------------------------------------------------------------------===//
+// Copyright (c) 2026, Modular Inc. All rights reserved.
+//
+// Licensed under the Apache License v2.0 with LLVM Exceptions:
+// https://llvm.org/LICENSE.txt
+//===----------------------------------------------------------------------===//
+
+#ifndef ASYNCRT_RUNTIME_APPLE_DEVICE_CONTEXT_INTERNAL_H
+#define ASYNCRT_RUNTIME_APPLE_DEVICE_CONTEXT_INTERNAL_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+#include <atomic>
+#define ASYNCRT_APPLE_ATOMIC(type) std::atomic<type>
+#else
+#include <stdatomic.h>
+#define ASYNCRT_APPLE_ATOMIC(type) _Atomic(type)
+#endif
+
+enum {
+  ASYNCRT_APPLE_DEVICE_CONTEXT_MAGIC = 0x41535254,
+  ASYNCRT_APPLE_DEVICE_CONTEXT_CPU = 1,
+  ASYNCRT_APPLE_DEVICE_CONTEXT_METAL = 2,
+  ASYNCRT_APPLE_DEVICE_CONTEXT_COREAI = 3,
+};
+
+typedef struct {
+  ASYNCRT_APPLE_ATOMIC(uint32_t) reference_count;
+  uint32_t magic;
+  uint32_t kind;
+} AsyncRTAppleDeviceContextBase;
+
+#if defined(ASYNCRT_ENABLE_METAL) && ASYNCRT_ENABLE_METAL
+const char *AsyncRT_AppleMetalDeviceContext_create(void **result,
+                                                   int32_t device_id);
+void AsyncRT_AppleMetalDeviceContext_destroy(void *context);
+const char *AsyncRT_AppleMetalDeviceContext_synchronize(void *context);
+#endif
+
+#undef ASYNCRT_APPLE_ATOMIC
+
+#endif // ASYNCRT_RUNTIME_APPLE_DEVICE_CONTEXT_INTERNAL_H
diff --git a/AsyncRT/lib/Runtime/Apple/AppleWorkQueue.c b/AsyncRT/lib/Runtime/Apple/AppleWorkQueue.c
new file mode 100644
index 0000000000..68ff88fdc7
--- /dev/null
+++ b/AsyncRT/lib/Runtime/Apple/AppleWorkQueue.c
@@ -0,0 +1,164 @@
+//===----------------------------------------------------------------------===//
+// Copyright (c) 2026, Modular Inc. All rights reserved.
+//
+// Licensed under the Apache License v2.0 with LLVM Exceptions:
+// https://llvm.org/LICENSE.txt
+//===----------------------------------------------------------------------===//
+
+#include "AppleWorkQueue.h"
+
+#include <assert.h>
+#include <dispatch/dispatch.h>
+#include <pthread.h>
+#include <sched.h>
+#include <stdatomic.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <time.h>
+
+typedef struct {
+  AsyncRTAppleWorkFunction work_function;
+  void *context;
+} AsyncRTAppleWorkItem;
+
+static pthread_once_t asyncrt_apple_work_queue_once = PTHREAD_ONCE_INIT;
+static dispatch_queue_t asyncrt_apple_work_queue;
+static _Atomic(uint32_t) asyncrt_apple_active_task_count;
+static _Atomic(uint32_t) asyncrt_apple_peak_task_count;
+
+#if defined(ASYNCRT_ENABLE_TESTING) && ASYNCRT_ENABLE_TESTING
+static _Atomic(bool) asyncrt_apple_two_task_rendezvous_enabled;
+static _Atomic(uint32_t) asyncrt_apple_two_task_rendezvous_count;
+#endif
+
+static void asyncrt_apple_work_queue_initialize_once(void) {
+  asyncrt_apple_work_queue = dispatch_queue_create(
+      "org.modular.asyncrt.apple.cpu", DISPATCH_QUEUE_CONCURRENT);
+  assert(asyncrt_apple_work_queue != NULL);
+}
+
+static dispatch_queue_t asyncrt_apple_work_queue_get_or_create(void) {
+  int once_result = pthread_once(&asyncrt_apple_work_queue_once,
+                                 asyncrt_apple_work_queue_initialize_once);
+  assert(once_result == 0);
+  assert(asyncrt_apple_work_queue != NULL);
+  return asyncrt_apple_work_queue;
+}
+
+static void asyncrt_apple_record_task_start(void) {
+  uint32_t active_task_count =
+      atomic_fetch_add_explicit(&asyncrt_apple_active_task_count, 1,
+                                memory_order_acq_rel) +
+      1;
+  uint32_t peak_task_count = atomic_load_explicit(
+      &asyncrt_apple_peak_task_count, memory_order_acquire);
+  while (peak_task_count < active_task_count &&
+         !atomic_compare_exchange_weak_explicit(
+             &asyncrt_apple_peak_task_count, &peak_task_count,
+             active_task_count, memory_order_acq_rel, memory_order_acquire)) {
+  }
+}
+
+#if defined(ASYNCRT_ENABLE_TESTING) && ASYNCRT_ENABLE_TESTING
+static void asyncrt_apple_wait_for_idle_for_testing(void) {
+  struct timespec start_time;
+  int start_time_result = clock_gettime(CLOCK_MONOTONIC, &start_time);
+  assert(start_time_result == 0);
+  while (atomic_load_explicit(&asyncrt_apple_active_task_count,
+                              memory_order_acquire) != 0) {
+    struct timespec current_time;
+    int current_time_result = clock_gettime(CLOCK_MONOTONIC, &current_time);
+    assert(current_time_result == 0);
+    int64_t elapsed_seconds = current_time.tv_sec - start_time.tv_sec;
+    assert(elapsed_seconds < 5 &&
+           "the embedded Apple executor did not become idle");
+    sched_yield();
+  }
+}
+
+static void asyncrt_apple_two_task_rendezvous_if_enabled(void) {
+  if (!atomic_load_explicit(&asyncrt_apple_two_task_rendezvous_enabled,
+                            memory_order_acquire))
+    return;
+
+  uint32_t rendezvous_index =
+      atomic_fetch_add_explicit(&asyncrt_apple_two_task_rendezvous_count, 1,
+                                memory_order_acq_rel) +
+      1;
+  if (rendezvous_index > 2)
+    return;
+
+  struct timespec start_time;
+  int start_time_result = clock_gettime(CLOCK_MONOTONIC, &start_time);
+  assert(start_time_result == 0);
+  while (atomic_load_explicit(&asyncrt_apple_two_task_rendezvous_count,
+                              memory_order_acquire) < 2) {
+    struct timespec current_time;
+    int current_time_result = clock_gettime(CLOCK_MONOTONIC, &current_time);
+    assert(current_time_result == 0);
+    int64_t elapsed_seconds = current_time.tv_sec - start_time.tv_sec;
+    assert(elapsed_seconds < 5 &&
+           "the embedded Apple executor did not run two tasks concurrently");
+    sched_yield();
+  }
+
+  if (rendezvous_index == 2)
+    atomic_store_explicit(&asyncrt_apple_two_task_rendezvous_enabled, false,
+                          memory_order_release);
+}
+#endif
+
+static void asyncrt_apple_work_item_execute(void *untyped_work_item) {
+  AsyncRTAppleWorkItem *work_item = untyped_work_item;
+  assert(work_item != NULL);
+  assert(work_item->work_function != NULL);
+
+  asyncrt_apple_record_task_start();
+#if defined(ASYNCRT_ENABLE_TESTING) && ASYNCRT_ENABLE_TESTING
+  asyncrt_apple_two_task_rendezvous_if_enabled();
+#endif
+  work_item->work_function(work_item->context);
+  uint32_t previous_active_task_count = atomic_fetch_sub_explicit(
+      &asyncrt_apple_active_task_count, 1, memory_order_acq_rel);
+  assert(previous_active_task_count > 0);
+  free(work_item);
+}
+
+void AsyncRT_AppleWorkQueue_submit(AsyncRTAppleWorkFunction work_function,
+                                   void *context) {
+  assert(work_function != NULL);
+  AsyncRTAppleWorkItem *work_item = malloc(sizeof(*work_item));
+  assert(work_item != NULL);
+  work_item->work_function = work_function;
+  work_item->context = context;
+  dispatch_async_f(asyncrt_apple_work_queue_get_or_create(), work_item,
+                   asyncrt_apple_work_item_execute);
+}
+
+#if defined(ASYNCRT_ENABLE_TESTING) && ASYNCRT_ENABLE_TESTING
+void AsyncRT_Test_resetTaskMetrics(void) {
+  asyncrt_apple_wait_for_idle_for_testing();
+  atomic_store_explicit(&asyncrt_apple_peak_task_count, 0,
+                        memory_order_release);
+}
+
+uint32_t AsyncRT_Test_activeTaskCount(void) {
+  return atomic_load_explicit(&asyncrt_apple_active_task_count,
+                              memory_order_acquire);
+}
+
+uint32_t AsyncRT_Test_peakTaskCount(void) {
+  return atomic_load_explicit(&asyncrt_apple_peak_task_count,
+                              memory_order_acquire);
+}
+
+void AsyncRT_Test_enableTwoTaskRendezvous(void) {
+  assert(atomic_load_explicit(&asyncrt_apple_active_task_count,
+                              memory_order_acquire) == 0);
+  atomic_store_explicit(&asyncrt_apple_two_task_rendezvous_count, 0,
+                        memory_order_release);
+  atomic_store_explicit(&asyncrt_apple_two_task_rendezvous_enabled, true,
+                        memory_order_release);
+}
+#endif
