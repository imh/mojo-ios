new file mode 100644
index 0000000000..b8c1b4a422
--- /dev/null
+++ b/KGEN/lib/KGENToLLVM/Target/Metal/MetalLowering.cpp
@@ -0,0 +1,147 @@
+//===----------------------------------------------------------------------===//
+// Copyright (c) 2026, Modular Inc. All rights reserved.
+//
+// Licensed under the Apache License v2.0 with LLVM Exceptions:
+// https://llvm.org/LICENSE.txt
+//===----------------------------------------------------------------------===//
+
+#include "Target/Metal/MetalTraits.h"
+#include "Target/TargetLowering.h"
+
+#include "mlir/Dialect/LLVMIR/LLVMDialect.h"
+#include "mlir/IR/Builders.h"
+#include "mlir/IR/SymbolTable.h"
+#include "mlir/Pass/Pass.h"
+#include "mlir/Pass/PassManager.h"
+
+namespace M::KGEN {
+namespace {
+
+constexpr llvm::StringLiteral kMetalKernelAttribute = "metal.kernel";
+
+/// Apple's AIR builtins use LLVM-style names, but they are not registered
+/// upstream LLVM intrinsics. Keeping them as llvm.call_intrinsic operations
+/// makes MLIR's LLVM translator reject them before the Metal backend can run.
+/// Materialize ordinary external declarations and calls instead; the AIR
+/// consumer recognizes the symbol names.
+class LowerMetalAIRIntrinsicsPass final
+    : public mlir::PassWrapper<LowerMetalAIRIntrinsicsPass,
+                               mlir::OperationPass<mlir::ModuleOp>> {
+public:
+  MLIR_DEFINE_EXPLICIT_INTERNAL_INLINE_TYPE_ID(LowerMetalAIRIntrinsicsPass)
+
+  void runOnOperation() override {
+    mlir::ModuleOp module = getOperation();
+    llvm::SmallVector<mlir::LLVM::CallIntrinsicOp> airCalls;
+    module.walk([&](mlir::LLVM::CallIntrinsicOp call) {
+      if (call.getIntrin().starts_with("llvm.air."))
+        airCalls.push_back(call);
+    });
+
+    mlir::SymbolTable symbols(module);
+    mlir::IRRewriter rewriter(module.getContext());
+    for (mlir::LLVM::CallIntrinsicOp intrinsic : airCalls) {
+      if (!intrinsic.getOpBundleSizes().empty()) {
+        intrinsic.emitError(
+            "Metal AIR intrinsics with operand bundles are not implemented");
+        signalPassFailure();
+        return;
+      }
+      if (intrinsic.getNumResults() > 1) {
+        intrinsic.emitError(
+            "Metal AIR intrinsics with multiple results are not implemented");
+        signalPassFailure();
+        return;
+      }
+
+      mlir::Type resultType =
+          intrinsic.getNumResults() == 0
+              ? mlir::LLVM::LLVMVoidType::get(module.getContext())
+              : intrinsic.getResult(0).getType();
+      llvm::SmallVector<mlir::Type> argumentTypes =
+          llvm::to_vector(intrinsic.getArgs().getTypes());
+      auto functionType = mlir::LLVM::LLVMFunctionType::get(
+          resultType, argumentTypes, /*isVarArg=*/false);
+
+      // MLIR spells these as LLVM intrinsics so they survive the generic
+      // lowering pipeline.  AIR's actual callable ABI drops the `llvm.`
+      // prefix (`air.wg.barrier`, `air.sqrt`, and so on).  Index builtins use
+      // the same spelling here and are subsequently converted to kernel
+      // arguments by MetalAIRPass.
+      llvm::StringRef intrinsicName = intrinsic.getIntrin();
+      assert(intrinsicName.starts_with("llvm.air.") &&
+             "the Metal intrinsic collector admitted a non-AIR intrinsic");
+      llvm::StringRef airFunctionName = intrinsicName.drop_front(5);
+
+      mlir::LLVM::LLVMFuncOp declaration =
+          symbols.lookup<mlir::LLVM::LLVMFuncOp>(airFunctionName);
+      if (declaration && declaration.getFunctionType() != functionType) {
+        intrinsic.emitError("inconsistent signature for Metal AIR intrinsic '")
+            << airFunctionName << "'";
+        signalPassFailure();
+        return;
+      }
+      if (!declaration) {
+        mlir::OpBuilder::InsertionGuard guard(rewriter);
+        rewriter.setInsertionPointToStart(module.getBody());
+        declaration = mlir::LLVM::LLVMFuncOp::create(
+            rewriter, mlir::UnknownLoc::get(module.getContext()),
+            airFunctionName, functionType);
+        symbols.insert(declaration);
+      }
+
+      rewriter.setInsertionPoint(intrinsic);
+      auto call = mlir::LLVM::CallOp::create(rewriter, intrinsic.getLoc(),
+                                             declaration, intrinsic.getArgs());
+      rewriter.replaceOp(intrinsic, call.getResults());
+    }
+  }
+};
+
+static bool hasMetalKernelAttribute(mlir::LLVM::LLVMFuncOp function) {
+  for (mlir::Attribute attribute : function.getPassthroughAttr()) {
+    if (auto name = mlir::dyn_cast<mlir::StringAttr>(attribute))
+      if (name.getValue() == kMetalKernelAttribute)
+        return true;
+  }
+  return false;
+}
+
+class MetalLowering final : public TargetLowering {
+public:
+  const TargetTraits *traits() const override { return &MetalTraits::get(); }
+
+  void markExportedKernel(mlir::Operation *operation) const override {
+    auto function = mlir::cast<mlir::LLVM::LLVMFuncOp>(operation);
+    if (hasMetalKernelAttribute(function))
+      return;
+
+    mlir::Builder builder(function.getContext());
+    llvm::SmallVector<mlir::Attribute> attributes =
+        llvm::to_vector(function.getPassthroughAttr());
+    attributes.push_back(builder.getStringAttr(kMetalKernelAttribute));
+    function.setPassthroughAttr(builder.getArrayAttr(attributes));
+  }
+
+  bool isExportedKernel(mlir::Operation *operation) const override {
+    auto function = mlir::dyn_cast<mlir::LLVM::LLVMFuncOp>(operation);
+    return function && hasMetalKernelAttribute(function);
+  }
+
+  llvm::StringRef getKernelByValArgAttrName() const override { return "byval"; }
+
+  void addPostLowerToLLVMPasses(mlir::OpPassManager &manager) const override {
+    manager.addPass(std::make_unique<LowerMetalAIRIntrinsicsPass>());
+  }
+
+protected:
+  bool isBaseTarget() const override { return false; }
+};
+
+#pragma GCC diagnostic push
+#pragma GCC diagnostic ignored "-Wglobal-constructors"
+RegisterTargetLowering<MetalLowering> registerMetalLowering;
+#pragma GCC diagnostic pop
+
+} // namespace
+} // namespace M::KGEN
