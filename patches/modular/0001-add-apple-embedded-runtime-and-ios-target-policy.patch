+const char *AsyncRT_AppleMetalDeviceContext_create(void **result,
+                                                   int32_t device_id) {
+  @autoreleasepool {
+    if (result == NULL)
+      return asyncrt_metal_owned_error("Metal DeviceContext result is null");
+    *result = NULL;
+    if (device_id != 0)
+      return asyncrt_metal_owned_error(
+          "the embedded Apple Metal DeviceContext supports only device 0");
+
+    id<MTLDevice> device = MTLCreateSystemDefaultDevice();
+    if (device == nil)
+      return asyncrt_metal_owned_error("Metal device 0 is unavailable");
+    id<MTLCommandQueue> command_queue = [device newCommandQueue];
+    if (command_queue == nil)
+      return asyncrt_metal_owned_error(
+          "Metal device 0 could not create a command queue");
+
+    AsyncRTMetalContextStorage *storage =
+        [[AsyncRTMetalContextStorage alloc] init];
+    storage.device = device;
+    storage.commandQueue = command_queue;
+    storage.retainedResources = [[NSMutableArray alloc] init];
+    storage.pendingHostCopies = [[NSMutableArray alloc] init];
+
+    AsyncRTMetalDeviceContext *context = calloc(1, sizeof(*context));
+    assert(context != NULL);
+    atomic_init(&context->base.reference_count, 1);
+    context->base.magic = ASYNCRT_APPLE_DEVICE_CONTEXT_MAGIC;
+    context->base.kind = ASYNCRT_APPLE_DEVICE_CONTEXT_METAL;
+    context->storage = (__bridge_retained void *)storage;
+    *result = context;
+    return NULL;
+  }
+}
+
+void AsyncRT_AppleMetalDeviceContext_destroy(void *untyped_context) {
+  @autoreleasepool {
+    AsyncRTMetalDeviceContext *context = untyped_context;
+    assert(context != NULL);
+    assert(context->base.magic == ASYNCRT_APPLE_DEVICE_CONTEXT_MAGIC);
+    assert(context->base.kind == ASYNCRT_APPLE_DEVICE_CONTEXT_METAL);
+    assert(atomic_load_explicit(&context->base.reference_count,
+                                memory_order_acquire) == 0);
+    const char *error = asyncrt_metal_synchronize_context(context);
+    assert(error == NULL &&
+           "destroying a Metal DeviceContext failed to synchronize");
+    context->base.magic = 0;
+    __unused AsyncRTMetalContextStorage *storage =
+        (__bridge_transfer AsyncRTMetalContextStorage *)context->storage;
+    context->storage = NULL;
+    free(context);
+  }
+}
+
+const char *AsyncRT_AppleMetalDeviceContext_synchronize(void *untyped_context) {
+  @autoreleasepool {
+    return asyncrt_metal_synchronize_context(
+        asyncrt_metal_context_from_untyped(untyped_context));
+  }
+}
