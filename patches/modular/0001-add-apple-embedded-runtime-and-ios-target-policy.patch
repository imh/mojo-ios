+; O0-NOT: define internal i32 @builtin_helper
+; O0-NOT: call i32 @air.thread_position_in_threadgroup.x
+; O0: define void @builtin_kernel(ptr addrspace(1){{.*}} %output, <3 x i32> %thread_position_in_threadgroup_idx)
+; O0: extractelement <3 x i32> %thread_position_in_threadgroup_idx, i32 0
+
+; O3-NOT: define internal i32 @helper
