@@ -0,0 +1,559 @@
+//===----------------------------------------------------------------------===//
+// Copyright (c) 2026, Modular Inc. All rights reserved.
+//
+// Licensed under the Apache License v2.0 with LLVM Exceptions:
+// https://llvm.org/LICENSE.txt
+//===----------------------------------------------------------------------===//
+
+#include "MetalAIRPass.h"
+
+#include "llvm/ADT/SmallSet.h"
+#include "llvm/ADT/SmallVector.h"
+#include "llvm/IR/Constants.h"
+#include "llvm/IR/Function.h"
+#include "llvm/IR/IRBuilder.h"
+#include "llvm/IR/Instructions.h"
+#include "llvm/IR/Metadata.h"
+#include "llvm/IR/Module.h"
+#include "llvm/Support/ErrorHandling.h"
+#include "llvm/Support/raw_ostream.h"
+
+#include <array>
+
+namespace M::KGEN {
+namespace {
+
+constexpr llvm::StringLiteral kMetalKernelAttribute = "metal.kernel";
+
+struct MetalBuiltinFamily {
+  llvm::StringLiteral functionNamePrefix;
+  llvm::StringLiteral metadataName;
+  llvm::StringLiteral argumentName;
+};
+
+constexpr MetalBuiltinFamily kSupportedBuiltinFamilies[] = {
+    {"air.thread_position_in_threadgroup.",
+     "air.thread_position_in_threadgroup",
+     "thread_position_in_threadgroup_idx"},
+    {"air.threadgroup_position_in_grid.", "air.threadgroup_position_in_grid",
+     "threadgroup_position_in_grid_idx"},
+    {"air.threads_per_threadgroup.", "air.threads_per_threadgroup",
+     "threads_per_threadgroup_idx"},
+    {"air.threads_per_grid.", "air.threads_per_grid", "threads_per_grid_idx"},
+};
+
+constexpr llvm::StringLiteral kBuiltinDimensions[] = {"x", "y", "z"};
+
+struct UsedMetalBuiltinFamily {
+  const MetalBuiltinFamily *family;
+  llvm::SmallVector<std::pair<unsigned, llvm::CallInst *>, 4> calls;
+};
+
+static llvm::Metadata *metadataString(llvm::LLVMContext &context,
+                                      llvm::StringRef value) {
+  return llvm::MDString::get(context, value);
+}
+
+static llvm::Metadata *metadataI32(llvm::LLVMContext &context, uint32_t value) {
+  return llvm::ConstantAsMetadata::get(
+      llvm::ConstantInt::get(llvm::Type::getInt32Ty(context), value));
+}
+
+static llvm::MDNode *
+metadataNode(llvm::LLVMContext &context,
+             std::initializer_list<llvm::Metadata *> operands) {
+  return llvm::MDNode::get(context, operands);
+}
+
+static llvm::Type *inferBufferElementType(const llvm::Argument &argument) {
+  llvm::SmallVector<const llvm::Value *> worklist{&argument};
+  llvm::SmallSet<const llvm::Value *, 16> visited;
+  llvm::Type *fallbackType = nullptr;
+  while (!worklist.empty()) {
+    const llvm::Value *pointer = worklist.pop_back_val();
+    if (!visited.insert(pointer).second)
+      continue;
+    for (const llvm::User *user : pointer->users()) {
+      if (const auto *load = llvm::dyn_cast<llvm::LoadInst>(user))
+        if (load->getPointerOperand() == pointer)
+          return load->getType();
+      if (const auto *store = llvm::dyn_cast<llvm::StoreInst>(user))
+        if (store->getPointerOperand() == pointer)
+          return store->getValueOperand()->getType();
+      if (const auto *gep = llvm::dyn_cast<llvm::GetElementPtrInst>(user)) {
+        fallbackType = gep->getSourceElementType();
+        worklist.push_back(gep);
+      } else if (llvm::isa<llvm::BitCastInst, llvm::AddrSpaceCastInst>(user)) {
+        worklist.push_back(user);
+      }
+    }
+  }
+  return fallbackType;
+}
+
+static llvm::StringRef airTypeName(llvm::Type *type) {
+  if (auto *vectorType = llvm::dyn_cast<llvm::FixedVectorType>(type)) {
+    if (vectorType->getNumElements() == 1)
+      type = vectorType->getElementType();
+  }
+  if (type->isFloatTy())
+    return "float";
+  if (type->isHalfTy())
+    return "half";
+  if (type->isIntegerTy(1))
+    return "bool";
+  if (type->isIntegerTy(8))
+    return "char";
+  if (type->isIntegerTy(16))
+    return "short";
+  if (type->isIntegerTy(32))
+    return "int";
+  if (type->isIntegerTy(64))
+    return "long";
+  if (auto *arrayType = llvm::dyn_cast<llvm::ArrayType>(type))
+    if (arrayType->getElementType()->isIntegerTy(8))
+      return "void";
+  return {};
+}
+
+static bool isDirectlyUsedByFunction(const llvm::Value &value,
+                                     const llvm::Function &function) {
+  for (const llvm::User *user : value.users())
+    if (const auto *instruction = llvm::dyn_cast<llvm::Instruction>(user))
+      if (instruction->getFunction() == &function)
+        return true;
+  return false;
+}
+
+static void collectBuiltinCalls(
+    llvm::Function &kernel,
+    llvm::SmallVectorImpl<UsedMetalBuiltinFamily> &usedBuiltinFamilies) {
+  for (const MetalBuiltinFamily &family : kSupportedBuiltinFamilies) {
+    UsedMetalBuiltinFamily usedFamily{&family, {}};
+    for (auto [component, dimension] : llvm::enumerate(kBuiltinDimensions)) {
+      std::string functionName = (family.functionNamePrefix + dimension).str();
+      llvm::Function *declaration =
+          kernel.getParent()->getFunction(functionName);
+      if (!declaration)
+        continue;
+      for (llvm::User *user : declaration->users()) {
+        auto *call = llvm::dyn_cast<llvm::CallInst>(user);
+        if (call && call->getFunction() == &kernel)
+          usedFamily.calls.push_back({static_cast<unsigned>(component), call});
+      }
+    }
+    if (!usedFamily.calls.empty())
+      usedBuiltinFamilies.push_back(std::move(usedFamily));
+  }
+}
+
+static void collectDynamicThreadgroupGlobals(
+    llvm::Function &kernel,
+    llvm::SmallVectorImpl<llvm::GlobalVariable *> &dynamicThreadgroupGlobals) {
+  for (llvm::GlobalVariable &global : kernel.getParent()->globals()) {
+    if (global.getAddressSpace() != 3 || !global.isDeclaration())
+      continue;
+    if (isDirectlyUsedByFunction(global, kernel))
+      dynamicThreadgroupGlobals.push_back(&global);
+  }
+}
+
+static llvm::Function *rewriteKernelABI(
+    llvm::Function &kernel,
+    llvm::ArrayRef<UsedMetalBuiltinFamily> usedBuiltinFamilies,
+    llvm::ArrayRef<llvm::GlobalVariable *> dynamicThreadgroupGlobals) {
+  const llvm::DataLayout &layout = kernel.getParent()->getDataLayout();
+
+  if (kernel.arg_empty() && usedBuiltinFamilies.empty() &&
+      dynamicThreadgroupGlobals.empty())
+    return &kernel;
+
+  llvm::SmallVector<llvm::Type *> parameterTypes;
+  parameterTypes.reserve(kernel.arg_size() +
+                         (dynamicThreadgroupGlobals.empty() ? 0 : 1) +
+                         usedBuiltinFamilies.size());
+  for (llvm::Type *parameterType : kernel.getFunctionType()->params())
+    parameterTypes.push_back(
+        parameterType->isPointerTy()
+            ? llvm::PointerType::get(kernel.getContext(), 1)
+            : llvm::PointerType::get(kernel.getContext(), 2));
+  if (!dynamicThreadgroupGlobals.empty())
+    parameterTypes.push_back(llvm::PointerType::get(kernel.getContext(), 3));
+  llvm::Type *uint3Type = llvm::FixedVectorType::get(
+      llvm::Type::getInt32Ty(kernel.getContext()), 3);
+  parameterTypes.append(usedBuiltinFamilies.size(), uint3Type);
+  llvm::FunctionType *newType = llvm::FunctionType::get(
+      kernel.getReturnType(), parameterTypes, /*isVarArg=*/false);
+  llvm::Function *newKernel =
+      llvm::Function::Create(newType, kernel.getLinkage(),
+                             kernel.getAddressSpace(), "", kernel.getParent());
+  newKernel->takeName(&kernel);
+  newKernel->copyAttributesFrom(&kernel);
+  newKernel->setDSOLocal(kernel.isDSOLocal());
+  newKernel->setVisibility(kernel.getVisibility());
+  newKernel->setSubprogram(kernel.getSubprogram());
+  newKernel->splice(newKernel->begin(), &kernel);
+
+  llvm::IRBuilder<> builder(newKernel->getContext());
+  builder.SetInsertPoint(&newKernel->getEntryBlock(),
+                         newKernel->getEntryBlock().getFirstInsertionPt());
+  auto newArgument = newKernel->arg_begin();
+  for (llvm::Argument &oldArgument : kernel.args()) {
+    newArgument->setName(oldArgument.getName());
+    llvm::Value *replacement = &*newArgument;
+    if (oldArgument.getType()->isPointerTy()) {
+      assert(newArgument->getType()->isPointerTy() &&
+             "Metal buffer ABI must retain a pointer parameter");
+      if (oldArgument.getType() != newArgument->getType())
+        replacement = builder.CreateAddrSpaceCast(
+            &*newArgument, oldArgument.getType(),
+            (newArgument->getName() + ".generic").str());
+    } else {
+      llvm::TypeSize typeSize = layout.getTypeStoreSize(oldArgument.getType());
+      if (typeSize.isScalable() || typeSize.getFixedValue() == 0)
+        llvm::report_fatal_error("Metal zero-sized or scalable kernel "
+                                 "arguments are not implemented");
+      replacement = builder.CreateAlignedLoad(
+          oldArgument.getType(), &*newArgument,
+          layout.getABITypeAlign(oldArgument.getType()),
+          (newArgument->getName() + ".value").str());
+    }
+    oldArgument.replaceAllUsesWith(replacement);
+    ++newArgument;
+  }
+
+  if (!dynamicThreadgroupGlobals.empty()) {
+    newArgument->setName("dynamic_threadgroup_memory");
+    for (llvm::GlobalVariable *global : dynamicThreadgroupGlobals) {
+      llvm::SmallVector<llvm::Use *> kernelUses;
+      for (llvm::Use &use : global->uses())
+        if (auto *instruction =
+                llvm::dyn_cast<llvm::Instruction>(use.getUser()))
+          if (instruction->getFunction() == newKernel)
+            kernelUses.push_back(&use);
+      if (kernelUses.empty())
+        llvm::report_fatal_error(
+            "Metal dynamic threadgroup memory through a non-inlined helper "
+            "function is not implemented");
+      for (llvm::Use *use : kernelUses)
+        use->set(&*newArgument);
+    }
+    ++newArgument;
+  }
+
+  for (const UsedMetalBuiltinFamily &usedFamily : usedBuiltinFamilies) {
+    newArgument->setName(usedFamily.family->argumentName);
+    // Earlier families may erase the instruction that was the previous
+    // builder's insertion anchor.  Recompute the entry insertion point before
+    // materializing each vector family.
+    llvm::IRBuilder<> builtinBuilder(newKernel->getContext());
+    builtinBuilder.SetInsertPoint(
+        &newKernel->getEntryBlock(),
+        newKernel->getEntryBlock().getFirstInsertionPt());
+    std::array<llvm::Value *, 3> components = {nullptr, nullptr, nullptr};
+    for (auto [component, call] : usedFamily.calls) {
+      if (!components[component])
+        components[component] = builtinBuilder.CreateExtractElement(
+            &*newArgument, builtinBuilder.getInt32(component),
+            (newArgument->getName() + "." + kBuiltinDimensions[component])
+                .str());
+      call->replaceAllUsesWith(components[component]);
+      call->eraseFromParent();
+    }
+    ++newArgument;
+  }
+
+  assert(kernel.use_empty() &&
+         "Metal kernel entries must not be called by device code");
+  kernel.eraseFromParent();
+  return newKernel;
+}
+
+static llvm::MDNode *buildBufferArgumentMetadata(llvm::Function &kernel,
+                                                 llvm::Argument &argument,
+                                                 uint32_t index) {
+  llvm::Type *elementType = inferBufferElementType(argument);
+  if (!elementType)
+    llvm::report_fatal_error(
+        "Metal buffer argument element type inference is not implemented");
+  llvm::StringRef typeName = airTypeName(elementType);
+  if (typeName.empty()) {
+    std::string message;
+    llvm::raw_string_ostream stream(message);
+    stream << "Metal buffer argument element type is not implemented: ";
+    elementType->print(stream);
+    stream.flush();
+    llvm::report_fatal_error(llvm::StringRef(message));
+  }
+
+  const llvm::DataLayout &layout = kernel.getParent()->getDataLayout();
+  uint64_t typeSize = layout.getTypeStoreSize(elementType).getFixedValue();
+  uint64_t typeAlignment = layout.getABITypeAlign(elementType).value();
+  if (typeSize > UINT32_MAX || typeAlignment > UINT32_MAX)
+    llvm::report_fatal_error("Metal buffer element layout exceeds AIR limits");
+
+  llvm::LLVMContext &context = kernel.getContext();
+  std::string fallbackName = ("argument" + llvm::Twine(index)).str();
+  llvm::StringRef argumentName =
+      argument.hasName() ? argument.getName() : fallbackName;
+  return metadataNode(
+      context,
+      {metadataI32(context, index), metadataString(context, "air.buffer"),
+       metadataString(context, "air.location_index"),
+       metadataI32(context, index), metadataI32(context, 1),
+       metadataString(context, "air.read_write"),
+       metadataString(context, "air.arg_type_size"),
+       metadataI32(context, static_cast<uint32_t>(typeSize)),
+       metadataString(context, "air.arg_type_align_size"),
+       metadataI32(context, static_cast<uint32_t>(typeAlignment)),
+       metadataString(context, "air.arg_type_name"),
+       metadataString(context, typeName),
+       metadataString(context, "air.arg_name"),
+       metadataString(context, argumentName)});
+}
+
+static llvm::MDNode *buildConstantArgumentMetadata(llvm::Function &kernel,
+                                                   llvm::Argument &argument,
+                                                   llvm::Type *valueType,
+                                                   uint32_t index) {
+  const llvm::DataLayout &layout = kernel.getParent()->getDataLayout();
+  llvm::TypeSize typeSize = layout.getTypeStoreSize(valueType);
+  if (typeSize.isScalable() || typeSize.getFixedValue() == 0 ||
+      typeSize.getFixedValue() > UINT32_MAX)
+    llvm::report_fatal_error(
+        "Metal constant kernel argument layout is not implemented");
+  uint64_t typeAlignment = layout.getABITypeAlign(valueType).value();
+  if (typeAlignment > UINT32_MAX)
+    llvm::report_fatal_error(
+        "Metal constant kernel argument alignment exceeds AIR limits");
+
+  llvm::StringRef typeName = airTypeName(valueType);
+  if (typeName.empty()) {
+    if (!valueType->isAggregateType())
+      llvm::report_fatal_error(
+          "Metal constant kernel argument type is not implemented");
+    typeName = "void";
+  }
+
+  llvm::LLVMContext &context = kernel.getContext();
+  std::string fallbackName = ("argument" + llvm::Twine(index)).str();
+  llvm::StringRef argumentName =
+      argument.hasName() ? argument.getName() : fallbackName;
+  uint32_t fixedTypeSize = static_cast<uint32_t>(typeSize.getFixedValue());
+  return metadataNode(
+      context,
+      {metadataI32(context, index), metadataString(context, "air.buffer"),
+       metadataString(context, "air.buffer_size"),
+       metadataI32(context, fixedTypeSize),
+       metadataString(context, "air.location_index"),
+       metadataI32(context, index), metadataI32(context, 1),
+       metadataString(context, "air.read"),
+       metadataString(context, "air.arg_type_size"),
+       metadataI32(context, fixedTypeSize),
+       metadataString(context, "air.arg_type_align_size"),
+       metadataI32(context, static_cast<uint32_t>(typeAlignment)),
+       metadataString(context, "air.arg_type_name"),
+       metadataString(context, typeName),
+       metadataString(context, "air.arg_name"),
+       metadataString(context, argumentName)});
+}
+
+static llvm::MDNode *buildDynamicThreadgroupArgumentMetadata(
+    llvm::Function &kernel, llvm::Argument &argument, uint32_t locationIndex) {
+  llvm::Type *elementType = inferBufferElementType(argument);
+  if (!elementType)
+    llvm::report_fatal_error(
+        "Metal dynamic threadgroup element type inference is not implemented");
+  llvm::StringRef typeName = airTypeName(elementType);
+  if (typeName.empty())
+    llvm::report_fatal_error(
+        "Metal dynamic threadgroup element type is not implemented");
+
+  const llvm::DataLayout &layout = kernel.getParent()->getDataLayout();
+  llvm::TypeSize typeSize = layout.getTypeStoreSize(elementType);
+  uint64_t typeAlignment = layout.getABITypeAlign(elementType).value();
+  if (typeSize.isScalable() || typeSize.getFixedValue() > UINT32_MAX ||
+      typeAlignment > UINT32_MAX)
+    llvm::report_fatal_error(
+        "Metal dynamic threadgroup element layout exceeds AIR limits");
+
+  llvm::LLVMContext &context = kernel.getContext();
+  return metadataNode(
+      context,
+      {metadataI32(context, argument.getArgNo()),
+       metadataString(context, "air.buffer"),
+       metadataString(context, "air.location_index"),
+       metadataI32(context, locationIndex), metadataI32(context, 1),
+       metadataString(context, "air.read_write"),
+       metadataString(context, "air.arg_type_size"),
+       metadataI32(context, static_cast<uint32_t>(typeSize.getFixedValue())),
+       metadataString(context, "air.arg_type_align_size"),
+       metadataI32(context, static_cast<uint32_t>(typeAlignment)),
+       metadataString(context, "air.arg_type_name"),
+       metadataString(context, typeName),
+       metadataString(context, "air.arg_name"),
+       metadataString(context, argument.getName())});
+}
+
+static void addModuleMetadata(llvm::Module &module) {
+  llvm::LLVMContext &context = module.getContext();
+  auto addNamed = [&](llvm::StringRef name, llvm::MDNode *node) {
+    llvm::NamedMDNode *metadata = module.getOrInsertNamedMetadata(name);
+    metadata->clearOperands();
+    metadata->addOperand(node);
+  };
+
+  llvm::NamedMDNode *compileOptions =
+      module.getOrInsertNamedMetadata("air.compile_options");
+  compileOptions->clearOperands();
+  compileOptions->addOperand(metadataNode(
+      context, {metadataString(context, "air.compile.denorms_disable")}));
+  compileOptions->addOperand(metadataNode(
+      context, {metadataString(context, "air.compile.fast_math_disable")}));
+  compileOptions->addOperand(metadataNode(
+      context,
+      {metadataString(context, "air.compile.framebuffer_fetch_enable")}));
+  addNamed("air.version", metadataNode(context, {metadataI32(context, 2),
+                                                 metadataI32(context, 4),
+                                                 metadataI32(context, 0)}));
+  addNamed(
+      "air.language_version",
+      metadataNode(context,
+                   {metadataString(context, "Metal"), metadataI32(context, 2),
+                    metadataI32(context, 4), metadataI32(context, 0)}));
+  addNamed("air.source_file_name",
+           metadataNode(context,
+                        {metadataString(context, module.getSourceFileName())}));
+
+  module.addModuleFlag(llvm::Module::ModFlagBehavior::Max,
+                       "air.max_device_buffers", 31);
+  module.addModuleFlag(llvm::Module::ModFlagBehavior::Max,
+                       "air.max_constant_buffers", 31);
+  module.addModuleFlag(llvm::Module::ModFlagBehavior::Max,
+                       "air.max_threadgroup_buffers", 31);
+  module.addModuleFlag(llvm::Module::ModFlagBehavior::Max, "air.max_textures",
+                       128);
+  module.addModuleFlag(llvm::Module::ModFlagBehavior::Max,
+                       "air.max_read_write_textures", 8);
+  module.addModuleFlag(llvm::Module::ModFlagBehavior::Max, "air.max_samplers",
+                       16);
+}
+
+static void
+addKernelMetadata(llvm::Module &module, llvm::Function &kernel,
+                  llvm::ArrayRef<llvm::Type *> explicitArgumentTypes,
+                  bool hasDynamicThreadgroupMemory,
+                  llvm::ArrayRef<UsedMetalBuiltinFamily> usedBuiltinFamilies) {
+  llvm::LLVMContext &context = module.getContext();
+  llvm::SmallVector<llvm::Metadata *> argumentMetadata;
+  argumentMetadata.reserve(kernel.arg_size());
+
+  auto argument = kernel.arg_begin();
+  for (unsigned index = 0; index != explicitArgumentTypes.size();
+       ++index, ++argument) {
+    if (explicitArgumentTypes[index]->isPointerTy())
+      argumentMetadata.push_back(
+          buildBufferArgumentMetadata(kernel, *argument, index));
+    else
+      argumentMetadata.push_back(buildConstantArgumentMetadata(
+          kernel, *argument, explicitArgumentTypes[index], index));
+  }
+
+  if (hasDynamicThreadgroupMemory) {
+    argumentMetadata.push_back(
+        buildDynamicThreadgroupArgumentMetadata(kernel, *argument, 0));
+    ++argument;
+  }
+
+  for (const UsedMetalBuiltinFamily &usedFamily : usedBuiltinFamilies) {
+    uint32_t index = argument->getArgNo();
+    argumentMetadata.push_back(metadataNode(
+        context, {metadataI32(context, index),
+                  metadataString(context, usedFamily.family->metadataName),
+                  metadataString(context, "air.arg_type_name"),
+                  metadataString(context, "uint3"),
+                  metadataString(context, "air.arg_name"),
+                  metadataString(context, usedFamily.family->argumentName)}));
+    ++argument;
+  }
+  assert(argument == kernel.arg_end() &&
+         "every Metal kernel argument must have AIR metadata");
+
+  llvm::NamedMDNode *kernels = module.getOrInsertNamedMetadata("air.kernel");
+  kernels->addOperand(metadataNode(
+      context, {llvm::ValueAsMetadata::get(&kernel), metadataNode(context, {}),
+                llvm::MDNode::get(context, argumentMetadata)}));
+}
+
+} // namespace
+
+llvm::PreservedAnalyses
+PrepareMetalAIRPass::run(llvm::Module &module,
+                         llvm::ModuleAnalysisManager &analysisManager) {
+  (void)analysisManager;
+  bool changed = false;
+  for (llvm::Function &function : module) {
+    changed |= function.hasFnAttribute("target-cpu") ||
+               function.hasFnAttribute("target-features");
+    function.removeFnAttr("target-cpu");
+    function.removeFnAttr("target-features");
+  }
+  return changed ? llvm::PreservedAnalyses::none()
+                 : llvm::PreservedAnalyses::all();
+}
+
+llvm::PreservedAnalyses
+MetalAIRPass::run(llvm::Module &module,
+                  llvm::ModuleAnalysisManager &analysisManager) {
+  (void)analysisManager;
+  addModuleMetadata(module);
+
+  llvm::SmallVector<llvm::Function *> kernels;
+  for (llvm::Function &function : module)
+    if (function.hasFnAttribute(kMetalKernelAttribute))
+      kernels.push_back(&function);
+  if (kernels.empty())
+    llvm::report_fatal_error("Metal module has no kernel entry point");
+
+  for (llvm::Function *oldKernel : kernels) {
+    llvm::SmallVector<llvm::Type *> explicitArgumentTypes =
+        llvm::to_vector(oldKernel->getFunctionType()->params());
+    llvm::SmallVector<UsedMetalBuiltinFamily> usedBuiltinFamilies;
+    collectBuiltinCalls(*oldKernel, usedBuiltinFamilies);
+    llvm::SmallVector<llvm::GlobalVariable *> dynamicThreadgroupGlobals;
+    collectDynamicThreadgroupGlobals(*oldKernel, dynamicThreadgroupGlobals);
+    llvm::Function *kernel = rewriteKernelABI(*oldKernel, usedBuiltinFamilies,
+                                              dynamicThreadgroupGlobals);
+    kernel->removeFnAttr(kMetalKernelAttribute);
+    kernel->removeFnAttr("target-cpu");
+    kernel->removeFnAttr("target-features");
+    addKernelMetadata(module, *kernel, explicitArgumentTypes,
+                      !dynamicThreadgroupGlobals.empty(), usedBuiltinFamilies);
+  }
+
+  for (llvm::GlobalVariable &global :
+       llvm::make_early_inc_range(module.globals())) {
+    if (global.getAddressSpace() != 3 || !global.isDeclaration())
+      continue;
+    if (!global.use_empty())
+      llvm::report_fatal_error(
+          "Metal dynamic threadgroup memory through a non-inlined helper "
+          "function is not implemented");
+    global.eraseFromParent();
+  }
+
+  // Calls to AIR intrinsics have become explicit kernel arguments. Leaving
+  // unused declarations in the final module makes Apple's AIR verifier treat
+  // the module as only partially legalized.
+  llvm::SmallVector<llvm::Function *> unusedAIRDeclarations;
+  for (llvm::Function &function : module)
+    if (function.isDeclaration() && function.use_empty() &&
+        function.getName().starts_with("llvm.air."))
+      unusedAIRDeclarations.push_back(&function);
+  for (llvm::Function *declaration : unusedAIRDeclarations)
+    declaration->eraseFromParent();
+
+  return llvm::PreservedAnalyses::none();
+}
+
