diff --git a/AsyncRT/lib/Runtime/Apple/DeviceContextCAPI.c b/AsyncRT/lib/Runtime/Apple/DeviceContextCAPI.c
new file mode 100644
index 0000000000..eeb028c9ab
--- /dev/null
+++ b/AsyncRT/lib/Runtime/Apple/DeviceContextCAPI.c
@@ -0,0 +1,493 @@
+//===----------------------------------------------------------------------===//
+// Copyright (c) 2026, Modular Inc. All rights reserved.
+//
+// Licensed under the Apache License v2.0 with LLVM Exceptions:
+// https://llvm.org/LICENSE.txt
+//
+// Distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+//===----------------------------------------------------------------------===//
+
+#include "AsyncRT/Runtime/DeviceContextCAPI.h"
+#include "AppleDeviceContextInternal.h"
+#include "AppleWorkQueue.h"
+
+#include <assert.h>
+#include <dispatch/dispatch.h>
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+enum {
+  ASYNCRT_CPU_PARALLELISM_ATTRIBUTE = 1000,
+};
+
+typedef struct {
+  AsyncRTAppleDeviceContextBase base;
+  dispatch_group_t pending_tasks;
+} AsyncRTCPUDeviceContext;
+
+typedef struct {
+  AsyncRTAppleDeviceContextBase base;
+  dispatch_group_t pending_tasks;
+  dispatch_queue_t submission_queue;
+  pthread_mutex_t error_mutex;
+  char *first_error;
+} AsyncRTCoreAIDeviceContext;
+
+typedef void (*AsyncRTCoreAICompletionFunction)(void *request,
+                                                const char *error_message);
+
+/// Implemented by the generated Swift package support.  Keep this weak so an
+/// application that never selects Core AI can still link the CPU/Metal runtime.
+extern void MojoIOSCoreAI_executeMatmulMatmulF32_2x3x4x2(
+    const float *input, const float *first_weights,
+    const float *second_weights, float *output, void *request,
+    AsyncRTCoreAICompletionFunction completion) __attribute__((weak_import));
+
+typedef struct {
+  AsyncRTCoreAIDeviceContext *context;
+  const float *input;
+  const float *first_weights;
+  const float *second_weights;
+  float *output;
+  dispatch_semaphore_t completion_semaphore;
+  char *error_message;
+} AsyncRTCoreAIMatmulMatmulTask;
+
+typedef struct AsyncRTCoroutineBatch AsyncRTCoroutineBatch;
+
+typedef struct {
+  AsyncRTCoroutineBatch *batch;
+  void *handle;
+} AsyncRTCoroutineTask;
+
+struct AsyncRTCoroutineBatch {
+  AsyncRTCPUDeviceContext *context;
+  AsyncRTCoroutineFunction resume_function;
+  AsyncRTCoroutineFunction destroy_function;
+  _Atomic(size_t) remaining_task_count;
+  AsyncRTCoroutineTask tasks[];
+};
+
+static uint32_t asyncrt_apple_online_processor_count(void) {
+  long online_processor_count = sysconf(_SC_NPROCESSORS_ONLN);
+  assert(online_processor_count > 0);
+  assert((unsigned long)online_processor_count <= UINT32_MAX);
+  return (uint32_t)online_processor_count;
+}
+
+static AsyncRTCPUDeviceContext *
+asyncrt_apple_device_context_from_untyped(void *untyped_context) {
+  AsyncRTCPUDeviceContext *context = untyped_context;
+  assert(context != NULL);
+  assert(context->base.magic == ASYNCRT_APPLE_DEVICE_CONTEXT_MAGIC);
+  assert(context->base.kind == ASYNCRT_APPLE_DEVICE_CONTEXT_CPU);
+  assert(atomic_load_explicit(&context->base.reference_count,
+                              memory_order_acquire) > 0);
+  return context;
+}
+
+static AsyncRTCoreAIDeviceContext *
+asyncrt_apple_coreai_context_from_untyped(void *untyped_context) {
+  AsyncRTCoreAIDeviceContext *context = untyped_context;
+  assert(context != NULL);
+  assert(context->base.magic == ASYNCRT_APPLE_DEVICE_CONTEXT_MAGIC);
+  assert(context->base.kind == ASYNCRT_APPLE_DEVICE_CONTEXT_COREAI);
+  assert(atomic_load_explicit(&context->base.reference_count,
+                              memory_order_acquire) > 0);
+  assert(context->pending_tasks != NULL);
+  assert(context->submission_queue != NULL);
+  return context;
+}
+
+static AsyncRTAppleDeviceContextBase *
+asyncrt_apple_device_context_base_from_untyped(void *untyped_context) {
+  AsyncRTAppleDeviceContextBase *context = untyped_context;
+  assert(context != NULL);
+  assert(context->magic == ASYNCRT_APPLE_DEVICE_CONTEXT_MAGIC);
+  assert(context->kind == ASYNCRT_APPLE_DEVICE_CONTEXT_CPU ||
+         context->kind == ASYNCRT_APPLE_DEVICE_CONTEXT_METAL ||
+         context->kind == ASYNCRT_APPLE_DEVICE_CONTEXT_COREAI);
+  assert(atomic_load_explicit(&context->reference_count, memory_order_acquire) >
+         0);
+  return context;
+}
+
+static const char *asyncrt_apple_owned_error(const char *message) {
+  assert(message != NULL);
+  char *owned_message = strdup(message);
+  assert(owned_message != NULL);
+  return owned_message;
+}
+
+static void asyncrt_apple_coreai_record_error(
+    AsyncRTCoreAIDeviceContext *context, const char *error_message) {
+  assert(context != NULL);
+  if (error_message == NULL)
+    return;
+  int lock_result = pthread_mutex_lock(&context->error_mutex);
+  assert(lock_result == 0);
+  if (context->first_error == NULL) {
+    context->first_error = strdup(error_message);
+    assert(context->first_error != NULL);
+  }
+  int unlock_result = pthread_mutex_unlock(&context->error_mutex);
+  assert(unlock_result == 0);
+}
+
+static void asyncrt_apple_coreai_complete_matmul_matmul(
+    void *untyped_task, const char *error_message) {
+  AsyncRTCoreAIMatmulMatmulTask *task = untyped_task;
+  assert(task != NULL);
+  assert(task->completion_semaphore != NULL);
+  assert(task->error_message == NULL);
+  if (error_message != NULL) {
+    task->error_message = strdup(error_message);
+    assert(task->error_message != NULL);
+  }
+  (void)dispatch_semaphore_signal(task->completion_semaphore);
+}
+
+static void
+asyncrt_apple_coreai_execute_matmul_matmul(void *untyped_task) {
+  AsyncRTCoreAIMatmulMatmulTask *task = untyped_task;
+  assert(task != NULL);
+  assert(task->context != NULL);
+  assert(MojoIOSCoreAI_executeMatmulMatmulF32_2x3x4x2 != NULL);
+
+  MojoIOSCoreAI_executeMatmulMatmulF32_2x3x4x2(
+      task->input, task->first_weights, task->second_weights, task->output,
+      task, asyncrt_apple_coreai_complete_matmul_matmul);
+  long wait_result = dispatch_semaphore_wait(task->completion_semaphore,
+                                             DISPATCH_TIME_FOREVER);
+  assert(wait_result == 0);
+
+  asyncrt_apple_coreai_record_error(task->context, task->error_message);
+  free(task->error_message);
+  dispatch_release(task->completion_semaphore);
+  dispatch_group_leave(task->context->pending_tasks);
+  AsyncRT_DeviceContext_release(task->context);
+  free(task);
+}
+
+static void asyncrt_apple_coroutine_task_execute(void *untyped_task) {
+  AsyncRTCoroutineTask *task = untyped_task;
+  assert(task != NULL);
+  AsyncRTCoroutineBatch *batch = task->batch;
+  assert(batch != NULL);
+  assert(batch->resume_function != NULL);
+  assert(batch->destroy_function != NULL);
+  assert(task->handle != NULL);
+
+  batch->resume_function(task->handle);
+  batch->destroy_function(task->handle);
+
+  dispatch_group_leave(batch->context->pending_tasks);
+  size_t previous_remaining_task_count = atomic_fetch_sub_explicit(
+      &batch->remaining_task_count, 1, memory_order_acq_rel);
+  assert(previous_remaining_task_count > 0);
+  if (previous_remaining_task_count == 1) {
+    AsyncRT_DeviceContext_release(batch->context);
+    free(batch);
+  }
+}
+
+const char *AsyncRT_DeviceContext_create(void **result, const char *api,
+                                         int32_t device_id) {
+  if (result == NULL)
+    return asyncrt_apple_owned_error("DeviceContext result pointer is null");
+  *result = NULL;
+  if (api == NULL)
+    return asyncrt_apple_owned_error("DeviceContext API string is null");
+  if (strcmp(api, "metal") == 0) {
+#if defined(ASYNCRT_ENABLE_METAL) && ASYNCRT_ENABLE_METAL
+    return AsyncRT_AppleMetalDeviceContext_create(result, device_id);
+#else
+    return asyncrt_apple_owned_error(
+        "the embedded Apple DeviceContext was built without Metal support");
+#endif
+  }
+  if (strcmp(api, "coreai") == 0) {
+    if (device_id != 0)
+      return asyncrt_apple_owned_error(
+          "the embedded Apple Core AI DeviceContext supports only device 0");
+
+    AsyncRTCoreAIDeviceContext *context = malloc(sizeof(*context));
+    assert(context != NULL);
+    atomic_init(&context->base.reference_count, 1);
+    context->base.magic = ASYNCRT_APPLE_DEVICE_CONTEXT_MAGIC;
+    context->base.kind = ASYNCRT_APPLE_DEVICE_CONTEXT_COREAI;
+    context->pending_tasks = dispatch_group_create();
+    assert(context->pending_tasks != NULL);
+    context->submission_queue = dispatch_queue_create(
+        "org.modular.asyncrt.coreai.submission", DISPATCH_QUEUE_SERIAL);
+    assert(context->submission_queue != NULL);
+    int mutex_result = pthread_mutex_init(&context->error_mutex, NULL);
+    assert(mutex_result == 0);
+    context->first_error = NULL;
+    *result = context;
+    return NULL;
+  }
+  if (strcmp(api, "cpu") != 0)
+    return asyncrt_apple_owned_error(
+        "the embedded Apple DeviceContext API is not implemented");
+  if (device_id != 0)
+    return asyncrt_apple_owned_error(
+        "the embedded Apple CPU DeviceContext supports only device 0");
+
+  AsyncRTCPUDeviceContext *context = malloc(sizeof(*context));
+  assert(context != NULL);
+  atomic_init(&context->base.reference_count, 1);
+  context->base.magic = ASYNCRT_APPLE_DEVICE_CONTEXT_MAGIC;
+  context->base.kind = ASYNCRT_APPLE_DEVICE_CONTEXT_CPU;
+  context->pending_tasks = dispatch_group_create();
+  assert(context->pending_tasks != NULL);
+  *result = context;
+  return NULL;
+}
+
+void AsyncRT_DeviceContext_retain(void *untyped_context) {
+  AsyncRTAppleDeviceContextBase *context =
+      asyncrt_apple_device_context_base_from_untyped(untyped_context);
+  uint32_t previous_reference_count = atomic_fetch_add_explicit(
+      &context->reference_count, 1, memory_order_acq_rel);
+  assert(previous_reference_count > 0);
+  assert(previous_reference_count < UINT32_MAX);
+}
+
+void AsyncRT_DeviceContext_release(void *untyped_context) {
+  AsyncRTAppleDeviceContextBase *context =
+      asyncrt_apple_device_context_base_from_untyped(untyped_context);
+  uint32_t previous_reference_count = atomic_fetch_sub_explicit(
+      &context->reference_count, 1, memory_order_acq_rel);
+  assert(previous_reference_count > 0);
+  if (previous_reference_count != 1)
+    return;
+
+  if (context->kind == ASYNCRT_APPLE_DEVICE_CONTEXT_METAL) {
+#if defined(ASYNCRT_ENABLE_METAL) && ASYNCRT_ENABLE_METAL
+    AsyncRT_AppleMetalDeviceContext_destroy(untyped_context);
+    return;
+#else
+    assert(false && "Metal context exists in a runtime built without Metal");
+#endif
+  }
+
+  if (context->kind == ASYNCRT_APPLE_DEVICE_CONTEXT_COREAI) {
+    AsyncRTCoreAIDeviceContext *coreai_context = untyped_context;
+    assert(dispatch_group_wait(coreai_context->pending_tasks,
+                               DISPATCH_TIME_NOW) == 0 &&
+           "the final Core AI DeviceContext reference cannot be released "
+           "with pending tasks");
+    assert(coreai_context->first_error == NULL &&
+           "Core AI errors must be observed by synchronize before final "
+           "release");
+    coreai_context->base.magic = 0;
+    int mutex_result = pthread_mutex_destroy(&coreai_context->error_mutex);
+    assert(mutex_result == 0);
+    dispatch_release(coreai_context->submission_queue);
+    dispatch_release(coreai_context->pending_tasks);
+    free(coreai_context);
+    return;
+  }
+
+  AsyncRTCPUDeviceContext *cpu_context = untyped_context;
+  assert(dispatch_group_wait(cpu_context->pending_tasks, DISPATCH_TIME_NOW) ==
+             0 &&
+         "the last DeviceContext reference cannot be released with pending "
+         "tasks");
+  cpu_context->base.magic = 0;
+  dispatch_release(cpu_context->pending_tasks);
+  free(cpu_context);
+}
+
+void AsyncRT_DeviceContext_deviceApi(AsyncRTStringRef *result,
+                                     void *untyped_context) {
+  AsyncRTAppleDeviceContextBase *context =
+      asyncrt_apple_device_context_base_from_untyped(untyped_context);
+  assert(result != NULL);
+  static const char cpu_api[] = "cpu";
+  static const char metal_api[] = "metal";
+  static const char coreai_api[] = "coreai";
+  if (context->kind == ASYNCRT_APPLE_DEVICE_CONTEXT_METAL) {
+    result->data = metal_api;
+    result->length = 5;
+  } else if (context->kind == ASYNCRT_APPLE_DEVICE_CONTEXT_COREAI) {
+    result->data = coreai_api;
+    result->length = 6;
+  } else {
+    result->data = cpu_api;
+    result->length = 3;
+  }
+}
+
+void AsyncRT_DeviceContext_strfree(const char *error_message) {
+  union {
+    const char *immutable_pointer;
+    void *mutable_pointer;
+  } owned_error = {.immutable_pointer = error_message};
+  free(owned_error.mutable_pointer);
+}
+
+const char *AsyncRT_DeviceContext_getAttribute(int32_t *result,
+                                               void *untyped_context,
+                                               int32_t attribute) {
+  AsyncRTAppleDeviceContextBase *base =
+      asyncrt_apple_device_context_base_from_untyped(untyped_context);
+  if (base->kind == ASYNCRT_APPLE_DEVICE_CONTEXT_COREAI)
+    return asyncrt_apple_owned_error(
+        "Core AI DeviceContext attributes are not implemented");
+  (void)asyncrt_apple_device_context_from_untyped(untyped_context);
+  if (result == NULL)
+    return asyncrt_apple_owned_error("DeviceContext attribute result is null");
+  if (attribute != ASYNCRT_CPU_PARALLELISM_ATTRIBUTE)
+    return asyncrt_apple_owned_error(
+        "unsupported attribute for the embedded Apple CPU DeviceContext");
+  *result = (int32_t)asyncrt_apple_online_processor_count();
+  return NULL;
+}
+
+const char *AsyncRT_DeviceContext_enqueueHostFunctionRange(
+    void *untyped_context, AsyncRTCoroutineFunction resume_function,
+    AsyncRTCoroutineFunction destroy_function, void *const *handles,
+    int64_t handle_count) {
+  AsyncRTAppleDeviceContextBase *base =
+      asyncrt_apple_device_context_base_from_untyped(untyped_context);
+  if (base->kind == ASYNCRT_APPLE_DEVICE_CONTEXT_COREAI)
+    return asyncrt_apple_owned_error(
+        "Core AI does not implement CPU coroutine-range enqueue");
+  AsyncRTCPUDeviceContext *context =
+      asyncrt_apple_device_context_from_untyped(untyped_context);
+  if (resume_function == NULL)
+    return asyncrt_apple_owned_error("coroutine resume function is null");
+  if (destroy_function == NULL)
+    return asyncrt_apple_owned_error("coroutine destroy function is null");
+  if (handle_count < 0)
+    return asyncrt_apple_owned_error("coroutine handle count is negative");
+  if (handle_count == 0)
+    return NULL;
+  if (handles == NULL)
+    return asyncrt_apple_owned_error("coroutine handle array is null");
+
+  size_t task_count = (size_t)handle_count;
+  if (task_count >
+      (SIZE_MAX - sizeof(AsyncRTCoroutineBatch)) / sizeof(AsyncRTCoroutineTask))
+    return asyncrt_apple_owned_error("coroutine handle count is too large");
+
+  size_t allocation_size =
+      sizeof(AsyncRTCoroutineBatch) + task_count * sizeof(AsyncRTCoroutineTask);
+  AsyncRTCoroutineBatch *batch = malloc(allocation_size);
+  assert(batch != NULL);
+  batch->context = context;
+  batch->resume_function = resume_function;
+  batch->destroy_function = destroy_function;
+  atomic_init(&batch->remaining_task_count, task_count);
+  for (size_t task_index = 0; task_index < task_count; ++task_index) {
+    assert(handles[task_index] != NULL);
+    batch->tasks[task_index].batch = batch;
+    batch->tasks[task_index].handle = handles[task_index];
+  }
+
+  AsyncRT_DeviceContext_retain(context);
+  for (size_t task_index = 0; task_index < task_count; ++task_index) {
+    dispatch_group_enter(context->pending_tasks);
+    AsyncRT_AppleWorkQueue_submit(asyncrt_apple_coroutine_task_execute,
+                                  &batch->tasks[task_index]);
+  }
+  return NULL;
+}
+
+const char *AsyncRT_DeviceContext_synchronize(void *untyped_context) {
+  AsyncRTAppleDeviceContextBase *base =
+      asyncrt_apple_device_context_base_from_untyped(untyped_context);
+  if (base->kind == ASYNCRT_APPLE_DEVICE_CONTEXT_METAL) {
+#if defined(ASYNCRT_ENABLE_METAL) && ASYNCRT_ENABLE_METAL
+    return AsyncRT_AppleMetalDeviceContext_synchronize(untyped_context);
+#else
+    return asyncrt_apple_owned_error(
+        "Metal synchronization is not implemented in this runtime build");
+#endif
+  }
+  if (base->kind == ASYNCRT_APPLE_DEVICE_CONTEXT_COREAI) {
+    AsyncRTCoreAIDeviceContext *context =
+        asyncrt_apple_coreai_context_from_untyped(untyped_context);
+    long wait_result =
+        dispatch_group_wait(context->pending_tasks, DISPATCH_TIME_FOREVER);
+    assert(wait_result == 0);
+    int lock_result = pthread_mutex_lock(&context->error_mutex);
+    assert(lock_result == 0);
+    char *error_message = context->first_error;
+    context->first_error = NULL;
+    int unlock_result = pthread_mutex_unlock(&context->error_mutex);
+    assert(unlock_result == 0);
+    return error_message;
+  }
+  AsyncRTCPUDeviceContext *context =
+      asyncrt_apple_device_context_from_untyped(untyped_context);
+  long wait_result =
+      dispatch_group_wait(context->pending_tasks, DISPATCH_TIME_FOREVER);
+  assert(wait_result == 0);
+  return NULL;
+}
+
+int64_t AsyncRT_DeviceContext_id(void *untyped_context) {
+  (void)asyncrt_apple_device_context_base_from_untyped(untyped_context);
+  return 0;
+}
+
+const char *AsyncRT_CoreAI_executeMatmulMatmulF32_2x3x4x2(
+    void *untyped_context, const float *input, const float *first_weights,
+    const float *second_weights, float *output) {
+  AsyncRTCoreAIDeviceContext *context =
+      asyncrt_apple_coreai_context_from_untyped(untyped_context);
+  if (MojoIOSCoreAI_executeMatmulMatmulF32_2x3x4x2 == NULL)
+    return asyncrt_apple_owned_error(
+        "Core AI Swift runtime support is not linked");
+  if (input == NULL)
+    return asyncrt_apple_owned_error("Core AI region input is null");
+  if (first_weights == NULL)
+    return asyncrt_apple_owned_error(
+        "Core AI region first weight tensor is null");
+  if (second_weights == NULL)
+    return asyncrt_apple_owned_error(
+        "Core AI region second weight tensor is null");
+  if (output == NULL)
+    return asyncrt_apple_owned_error("Core AI region output is null");
+
+  AsyncRTCoreAIMatmulMatmulTask *task = calloc(1, sizeof(*task));
+  assert(task != NULL);
+  task->context = context;
+  task->input = input;
+  task->first_weights = first_weights;
+  task->second_weights = second_weights;
+  task->output = output;
+  task->completion_semaphore = dispatch_semaphore_create(0);
+  assert(task->completion_semaphore != NULL);
+
+  AsyncRT_DeviceContext_retain(context);
+  dispatch_group_enter(context->pending_tasks);
+  dispatch_async_f(context->submission_queue, task,
+                   asyncrt_apple_coreai_execute_matmul_matmul);
+  return NULL;
+}
+
+void AsyncRT_CoreAI_enqueueMatmulMatmulF32_2x3x4x2(
+    void *untyped_context, const float *input, const float *first_weights,
+    const float *second_weights, float *output) {
+  AsyncRTCoreAIDeviceContext *context =
+      asyncrt_apple_coreai_context_from_untyped(untyped_context);
+  const char *error_message =
+      AsyncRT_CoreAI_executeMatmulMatmulF32_2x3x4x2(
+          context, input, first_weights, second_weights, output);
+  if (error_message == NULL)
+    return;
+  asyncrt_apple_coreai_record_error(context, error_message);
+  AsyncRT_DeviceContext_strfree(error_message);
+}
diff --git a/AsyncRT/lib/Runtime/Apple/MetalDeviceContextCAPI.m b/AsyncRT/lib/Runtime/Apple/MetalDeviceContextCAPI.m
