+declare i32 @air.thread_position_in_threadgroup.x()
+
+define internal i32 @helper(i32 %value) {
+  %result = add i32 %value, 1
+  ret i32 %result
+}
+
+define void @kernel(ptr addrspace(1) %output) #0 {
+  %slot = alloca ptr addrspace(1), align 8
+  store ptr addrspace(1) %output, ptr %slot, align 8
+  %loaded = load ptr addrspace(1), ptr %slot, align 8
+  %result = call i32 @helper(i32 41)
+  store i32 %result, ptr addrspace(1) %loaded, align 4
+  ret void
+}
+
+define internal i32 @builtin_helper() {
+  %thread = call i32 @air.thread_position_in_threadgroup.x()
+  ret i32 %thread
+}
+
+define void @builtin_kernel(ptr addrspace(1) %output) #0 {
+  %thread = call i32 @builtin_helper()
+  store i32 %thread, ptr addrspace(1) %output, align 4
+  ret void
+}
+
+attributes #0 = { "metal.kernel" "kgen.offload.pointee_types"="simd:1:int32" }
